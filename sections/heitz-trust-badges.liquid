{%- comment -%}
  Heitz TF trust badges — slim icon strip under the hero (tf-features port).
{%- endcomment -%}
<style>
  .htf-features {
    background-color: #F9F9F9;
    padding: 12px 0;
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
  }
  .htf-features__grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
  .htf-features__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 32px;
    border-right: 1px solid #e0e0e0;
  }
  .htf-features__item:last-child { border-right: none; }
  .htf-features__item svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    stroke: #1a1a1a;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .htf-features__title {
    font-size: 11px;
    font-weight: 400;
    color: #1a1a1a;
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: var(--htf-font-heading, 'Fahkwang', sans-serif);
  }
  @media (max-width: 768px) {
    .htf-features { padding: 10px 0; }
    .htf-features__grid { padding: 0 8px; justify-content: space-between; }
    .htf-features__item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 5px;
      padding: 0 6px;
      border-right: none;
    }
    .htf-features__item svg { width: 16px; height: 16px; }
    .htf-features__title {
      font-size: 8px;
      letter-spacing: 0.05em;
      white-space: normal;
      line-height: 1.3;
    }
  }
</style>

<div class="htf-features">
  <div class="htf-features__grid">
    {%- for block in section.blocks -%}
      <div class="htf-features__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}
            <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {%- when 'returns' -%}
            <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M9 12l2 2 4-4"/></svg>
          {%- when 'globe' -%}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          {%- when 'shield' -%}
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {%- when 'chat' -%}
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        {%- endcase -%}
        <p class="htf-features__title">{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Trust Badges",
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "returns", "label": "Returns check" },
            { "value": "globe", "label": "Globe" },
            { "value": "shield", "label": "Shield" },
            { "value": "chat", "label": "Chat bubble" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free Tracked Shipping" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Heitz TF Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "text": "Free Tracked Shipping" } },
        { "type": "badge", "settings": { "icon": "returns", "text": "30-Day Returns" } },
        { "type": "badge", "settings": { "icon": "globe", "text": "USA Delivery" } },
        { "type": "badge", "settings": { "icon": "shield", "text": "Secure Checkout" } },
        { "type": "badge", "settings": { "icon": "chat", "text": "Responsive Support" } }
      ]
    }
  ]
}
{% endschema %}
