{%- comment -%}
  Heitz TF hero — full-width image hero, 650px desktop, natural-height mobile,
  centered white text with inverse button. Ported from the reference slideshow.
{%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  .htf-hero-{{ sid }} {
    position: relative;
    height: 650px;
    overflow: hidden;
    background: #2a3743;
  }
  @media screen and (max-width: 768px) {
    .htf-hero-{{ sid }} {
      height: 0;
      padding-bottom: {{ section.settings.mobile_ratio | default: 125 }}%;
    }
  }
  .htf-hero-{{ sid }} .htf-hero__image-wrapper {
    position: absolute;
    inset: 0;
  }
  .htf-hero-{{ sid }} .htf-hero__image-wrapper:after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: #000;
    opacity: {{ section.settings.overlay_opacity | default: 4 | divided_by: 100.0 }};
  }
  .htf-hero-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .htf-hero-{{ sid }} .htf-hero__img--mobile { display: none; }
  @media screen and (max-width: 768px) {
    .htf-hero-{{ sid }} .htf-hero__img--desktop { display: none; }
    .htf-hero-{{ sid }} .htf-hero__img--mobile { display: block; }
  }
  .htf-hero-{{ sid }} .htf-hero__slide-link {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
  .htf-hero-{{ sid }} .htf-hero__text-wrap {
    color: #ffffff;
    height: 100%;
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }
  .htf-hero-{{ sid }} .htf-hero__text-wrap a { pointer-events: auto; }
  .htf-hero__title {
    font-family: var(--htf-font-heading);
    font-weight: 400;
    font-size: 23.5px;
    letter-spacing: 0.025em;
    line-height: 1.1;
    margin: 0;
    display: block;
    text-shadow: 0 0 4px rgba(0,0,0,0.2);
  }
  @media only screen and (min-width: 769px) {
    .htf-hero__title { font-size: 47px; }
  }
  .htf-hero__subtitle {
    display: block;
    font-family: var(--htf-font-body);
    font-size: 17px;
    margin-top: 15px;
    margin-bottom: 30px;
    text-shadow: 0 0 4px rgba(0,0,0,0.2);
  }
  @media only screen and (min-width: 769px) {
    .htf-hero__subtitle { font-size: 22px; }
  }
  .htf-hero__rise {
    overflow: hidden;
  }
  .htf-hero__rise > span {
    display: block;
    opacity: 0;
    transform: translateY(110%);
    animation: htf-rise-up .8s cubic-bezier(.26,.54,.32,1) forwards;
  }
  .htf-hero__rise--sub > span { animation-delay: .4s; }
  .htf-hero__rise--btn > span { animation-delay: .7s; }
  @keyframes htf-rise-up {
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="htf-hero-{{ sid }}">
  <div class="htf-hero__image-wrapper">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: alt: section.settings.title, class: 'htf-hero__img--desktop', loading: 'eager', sizes: '100vw', widths: '832, 1200, 1920, 2400' }}
    {%- else -%}
      <div class="htf-hero__img--desktop" style="width:100%;height:100%;background:linear-gradient(160deg,#2a3743 20%,#3e5162 80%);"></div>
    {%- endif -%}
    {%- assign mob = section.settings.image_mobile | default: section.settings.image -%}
    {%- if mob != blank -%}
      {{ mob | image_url: width: 1200 | image_tag: alt: section.settings.title, class: 'htf-hero__img--mobile', loading: 'eager', sizes: '100vw', widths: '480, 720, 1080, 1200' }}
    {%- else -%}
      <div class="htf-hero__img--mobile" style="width:100%;height:100%;background:linear-gradient(160deg,#2a3743 20%,#3e5162 80%);position:absolute;inset:0;"></div>
    {%- endif -%}
  </div>

  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="htf-hero__slide-link" aria-hidden="true" tabindex="-1"></a>
  {%- endif -%}

  <div class="htf-hero__text-wrap">
    <div class="htf-page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="htf-hero__title">
          <span class="htf-hero__rise"><span>{{ section.settings.title | escape }}</span></span>
        </h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="htf-hero__subtitle">
          <span class="htf-hero__rise htf-hero__rise--sub"><span>{{ section.settings.subtitle | escape }}</span></span>
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="htf-hero__rise htf-hero__rise--btn">
          <span><a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="htf-btn htf-btn--inverse">{{ section.settings.button_label | escape }}</a></span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (portrait)" },
    { "type": "range", "id": "mobile_ratio", "min": 80, "max": 150, "step": 5, "unit": "%", "label": "Mobile height ratio", "default": 125 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 60, "step": 2, "unit": "%", "label": "Overlay opacity", "default": 4 },
    { "type": "text", "id": "title", "label": "Heading", "default": "Lighting That Defines the Space" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Thoughtfully designed pieces for refined, modern interiors." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Heitz TF Hero" }]
}
{% endschema %}
