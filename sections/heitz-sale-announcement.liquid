{%- comment -%}
  Heitz – Gold seal sale announcement bar (1b).
  Gold bar: "Up to 30% off gold seal pieces · Already reduced  Shop now".
  Several messages rotate. Add it to the header group and hide the old announcement bar.
{%- endcomment -%}
{%- assign sid = section.id -%}
<div class="hsa" data-hsa="{{ sid }}" style="--hsa-bg: {{ section.settings.bg }}; --hsa-fg: {{ section.settings.fg }}; --hsa-fs: {{ section.settings.text_size }}px;">
  <div class="hsa__wrap">
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="hsa__arrow" data-hsa-prev aria-label="Previous message">‹</button>
    {%- endif -%}
    <div class="hsa__track" data-speed="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        <div class="hsa__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.seal != blank -%}<span class="hsa__seal">{{ block.settings.seal }}</span>{%- endif -%}
          <span class="hsa__text">{{ block.settings.text }}</span>
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="hsa__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="hsa__arrow" data-hsa-next aria-label="Next message">›</button>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('[data-hsa="{{ sid }}"]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var slides = root.querySelectorAll('.hsa__slide');
  if (slides.length < 2) return;
  var i = 0, speed = (+root.querySelector('.hsa__track').dataset.speed || 5) * 1000, t;
  function show(n) { slides[i].classList.remove('is-active'); i = (n + slides.length) % slides.length; slides[i].classList.add('is-active'); }
  function start() { clearInterval(t); t = setInterval(function () { show(i + 1); }, speed); }
  root.querySelector('[data-hsa-prev]').addEventListener('click', function () { show(i - 1); start(); });
  root.querySelector('[data-hsa-next]').addEventListener('click', function () { show(i + 1); start(); });
  root.addEventListener('mouseenter', function () { clearInterval(t); });
  root.addEventListener('mouseleave', start);
  document.addEventListener('shopify:block:select', function (e) { var k = [].indexOf.call(slides, e.target); if (k > -1) { show(k); clearInterval(t); } });
  start();
})();
</script>

{% stylesheet %}
  .hsa{background:var(--hsa-bg);color:var(--hsa-fg);font-size:var(--hsa-fs);letter-spacing:.04em;line-height:1.35}
  .hsa *{box-sizing:border-box}
  .hsa__wrap{max-width:1500px;margin:0 auto;padding:0 17px;display:grid;grid-template-columns:32px minmax(0,1fr) 32px;align-items:center;min-height:40px}
  .hsa__wrap:not(:has(.hsa__arrow)){grid-template-columns:minmax(0,1fr)}
  @media only screen and (min-width:769px){.hsa__wrap{padding:0 40px}}
  .hsa__track{display:grid;grid-template-areas:"s";align-items:center;justify-items:center;min-width:0}
  .hsa__slide{grid-area:s;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px 10px;padding:8px 0;text-align:center;opacity:0;visibility:hidden;transform:translateY(4px);transition:opacity .45s ease,transform .45s ease,visibility 0s linear .45s}
  .hsa__slide.is-active{opacity:1;visibility:visible;transform:none;transition:opacity .45s ease,transform .45s ease}
  .hsa__seal{display:inline-flex;align-items:center;justify-content:center;padding:2px 8px;border:1px solid currentColor;border-radius:20px;font-size:.85em;font-weight:600;letter-spacing:.08em}
  .hsa__text p{margin:0;display:inline}
  .hsa__link{color:inherit;text-decoration:underline;text-underline-offset:3px;font-weight:500;white-space:nowrap}
  .hsa__link:hover{opacity:.75}
  .hsa__arrow{width:32px;height:32px;border:0;background:none;color:inherit;font-size:20px;line-height:1;cursor:pointer;opacity:.7}
  .hsa__arrow:hover{opacity:1}
  @media only screen and (max-width:768px){
    .hsa{font-size:calc(var(--hsa-fs) - 1px)}
    .hsa__wrap{grid-template-columns:28px minmax(0,1fr) 28px;padding:0 6px}
    .hsa__arrow{width:28px;height:40px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Heitz sale announcement",
  "class": "htf-section-announcement",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#D9B97A" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1A1B18" },
    { "type": "range", "id": "text_size", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Text size", "default": 13 },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Change message every", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "seal", "label": "Badge (optional)", "info": "Example: −30%" },
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Up to 30% off gold seal pieces · Already reduced" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heitz sale announcement",
      "blocks": [
        { "type": "message", "settings": { "text": "Up to 30% off gold seal pieces · Already reduced", "link_label": "Shop now" } },
        { "type": "message", "settings": { "text": "Free tracked shipping on all orders", "link_label": "" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
