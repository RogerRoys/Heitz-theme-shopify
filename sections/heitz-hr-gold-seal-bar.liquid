{%- comment -%} Heitz 9d – Gold seal announcement bar. Add to the Header group instead of (or above) heitz-hr-announcement. {%- endcomment -%}
{%- assign link = section.settings.link | default: routes.all_products_collection_url -%}
<a class="hgsb" href="{{ link }}" style="--hgsb-bg: {{ section.settings.bg }}; --hgsb-fg: {{ section.settings.fg }};" {{ section.shopify_attributes }}>
  {%- capture hgsb_seal -%}<span class="hgsb__seal" aria-label="%">%</span>{%- endcapture -%}
  <span class="hgsb__main">{{ section.settings.text | escape | replace: '%', hgsb_seal }}</span>
  {%- if section.settings.sub != blank -%}<span class="hgsb__sub">{{ section.settings.sub }}</span>{%- endif -%}
  {%- if section.settings.cta != blank -%}<span class="hgsb__cta">{{ section.settings.cta }}</span>{%- endif -%}
</a>

<style>
  .hgsb{height:40px;background:var(--hgsb-bg,#D9B97A);color:var(--hgsb-fg,#1A1B18)!important;display:flex;align-items:center;justify-content:center;gap:12px;padding:0 12px;font-family:var(--font-body--family,'Jost',sans-serif);font-size:13px;letter-spacing:.04em;white-space:nowrap;text-decoration:none!important;-webkit-font-smoothing:antialiased;overflow:hidden}
  .hgsb__seal{width:20px;height:20px;flex:none;border-radius:50%;background:var(--hgsb-fg,#1A1B18);color:var(--hgsb-bg,#D9B97A);display:flex;align-items:center;justify-content:center;font-family:var(--font-heading--family,'Cabin',sans-serif);font-weight:600;font-size:10px;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .hgsb:hover .hgsb__seal{transform:rotate(-20deg) scale(1.08)}
  .hgsb__main{font-weight:500;display:flex;align-items:center;overflow:hidden}
  .hgsb__main .hgsb__seal{margin:0 6px 0 2px}
  .hgsb__sub{opacity:.8}
  .hgsb__cta{position:relative;font-weight:500;text-decoration:underline;text-underline-offset:3px;transition:opacity .2s ease,transform .3s cubic-bezier(.2,.8,.2,1)}
  .hgsb:hover .hgsb__cta{opacity:.7;transform:translateX(2px)}
  @media (max-width:989px){.hgsb{height:38px;font-size:12px;gap:10px}.hgsb__sub{display:none}}
</style>

{% schema %}
{
  "name": "Heitz gold seal bar (9d)",
  "settings": [
    { "type": "text", "id": "text", "label": "Main text", "info": "The % sign is shown as the round seal.", "default": "Up to 10% off gold seal pieces" },
    { "type": "text", "id": "sub", "label": "Second text (desktop only)", "default": "The saving is already in the price" },
    { "type": "text", "id": "cta", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link", "info": "Point this to the gold-seal collection." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#D9B97A" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1A1B18" }
  ],
  "presets": [{ "name": "Heitz gold seal bar (9d)" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
