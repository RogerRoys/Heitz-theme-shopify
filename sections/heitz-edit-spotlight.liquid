{%- comment -%}
  Heitz Edit Spotlight — editorial feature: single image one side; eyebrow,
  heading, text, a numbered collection-link list, button pair and an
  optional fact row on the other.
{%- endcomment -%}
{% render 'heitz-tf-base' %}
<style>
  .hesp {
    background: var(--color-background, transparent);
    padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px;
    font-family: var(--htf-font-body);
  }
  .hesp__row {
    display: flex;
    align-items: center;
    gap: 70px;
  }
  .hesp--img-right .hesp__row { flex-direction: row-reverse; }
  .hesp__media {
    flex: 0 1 46%;
    overflow: hidden;
  }
  .hesp__media .htf-ratio { height: 0; padding-bottom: 118%; position: relative; background: #ececec; }
  .hesp__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hesp__content { flex: 0 1 46%; }
  .hesp__eyebrow {
    color: var(--color-primary, #b8913f);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.3em;
    line-height: 1.4;
    margin: 0 0 20px;
    text-transform: uppercase;
  }
  .hesp__title {
    font-family: var(--htf-font-heading);
    font-size: {{ section.settings.heading_size | default: 40 }}px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: var(--color-foreground-heading, var(--htf-color-text));
    margin: 0 0 20px;
    max-width: 14ch;
  }
  .hesp__text p {
    font-size: {{ section.settings.text_size | default: 15 }}px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--color-foreground, var(--htf-color-text));
    max-width: 52ch;
    margin: 0 0 12px;
  }
  .hesp__text p:last-child { margin-bottom: 0; }
  .hesp__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    border: 1px solid var(--color-border, #e4e4e4);
    background: var(--color-border, #e4e4e4);
  }
  .hesp__link-item { background: var(--color-background, #ffffff); }
  .hesp__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 17px 18px;
    text-decoration: none;
    color: var(--color-foreground-heading, var(--htf-color-text));
  }
  .hesp__link-label {
    font-family: var(--htf-font-heading);
    font-size: 14.5px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .hesp__link-arrow { flex: 0 0 auto; transition: transform 0.3s ease; }
  .hesp__link-arrow svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.4; fill: none; stroke-linecap: round; stroke-linejoin: round; display: block; }
  .hesp__link:hover .hesp__link-arrow { transform: translateX(4px); }
  .hesp__link:hover .hesp__link-label { color: var(--color-primary, #b8913f); }
  .hesp__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 30px;
  }
  .hesp__btn-solid {
    display: inline-block;
    background: #1a1b18;
    color: #ffffff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.2;
    padding: 14px 26px;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .hesp__btn-solid:hover { opacity: 0.85; }
  .hesp__btn-text {
    display: inline-block;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.2;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .hesp__btn-text:hover { color: var(--color-primary, #b8913f); }
  .hesp__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid var(--color-border, #e4e4e4);
    margin-top: 34px;
    padding-top: 22px;
  }
  .hesp__fact-title {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-foreground-heading, var(--htf-color-text));
    margin: 0 0 6px;
    text-transform: uppercase;
  }
  .hesp__fact-text {
    font-size: 12.5px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-foreground, #7a7a7a);
    margin: 0;
  }
  @media only screen and (max-width: 900px) {
    .hesp__row, .hesp--img-right .hesp__row { flex-direction: column; gap: 44px; }
    .hesp__media, .hesp__content { flex: 1 1 100%; width: 100%; }
    .hesp__title { font-size: {{ section.settings.heading_size | default: 40 | minus: 12 }}px; }
    .hesp__facts { grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .hesp__fact-text { font-size: 11.5px; }
  }
  @media only screen and (max-width: 520px) {
    .hesp__facts { grid-template-columns: 1fr 1fr; }
  }
</style>

<div class="hesp color-{{ section.settings.color_scheme }}{% if section.settings.image_position == 'right' %} hesp--img-right{% endif %}">
  <div class="htf-page-width">
    <div class="hesp__row">
      <div class="hesp__media">
        <div class="htf-ratio">
          {%- if section.settings.image_1 != blank -%}
            {{ section.settings.image_1 | image_url: width: 1200 | image_tag: alt: section.settings.title, loading: 'lazy' }}
          {%- endif -%}
        </div>
      </div>
      <div class="hesp__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hesp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="hesp__title">{{ section.settings.title }}</h2>
        <div class="hesp__text">{{ section.settings.text }}</div>

        {%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
        {%- if link_blocks.size > 0 -%}
          <ul class="hesp__links">
            {%- for block in link_blocks -%}
              {%- liquid
                assign col = collections[block.settings.collection]
                assign label = block.settings.label
                if label == blank
                  assign label = col.title
                endif
              -%}
              <li class="hesp__link-item" {{ block.shopify_attributes }}>
                <a class="hesp__link" href="{{ col.url | default: '#' }}">
                  <span class="hesp__link-label">{{ label }}</span>
                  <span class="hesp__link-arrow"><svg viewBox="0 0 24 24"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg></span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="hesp__actions">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="hesp__btn-solid">{{ section.settings.button_1_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link | default: routes.root_url }}" class="hesp__btn-text">{{ section.settings.button_2_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- assign fact_blocks = section.blocks | where: 'type', 'fact' -%}
        {%- if fact_blocks.size > 0 -%}
          <div class="hesp__facts">
            {%- for block in fact_blocks -%}
              <div class="hesp__fact" {{ block.shopify_attributes }}>
                <p class="hesp__fact-title">{{ block.settings.title | escape }}</p>
                <p class="hesp__fact-text">{{ block.settings.text | escape }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz Edit Spotlight",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Heitz Edit" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Light that belongs in every room" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_1_label", "label": "Solid button label", "default": "Explore All Lighting" },
    { "type": "url", "id": "button_1_link", "label": "Solid button link" },
    { "type": "text", "id": "button_2_label", "label": "Text link label", "default": "Discover Our Story" },
    { "type": "url", "id": "button_2_link", "label": "Text link" },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 26, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 15 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Collection link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Leave empty to use the collection title" }
      ]
    },
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free Tracked Shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every order" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Heitz Edit Spotlight",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" }
      ]
    }
  ]
}
{% endschema %}
