                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>At the moment, we mainly serve customers in the <strong>USA and UK</strong>. We’re looking forward to expanding into more regions soon as we continue to grow.</p>",
                    "width": "100%",
                    "max_width": "none",
