{%- comment -%}
  Heitz TF hero — full-width image hero, 650px desktop, natural-height mobile,
  centered white text with inverse button. Ported from the reference slideshow.
{%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  .htf-hero-{{ sid }} {
    position: relative;
    height: 650px;
    overflow: hidden;
    background: #2a3743;
  }
  @media screen and (max-width: 768px) {
    .htf-hero-{{ sid }} {
      height: 0;
      padding-bottom: {{ section.settings.mobile_ratio | default: 125 }}%;
    }
  }
  .htf-hero-{{ sid }} .htf-hero__image-wrapper {
    position: absolute;
    inset: 0;
  }
  .htf-hero-{{ sid }} .htf-hero__image-wrapper:after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: #000;
    opacity: {{ section.settings.overlay_opacity | default: 4 | divided_by: 100.0 }};
  }
  .htf-hero-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .htf-hero-{{ sid }} .htf-hero__img--mobile { display: none; }
  @media screen and (max-width: 768px) {
    .htf-hero-{{ sid }} .htf-hero__img--desktop { display: none; }
    .htf-hero-{{ sid }} .htf-hero__img--mobile { display: block; }
  }
  .htf-hero-{{ sid }} .htf-hero__slide-link {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
  .htf-hero-{{ sid }} .htf-hero__text-wrap {
    color: var(--color-foreground, #ffffff);
    height: 100%;
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }
  .htf-hero-{{ sid }} .htf-hero__text-wrap a { pointer-events: auto; }
  .htf-hero__title {
    font-family: var(--htf-font-heading);
    font-weight: 400;
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}font-size: var(--font-size, 23.5px); font-family: var(--font-family, var(--htf-font-heading)); font-weight: var(--font-weight, 400); line-height: var(--line-height, 1.1); letter-spacing: var(--letter-spacing, 0.025em); text-transform: var(--text-transform, none);{% endif %} color: var(--color, inherit);
    letter-spacing: 0.025em;
    line-height: 1.1;
    margin: 0;
    display: block;
    text-shadow: 0 0 4px rgba(0,0,0,0.2);
  }
  @media only screen and (min-width: 769px) {
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}.htf-hero__title { font-size: var(--font-size, 47px); }{% endif %}
  }
  .htf-hero__subtitle {
    display: block;
    font-family: var(--htf-font-body);
    font-size: {{ section.settings.text_size | default: 22 | times: 0.77 | round }}px;
    margin-top: 15px;
    margin-bottom: 30px;
    text-shadow: 0 0 4px rgba(0,0,0,0.2);
  }
  @media only screen and (min-width: 769px) {
    .htf-hero__subtitle { font-size: {{ section.settings.text_size | default: 22 }}px; }
  }
  .htf-hero__rise {
    overflow: hidden;
  }
  .htf-hero__rise > span {
    display: block;
    opacity: 0;
    transform: translateY(110%);
    animation: htf-rise-up .8s cubic-bezier(.26,.54,.32,1) forwards;
  }
  .htf-hero__rise--sub > span { animation-delay: .4s; }
  .htf-hero__rise--btn > span { animation-delay: .7s; }
  @keyframes htf-rise-up {
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="htf-hero-{{ sid }} color-{{ section.settings.color_scheme }}">
  <div class="htf-hero__image-wrapper">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: alt: section.settings.title, class: 'htf-hero__img--desktop', loading: 'eager', sizes: '100vw', widths: '832, 1200, 1920, 2400' }}
    {%- else -%}
      <div class="htf-hero__img--desktop" style="width:100%;height:100%;background:linear-gradient(160deg,#2a3743 20%,#3e5162 80%);"></div>
    {%- endif -%}
    {%- assign mob = section.settings.image_mobile | default: section.settings.image -%}
    {%- if mob != blank -%}
      {{ mob | image_url: width: 1200 | image_tag: alt: section.settings.title, class: 'htf-hero__img--mobile', loading: 'eager', sizes: '100vw', widths: '480, 720, 1080, 1200' }}
    {%- else -%}
      <div class="htf-hero__img--mobile" style="width:100%;height:100%;background:linear-gradient(160deg,#2a3743 20%,#3e5162 80%);position:absolute;inset:0;"></div>
    {%- endif -%}
  </div>

  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="htf-hero__slide-link" aria-hidden="true" tabindex="-1"></a>
  {%- endif -%}

  <div class="htf-hero__text-wrap">
    <div class="htf-page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="htf-hero__title{% unless section.settings.type_preset == 'custom' or section.settings.type_preset == blank %} {{ section.settings.type_preset }}{% endunless %}" style="{% render 'typography-style', settings: section.settings %}">
          <span class="htf-hero__rise"><span>{{ section.settings.title }}</span></span>
        </h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="htf-hero__subtitle">
          <span class="htf-hero__rise htf-hero__rise--sub"><span>{{ section.settings.subtitle }}</span></span>
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="htf-hero__rise htf-hero__rise--btn">
          <span><a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="htf-btn htf-btn--inverse">{{ section.settings.button_label | escape }}</a></span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "type_preset", "label": "Preset", "info": "Edit presets in theme settings", "options": [ { "value": "custom", "label": "Custom" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" } ], "default": "custom" },
    { "type": "select", "id": "font", "label": "Font", "options": [ { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-accent--family)", "label": "Accent" } ], "default": "var(--font-heading--family)", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "font_size", "label": "Size", "options": [ { "value": "", "label": "Default" }, { "value": "0.625rem", "label": "10px" }, { "value": "0.75rem", "label": "12px" }, { "value": "0.875rem", "label": "14px" }, { "value": "1rem", "label": "16px" }, { "value": "1.125rem", "label": "18px" }, { "value": "1.25rem", "label": "20px" }, { "value": "1.5rem", "label": "24px" }, { "value": "2rem", "label": "32px" }, { "value": "2.5rem", "label": "40px" }, { "value": "3rem", "label": "48px" }, { "value": "3.5rem", "label": "56px" }, { "value": "4.5rem", "label": "72px" } ], "default": "", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "line_height", "label": "Line height", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "letter_spacing", "label": "Letter spacing", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "case", "label": "Case", "options": [ { "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" } ], "default": "none", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "color", "label": "Color", "options": [ { "value": "", "label": "Default" }, { "value": "var(--color-foreground)", "label": "Text" }, { "value": "var(--color-foreground-heading)", "label": "Heading" }, { "value": "var(--color-primary)", "label": "Link" } ], "default": "" },
    { "type": "range", "id": "text_size", "min": 8, "max": 32, "step": 1, "unit": "px", "label": "Text size", "default": 22 },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (portrait)" },
    { "type": "range", "id": "mobile_ratio", "min": 80, "max": 150, "step": 5, "unit": "%", "label": "Mobile height ratio", "default": 125 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 60, "step": 2, "unit": "%", "label": "Overlay opacity", "default": 4 },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Lighting That Defines the Space" },
    { "type": "inline_richtext", "id": "subtitle", "label": "Subheading", "default": "Thoughtfully designed pieces for refined, modern interiors." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Heitz TF Hero" }]
}
{% endschema %}
