{%- comment -%}
  Heitz Collection Showcase — image tile grid for collections. Two label
  styles: "below" (category tiles) and "overlay" (room cards). Tile image
  falls back from the block image to the collection image to the first
  product's image.
{%- endcomment -%}
{% render 'heitz-tf-base' %}
{%- liquid
  case section.settings.ratio
    when 'portrait'
      assign ratio_pct = 125
    when 'landscape'
      assign ratio_pct = 75
    else
      assign ratio_pct = 100
  endcase
-%}
<style>
  .hcsh { padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px; background: var(--color-background, transparent); font-family: var(--htf-font-body); }
  .hcsh__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 25px;
  }
  .hcsh__title {
    font-family: var(--htf-font-heading);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.025em;
    line-height: 1.1;
    color: var(--color-foreground-heading, var(--htf-color-text));
    margin: 0;
  }
  .hcsh__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 17px;
  }
  .hcsh__card { display: block; text-decoration: none; color: inherit; }
  .hcsh__media { position: relative; overflow: hidden; }
  .hcsh__media .htf-ratio {
    height: 0;
    padding-bottom: {{ ratio_pct }}%;
    position: relative;
    background: #ececec;
  }
  .hcsh__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s cubic-bezier(.22, 1, .36, 1);
  }
  .hcsh__card:hover .hcsh__media img { transform: scale(1.04); }
  .hcsh__label {
    font-family: var(--htf-font-heading);
    font-size: {{ section.settings.label_size | default: 16 }}px;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: var(--color-foreground-heading, var(--htf-color-text));
    margin: 13px 0 0;
  }
  .hcsh--overlay .hcsh__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 18, 14, 0.55), rgba(20, 18, 14, 0) 45%);
    z-index: 1;
  }
  .hcsh--overlay .hcsh__label {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 15px;
    z-index: 2;
    color: #ffffff;
    margin: 0;
  }
  @media only screen and (min-width: 769px) {
    .hcsh__title { font-size: 30px; }
    .hcsh__grid { grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 30px 20px; }
  }
  @media only screen and (max-width: 768px) {
    .hcsh__label { font-size: {{ section.settings.label_size | default: 16 | minus: 2 }}px; }
    .hcsh--overlay .hcsh__label { left: 12px; right: 12px; bottom: 11px; }
  }
  .hcsh .htf-btn--secondary {
    color: var(--color-foreground, var(--htf-color-text));
    border-color: var(--color-border, var(--htf-color-border));
  }
</style>

<div class="hcsh color-{{ section.settings.color_scheme }}{% if section.settings.label_style == 'overlay' %} hcsh--overlay{% endif %}">
  <div class="htf-page-width">
    {%- if section.settings.title != blank or section.settings.link != blank -%}
      <div class="hcsh__header">
        <h2 class="hcsh__title">{{ section.settings.title }}</h2>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="htf-btn htf-btn--secondary htf-btn--small">{{ section.settings.link_label | default: 'View all' }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hcsh__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign label = block.settings.label
          if label == blank
            assign label = col.title
          endif
          assign img = block.settings.image
          if img == blank
            assign img = col.image
          endif
          if img == blank
            assign img = col.products.first.featured_image
          endif
        -%}
        <a class="hcsh__card" href="{{ col.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="hcsh__media">
            <div class="htf-ratio">
              {%- if img != blank -%}
                {{ img | image_url: width: 900 | image_tag: alt: label, loading: 'lazy' }}
              {%- endif -%}
            </div>
            {%- if section.settings.label_style == 'overlay' -%}
              <p class="hcsh__label">{{ label }}</p>
            {%- endif -%}
          </div>
          {%- unless section.settings.label_style == 'overlay' -%}
            <p class="hcsh__label">{{ label }}</p>
          {%- endunless -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz Collection Tiles",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by Category" },
    { "type": "url", "id": "link", "label": "Header link" },
    { "type": "text", "id": "link_label", "label": "Header link label", "default": "View all" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "label_style",
      "label": "Label style",
      "options": [
        { "value": "below", "label": "Below image" },
        { "value": "overlay", "label": "On image" }
      ],
      "default": "below"
    },
    { "type": "range", "id": "label_size", "label": "Label size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Leave empty to use the collection title" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Leave empty to use the collection image" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Heitz Collection Tiles",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
