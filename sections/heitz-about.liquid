{%- comment -%}
  Heitz TF About — "Our story" page layout ported from the Marven Denis
  about page: editorial hero, pull-quote identity row, photo split,
  numbered pillars, shipping card, promise checklist, closing quote.
  Each stripe has its own theme color scheme; gold accents come from
  each scheme's primary color.
{%- endcomment -%}
{% render 'heitz-tf-base' %}

<style>
  .hab { width: 100%; overflow: hidden; font-family: var(--font-body--family, var(--htf-font-body)); }
  .hab * { box-sizing: border-box; }
  .hab p { margin: 0; }

  .hab__eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--color-primary, #b8913f);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ── hero ─────────────────────────────────────── */
  .hab-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    overflow: hidden;
    background: var(--color-background, #fbf7f1);
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-hero__image {
    position: absolute;
    z-index: 0;
    top: 0; right: 0; bottom: 0; left: 50%;
    pointer-events: none;
    background-color: var(--color-background, #fbf7f1);
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
  }
  .hab-hero__text {
    position: relative;
    z-index: 2;
    grid-column: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 64px 56px 64px 64px;
    background: var(--color-background, #fbf7f1);
  }
  .hab-hero__space {
    position: relative;
    z-index: 1;
    grid-column: 2;
    min-width: 0;
    min-height: 1px;
    pointer-events: none;
  }
  .hab-hero h1 {
    margin: 0 0 20px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: clamp(34px, 4.5vw, 54px);
    font-weight: 400;
    line-height: 1.12;
  }
  .hab-hero h1 em {
    color: var(--color-primary, #b8913f);
    font-style: italic;
    font-weight: 400;
  }
  .hab-hero p {
    max-width: 400px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
  }

  /* ── identity ─────────────────────────────────── */
  .hab-identity {
    display: flex;
    align-items: flex-start;
    gap: 72px;
    padding: 56px 64px;
    background: var(--color-background, #f5f3ee);
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-identity__left { flex: 0 0 200px; }
  .hab-identity__left p {
    color: var(--color-primary, #b8913f);
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 25px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
  }
  .hab-identity__right { flex: 1; min-width: 0; }
  .hab-identity__right h2 {
    margin: 0 0 14px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 28px;
    font-weight: 400;
    line-height: 1.25;
  }
  .hab-identity__right p {
    margin: 0 0 12px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
  }
  .hab-identity__right p:last-child { margin-bottom: 0; }

  /* ── split (photo + text) ─────────────────────── */
  .hab-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 460px;
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-split__photo {
    position: relative;
    min-width: 0;
    min-height: 460px;
    overflow: hidden;
    background: linear-gradient(135deg, #e8e2d5, #d5ccba);
  }
  .hab-split__photo img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hab-split__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 60px 52px;
    background: var(--color-background, #f8f5f0);
  }
  .hab-split__text h2 {
    margin: 0 0 16px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
  }
  .hab-split__text p {
    margin: 0 0 12px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
  }
  .hab-split__text p:last-child { margin-bottom: 0; }

  /* ── pillars ──────────────────────────────────── */
  .hab-pillars {
    padding: 64px;
    background: var(--color-background, #fbf7f1);
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-pillars__header { max-width: 520px; margin-bottom: 40px; }
  .hab-pillars__header h2 {
    margin: 0 0 8px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
  }
  .hab-pillars__header p {
    color: var(--color-foreground, #7a6e5e);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
  }
  .hab-pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    background: var(--color-border, #ddd5c4);
    border: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-pillar {
    padding: 36px 28px;
    background: var(--color-background, #fbf7f1);
    background-image: linear-gradient(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.55));
  }
  .hab-pillar__number {
    margin-bottom: 14px;
    color: var(--color-primary, #cfa958);
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 36px;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    opacity: 0.4;
  }
  .hab-pillar h3 {
    margin: 0 0 10px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
  }
  .hab-pillar p {
    color: var(--color-foreground, #7a6e5e);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.85;
  }

  /* ── shipping ─────────────────────────────────── */
  .hab-shipping {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 72px;
    padding: 64px;
    background: var(--color-background, #f5f3ee);
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-shipping__left h2 {
    margin: 0 0 14px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
  }
  .hab-shipping__left p {
    color: var(--color-foreground, #7a6e5e);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
  }
  .hab-shipping__card {
    padding: 36px 32px;
    background: var(--color-background, #f8f5f0);
    background-image: linear-gradient(rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.6));
    border: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-shipping__flag { display: block; margin-bottom: 12px; font-size: 26px; line-height: 1; }
  .hab-shipping__card h3 {
    margin: 0 0 10px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 26px;
    font-weight: 400;
    line-height: 1.3;
  }
  .hab-shipping__card > p {
    margin: 0 0 18px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.9;
  }
  .hab-shipping__details {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-shipping__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.6;
  }
  .hab-shipping__dot {
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    margin-top: 6px;
    background: var(--color-primary, #b8913f);
    border-radius: 50%;
  }

  /* ── promise ──────────────────────────────────── */
  .hab-promise {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 72px;
    padding: 64px;
    background: var(--color-background, #f8f5f0);
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-promise__left h2 {
    margin: 0 0 16px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
  }
  .hab-promise__left p {
    margin: 0 0 12px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
  }
  .hab-promise__left p:last-child { margin-bottom: 0; }
  .hab-promise__right { display: flex; flex-direction: column; gap: 22px; }
  /* desktop: checklist left, text right (mobile keeps the heading first) */
  @media only screen and (min-width: 769px) {
    .hab-promise__left { order: 2; }
    .hab-promise__right { order: 1; }
  }
  .hab-promise__item { display: flex; align-items: flex-start; gap: 14px; }
  .hab-promise__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    margin-top: 2px;
    color: var(--color-foreground, #7a6e5e);
    border: 1px solid var(--color-border, #ddd5c4);
  }
  .hab-promise__icon svg { display: block; opacity: 0.55; }
  .hab-promise__copy h4 {
    margin: 0 0 3px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
  .hab-promise__copy p {
    color: var(--color-foreground, #7a6e5e);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.7;
  }

  /* ── closing ──────────────────────────────────── */
  .hab-closing {
    padding: 72px 64px;
    background: var(--color-background, #f5f3ee);
    text-align: center;
  }
  .hab-closing blockquote {
    max-width: 1100px;
    margin: 0 auto 20px;
    padding: 0;
    color: var(--color-foreground-heading, var(--htf-color-text));
    background: transparent;
    border: 0;
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: clamp(22px, 3vw, 36px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
  }
  .hab-closing__signature {
    color: var(--color-primary, #b8913f);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* ── mobile ───────────────────────────────────── */
  @media only screen and (max-width: 768px) {
    .hab-hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
    }
    .hab-hero__text { grid-column: 1; grid-row: 1; padding: 44px 24px 40px; }
    .hab-hero__image {
      position: relative;
      z-index: 1;
      inset: auto;
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .hab-hero__space { display: none; }
    .hab-identity { flex-direction: column; gap: 28px; padding: 44px 24px; }
    .hab-identity__left { flex: none; }
    .hab-split { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .hab-split__photo { min-height: 0; aspect-ratio: 4 / 3; }
    .hab-split__text { padding: 40px 24px; }
    .hab-pillars { padding: 48px 24px; }
    .hab-pillars__grid { grid-template-columns: minmax(0, 1fr); }
    .hab-pillar { padding: 32px 24px; }
    .hab-shipping { grid-template-columns: minmax(0, 1fr); gap: 36px; padding: 48px 24px; }
    .hab-shipping__card { padding: 30px 24px; }
    .hab-promise { grid-template-columns: minmax(0, 1fr); gap: 36px; padding: 48px 24px; }
    .hab-closing { padding: 52px 24px; }
    .hab-closing blockquote { font-size: 26px; line-height: 1.4; }
  }
</style>

<div class="hab">
  {%- comment -%} hero {%- endcomment -%}
  <section class="hab-hero color-{{ section.settings.hero_scheme }}">
    <div
      class="hab-hero__image"
      role="img"
      aria-label="{{ section.settings.hero_image_alt | default: 'Heitz lighting in a calm modern home' | escape }}"
      {% if section.settings.hero_image != blank %}
        style="background-image: url({{ section.settings.hero_image | image_url: width: 1600 }});"
      {% endif %}
    ></div>
    <div class="hab-hero__text">
      <span class="hab__eyebrow">{{ section.settings.hero_eyebrow }}</span>
      <h1>{{ section.settings.hero_heading }}</h1>
      <p>{{ section.settings.hero_text }}</p>
    </div>
    <div class="hab-hero__space" aria-hidden="true"></div>
  </section>

  {%- comment -%} identity {%- endcomment -%}
  <section class="hab-identity color-{{ section.settings.identity_scheme }}">
    <div class="hab-identity__left">
      <p>{{ section.settings.identity_quote }}</p>
    </div>
    <div class="hab-identity__right">
      <h2>{{ section.settings.identity_heading }}</h2>
      {{ section.settings.identity_text }}
    </div>
  </section>

  {%- comment -%} split {%- endcomment -%}
  <section class="hab-split">
    <div class="hab-split__photo">
      {%- if section.settings.split_image != blank -%}
        {{ section.settings.split_image | image_url: width: 1400 | image_tag: alt: section.settings.split_heading, loading: 'lazy' }}
      {%- endif -%}
    </div>
    <div class="hab-split__text color-{{ section.settings.split_scheme }}">
      <span class="hab__eyebrow">{{ section.settings.split_eyebrow }}</span>
      <h2>{{ section.settings.split_heading }}</h2>
      {{ section.settings.split_text }}
    </div>
  </section>

  {%- comment -%} pillars {%- endcomment -%}
  <section class="hab-pillars color-{{ section.settings.pillars_scheme }}">
    <div class="hab-pillars__header">
      <span class="hab__eyebrow">{{ section.settings.pillars_eyebrow }}</span>
      <h2>{{ section.settings.pillars_heading }}</h2>
      <p>{{ section.settings.pillars_text }}</p>
    </div>
    <div class="hab-pillars__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <div class="hab-pillar" {{ block.shopify_attributes }}>
            <div class="hab-pillar__number">{{ block.settings.numeral }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} shipping {%- endcomment -%}
  <section class="hab-shipping color-{{ section.settings.shipping_scheme }}">
    <div class="hab-shipping__left">
      <span class="hab__eyebrow">{{ section.settings.shipping_eyebrow }}</span>
      <h2>{{ section.settings.shipping_heading }}</h2>
      <p>{{ section.settings.shipping_text }}</p>
    </div>
    <div class="hab-shipping__card">
      <span class="hab-shipping__flag">{{ section.settings.card_flag }}</span>
      <h3>{{ section.settings.card_heading }}</h3>
      <p>{{ section.settings.card_text }}</p>
      <div class="hab-shipping__details">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ship_item' -%}
            <div class="hab-shipping__item" {{ block.shopify_attributes }}>
              <span class="hab-shipping__dot"></span>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} promise {%- endcomment -%}
  <section class="hab-promise color-{{ section.settings.promise_scheme }}">
    <div class="hab-promise__left">
      <span class="hab__eyebrow">{{ section.settings.promise_eyebrow }}</span>
      <h2>{{ section.settings.promise_heading }}</h2>
      {{ section.settings.promise_text }}
    </div>
    <div class="hab-promise__right">
      {%- for block in section.blocks -%}
        {%- if block.type == 'promise_item' -%}
          <div class="hab-promise__item" {{ block.shopify_attributes }}>
            <div class="hab-promise__icon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </div>
            <div class="hab-promise__copy">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} closing {%- endcomment -%}
  <section class="hab-closing color-{{ section.settings.closing_scheme }}">
    <blockquote>{{ section.settings.closing_quote }}</blockquote>
    <p class="hab-closing__signature">{{ section.settings.closing_signature }}</p>
  </section>
</div>

{% schema %}
{
  "name": "Heitz TF About",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "color_scheme", "id": "hero_scheme", "label": "Hero color scheme", "default": "scheme-heitz-cream" },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "About Heitz" },
    { "type": "inline_richtext", "id": "hero_heading", "label": "Hero heading", "default": "Lighting should shape how a home <em>feels.</em>" },
    { "type": "textarea", "id": "hero_text", "label": "Hero text", "default": "We started with a simple idea — lighting should do more than just illuminate a space. It should shape how you feel within it." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (right half)" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text" },
    { "type": "header", "content": "Identity" },
    { "type": "color_scheme", "id": "identity_scheme", "label": "Identity color scheme", "default": "scheme-heitz-beige" },
    { "type": "inline_richtext", "id": "identity_quote", "label": "Side quote", "default": "Simplicity, balance, and intentional living." },
    { "type": "inline_richtext", "id": "identity_heading", "label": "Identity heading", "default": "A different approach to lighting" },
    { "type": "richtext", "id": "identity_text", "label": "Identity text", "default": "<p>In a world filled with noise and excess, we were drawn to a different approach. Inspired by Scandinavian and Japandi design, we believe in simplicity, balance, and intentional living.</p><p>Every piece we offer reflects this philosophy — clean lines, soft light, and a focus on what truly matters.</p>" },
    { "type": "header", "content": "Photo split" },
    { "type": "color_scheme", "id": "split_scheme", "label": "Split color scheme", "default": "scheme-heitz-warm" },
    { "type": "text", "id": "split_eyebrow", "label": "Split eyebrow", "default": "Our approach" },
    { "type": "inline_richtext", "id": "split_heading", "label": "Split heading", "default": "Calm, natural, and timeless" },
    { "type": "richtext", "id": "split_text", "label": "Split text", "default": "<p>Our goal is to create lighting that feels calm, natural, and timeless. Pieces that don’t compete for attention, but quietly enhance the atmosphere of your home.</p><p>We carefully select designs that blend functionality with aesthetic clarity. From living rooms to bedrooms, each product is chosen to support a more thoughtful and comfortable way of living.</p>" },
    { "type": "image_picker", "id": "split_image", "label": "Split photo (left half)" },
    { "type": "header", "content": "Pillars" },
    { "type": "color_scheme", "id": "pillars_scheme", "label": "Pillars color scheme", "default": "scheme-heitz-cream" },
    { "type": "text", "id": "pillars_eyebrow", "label": "Pillars eyebrow", "default": "What guides us" },
    { "type": "inline_richtext", "id": "pillars_heading", "label": "Pillars heading", "default": "Three things we never compromise on" },
    { "type": "textarea", "id": "pillars_text", "label": "Pillars text", "default": "Every piece we offer is measured against these before it earns a place in your home." },
    { "type": "header", "content": "Shipping" },
    { "type": "color_scheme", "id": "shipping_scheme", "label": "Shipping color scheme", "default": "scheme-heitz-beige" },
    { "type": "text", "id": "shipping_eyebrow", "label": "Shipping eyebrow", "default": "Where we ship" },
    { "type": "inline_richtext", "id": "shipping_heading", "label": "Shipping heading", "default": "Serving homes across the United States" },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping text", "default": "Heitz ships nationwide with care taken at every stage of fulfilment. Shipping information and order details are communicated clearly, so you always know where your order stands." },
