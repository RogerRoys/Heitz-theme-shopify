{%- comment -%}
  Heitz About Shipping — intro text beside a bordered country card;
  card side switchable left/right.
{%- endcomment -%}
{% render 'heitz-tf-base' %}

<style>
  .habsh { font-family: var(--font-body--family, var(--htf-font-body)); }
  .habsh * { box-sizing: border-box; }
  .habsh__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 72px; padding-top: 64px; padding-bottom: 64px; background: var(--color-background, #f5f3ee); border-bottom: 1px solid var(--color-border, #ddd5c4); }
  @media only screen and (min-width: 769px) {
    .habsh--card-left .habsh__intro { order: 2; }
    .habsh--card-left .habsh__card { order: 1; }
  }
  .habsh__eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--color-primary, #b8913f);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .habsh__intro h2 {
    margin: 0 0 14px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
  }
  .habsh__intro p {
    margin: 0;
    color: var(--color-foreground, #7a6e5e);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
  }
  .habsh__card {
    padding: 36px 32px;
    background: var(--color-background, #f8f5f0);
    background-image: linear-gradient(rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.6));
    border: 1px solid var(--color-border, #ddd5c4);
  }
  .habsh__flag { display: block; margin-bottom: 12px; font-size: 26px; line-height: 1; }
  .habsh__card h3 {
    margin: 0 0 10px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: 26px;
    font-weight: 400;
    line-height: 1.3;
  }
  .habsh__card > p {
    margin: 0 0 18px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.9;
  }
  .habsh__details {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border, #ddd5c4);
  }
  .habsh__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.6;
  }
  .habsh__dot {
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    margin-top: 6px;
    background: var(--color-primary, #b8913f);
    border-radius: 50%;
  }
  @media only screen and (max-width: 768px) {
    .habsh__inner { grid-template-columns: minmax(0, 1fr); gap: 36px; padding-top: 48px; padding-bottom: 48px; }
    .habsh__card { padding: 30px 24px; }
  }
</style>

<section class="habsh color-{{ section.settings.color_scheme }}{% if section.settings.card_position == 'left' %} habsh--card-left{% endif %}">
  <div class="htf-page-width habsh__inner">
  <div class="habsh__intro">
    <span class="habsh__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="habsh__card">
    <span class="habsh__flag">{{ section.settings.card_flag }}</span>
    <h3>{{ section.settings.card_heading }}</h3>
    <p>{{ section.settings.card_text }}</p>
    <div class="habsh__details">
      {%- for block in section.blocks -%}
        <div class="habsh__item" {{ block.shopify_attributes }}>
          <span class="habsh__dot"></span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Heitz About Shipping",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-heitz-beige" },
    { "type": "select", "id": "card_position", "label": "Card position", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ], "default": "right" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where we ship" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Serving homes across the United States" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Heitz ships nationwide with care taken at every stage of fulfilment. Shipping information and order details are communicated clearly, so you always know where your order stands." },
    { "type": "text", "id": "card_flag", "label": "Card flag emoji", "default": "🇺🇸" },
    { "type": "inline_richtext", "id": "card_heading", "label": "Card heading", "default": "United States" },
    { "type": "textarea", "id": "card_text", "label": "Card text", "default": "From city apartments to family homes, our collection is built around calm, light-filled spaces — chosen to bring balance and warmth to the way you live." }
  ],
  "blocks": [
    {
      "type": "ship_item",
      "name": "Detail line",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Order tracking provided on every shipment" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heitz About Shipping",
      "blocks": [
        { "type": "ship_item", "settings": { "text": "Shipping available across the United States" } },
        { "type": "ship_item", "settings": { "text": "Pricing displayed in USD and GBP" } },
        { "type": "ship_item", "settings": { "text": "Order tracking provided on every shipment" } },
        { "type": "ship_item", "settings": { "text": "Customer support available via email" } }
      ]
    }
  ]
}
{% endschema %}
