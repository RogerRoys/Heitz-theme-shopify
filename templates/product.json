            "accordion_row_QBwLAe": {
              "type": "_accordion-row",
              "name": "t:names.accordion_dash_row",
              "settings": {
                "heading": "5. How long does shipping take?",
                "behavior": "drawer",
                "open_by_default": false,
                "drawer_background_color": "#ffffff",
                "icon": "none",
                "svg_code": "",
                "width": 20
              },
              "blocks": {
                "text_XqXxeX": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>We currently offer free shipping to the <strong>United States</strong> and the <strong>United Kingdom</strong>.</p><p><strong>USA:</strong> 8–15 business days<br/><strong>UK:</strong> 5–10 business days</p><p>Delivery times may vary slightly depending on your location and local courier conditions.</p>",
                    "width": "100%",
