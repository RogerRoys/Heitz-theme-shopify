{%- comment -%}
  Heitz TF featured collection — reference-style section header (title +
  "View all" outline button) with the THEME's own product cards inside
  (Horizon _product-card static block), so cards match the rest of the
  store and follow the theme color schemes.
{%- endcomment -%}
{%- assign col = collections[section.settings.collection] -%}
{%- assign limit = section.settings.limit | default: 5 -%}
<style>
  .htf-fc { padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px; background: var(--color-background, transparent); }
  .htf-fc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 25px;
  }
  .htf-fc__title {
    font-family: var(--htf-font-heading);
    font-weight: var(--font-heading--weight, 400);
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}font-size: var(--font-size, 24px); font-family: var(--font-family, var(--htf-font-heading)); font-weight: var(--font-weight, var(--font-heading--weight, 400)); line-height: var(--line-height, 1.1); letter-spacing: var(--letter-spacing, 0.025em); text-transform: var(--text-transform, none);{% endif %} color: var(--color, var(--color-foreground-heading, var(--htf-color-text)));
    letter-spacing: 0.025em;
    line-height: 1.1;
    color: var(--color-foreground-heading, var(--htf-color-text));
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }
  @media only screen and (min-width: 769px) {
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}.htf-fc__title { font-size: var(--font-size, 30px); }{% endif %}
  }
  .htf-fc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 27px 17px;
  }
  @media only screen and (min-width: 769px) {
    .htf-fc__grid { grid-template-columns: repeat({{ section.settings.columns | default: 5 }}, 1fr); }
  }
  .htf-fc .htf-btn--secondary {
    color: var(--color-foreground, var(--htf-color-text));
    border-color: var(--color-border, var(--htf-color-border));
  }
</style>

<div class="htf-fc color-{{ section.settings.color_scheme }}">
  <div class="htf-page-width">
    <div class="htf-fc__header">
      <h2 class="htf-fc__title{% unless section.settings.type_preset == 'custom' or section.settings.type_preset == blank %} {{ section.settings.type_preset }}{% endunless %}" style="{% render 'typography-style', settings: section.settings %}">{{ section.settings.title | default: col.title }}</h2>
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="htf-btn htf-btn--secondary htf-btn--small">{{ section.settings.link_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>

    <div class="htf-fc__grid">
      {%- if col != blank and col.products.size > 0 -%}
        {%- for product in col.products limit: limit -%}
          <div class="htf-fc__item">
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="htf-fc__item">
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Product Grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "type_preset", "label": "Preset", "info": "Edit presets in theme settings", "options": [ { "value": "custom", "label": "Custom" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" } ], "default": "custom" },
    { "type": "select", "id": "font", "label": "Font", "options": [ { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-accent--family)", "label": "Accent" } ], "default": "var(--font-heading--family)", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "font_size", "label": "Size", "options": [ { "value": "", "label": "Default" }, { "value": "0.625rem", "label": "10px" }, { "value": "0.75rem", "label": "12px" }, { "value": "0.875rem", "label": "14px" }, { "value": "1rem", "label": "16px" }, { "value": "1.125rem", "label": "18px" }, { "value": "1.25rem", "label": "20px" }, { "value": "1.5rem", "label": "24px" }, { "value": "2rem", "label": "32px" }, { "value": "2.5rem", "label": "40px" }, { "value": "3rem", "label": "48px" }, { "value": "3.5rem", "label": "56px" }, { "value": "4.5rem", "label": "72px" } ], "default": "", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "line_height", "label": "Line height", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "letter_spacing", "label": "Letter spacing", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "case", "label": "Case", "options": [ { "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" } ], "default": "none", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "color", "label": "Color", "options": [ { "value": "", "label": "Default" }, { "value": "var(--color-foreground)", "label": "Text" }, { "value": "var(--color-foreground-heading)", "label": "Heading" }, { "value": "var(--color-primary)", "label": "Link" } ], "default": "" },
    { "type": "text", "id": "title", "label": "Heading (falls back to collection title)" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "limit", "min": 2, "max": 10, "step": 1, "label": "Products to show", "default": 5 },
    { "type": "range", "id": "columns", "min": 3, "max": 5, "step": 1, "label": "Desktop columns", "default": 5 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Heitz TF Product Grid" }]
}
{% endschema %}
