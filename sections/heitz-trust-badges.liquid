{%- comment -%}
  Heitz TF trust badges — slim icon strip under the hero (tf-features port).
{%- endcomment -%}
<style>
  .htf-features {
    background-color: var(--color-background, #F9F9F9);
    padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px;
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
  }
  .htf-features__grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px clamp(28px, 4vw, 60px);
  }
  .htf-features__item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .htf-features__item svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    stroke: var(--color-foreground, #1a1a1a);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .htf-features__title {
    font-size: {{ section.settings.text_size | default: 11 }}px;
    font-weight: 400;
    color: var(--color-foreground, #1a1a1a);
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: var(--htf-font-heading, 'Fahkwang', sans-serif);
  }
  @media (max-width: 768px) {
    .htf-features { padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px; }
    .htf-features__grid {
      padding: 0 12px;
      justify-content: center;
      gap: 10px 18px;
    }
    .htf-features__item { gap: 6px; }
    .htf-features__item svg { width: 14px; height: 14px; }
    .htf-features__title {
      font-size: 9px;
      letter-spacing: 0.08em;
      white-space: nowrap;
      line-height: 1.3;
    }
  }
</style>

<div class="htf-features color-{{ section.settings.color_scheme }}">
  <div class="htf-features__grid">
    {%- for block in section.blocks -%}
      <div class="htf-features__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}
            <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {%- when 'returns' -%}
            <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M9 12l2 2 4-4"/></svg>
          {%- when 'globe' -%}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          {%- when 'shield' -%}
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {%- when 'pin' -%}
            <svg viewBox="0 0 24 24"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          {%- when 'chat-dots' -%}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"/><circle cx="8" cy="12" r="0.6"/><circle cx="12" cy="12" r="0.6"/><circle cx="16" cy="12" r="0.6"/></svg>
          {%- when 'chat' -%}
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        {%- endcase -%}
        <p class="htf-features__title">{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Trust Badges",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "returns", "label": "Returns check" },
            { "value": "globe", "label": "Globe" },
            { "value": "shield", "label": "Shield" },
            { "value": "pin", "label": "Map pin" },
            { "value": "chat-dots", "label": "Chat dots" },
            { "value": "chat", "label": "Chat bubble" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free Tracked Shipping" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Heitz TF Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "text": "Free Tracked Shipping" } },
        { "type": "badge", "settings": { "icon": "returns", "text": "30-Day Returns" } },
        { "type": "badge", "settings": { "icon": "globe", "text": "USA Delivery" } },
        { "type": "badge", "settings": { "icon": "shield", "text": "Secure Checkout" } },
        { "type": "badge", "settings": { "icon": "chat", "text": "Responsive Support" } }
      ]
    }
  ]
}
{% endschema %}
