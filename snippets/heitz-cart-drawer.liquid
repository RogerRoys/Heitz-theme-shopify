{%- comment -%}
  Heitz cart drawer restyle — Option C "Conversion+" on Horizon's cart
  drawer machinery: 450px right panel, uppercase spaced CART heading
  over a hairline, a free-shipping banner under the header (always
  unlocked — the store ships free on all orders; no gift tier by
  owner's call), compact 64px media rows with a compact bordered
  quantity box, then the footer: subtotal, full-width checkout
  carrying the cart total, Shop Pay accelerated button, and a trust
  row (free shipping /
  30-day returns / secure — verified against the store's published
  policies), with the reference's staggered reveal on open. Colors
  ride the drawer's color scheme; type is the house system.
{%- endcomment -%}

{% stylesheet %}
  /* ── panel ─────────────────────────────────────── */
  /* base.css (never syncs from git) sets width: 35rem !important at
     >=750px — match its priority, win on specificity */
  .cart-drawer__dialog.cart-drawer__dialog {
    width: 450px !important;
    max-width: calc(100vw - 4rem);
    border-radius: 0;
  }
  .cart-drawer__dialog::backdrop { cursor: zoom-out; }

  /* ── header: CART over a hairline ─────────────── */
  .cart-drawer__header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border, #d2d5d9);
  }
  /* doubled: base.css h4 rules load later and win ties */
  .cart-drawer__heading.cart-drawer__heading {
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
  }

  /* ── free-shipping banner (always unlocked) ────── */
  .hcd-ship {
    padding: 13px 20px 12px;
    background: #faf8f4;
    border-bottom: 1px solid #eee9e0;
  }
  .hcd-ship__text {
    margin: 0 0 8px;
    font-family: var(--font-body--family);
    font-size: 13px;
    color: #4a453e;
  }
  .hcd-ship__bar {
    height: 3px;
    background: #e8e2d7;
    position: relative;
  }
  .hcd-ship__fill {
    position: absolute;
    inset: 0;
    width: 100%;
    background: #9f6939;
  }
  .hcd-ship__row {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-family: var(--font-body--family);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9a938a;
  }
  .hcd-ship__on { color: #9f6939; }

  /* ── item rows ─────────────────────────────────── */
  .cart-drawer__items .cart-items__media-container,
  .cart-drawer__items .cart-items__media-image {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 0;
  }
  .cart-drawer__items .cart-items__title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
  }
  .cart-drawer__items .cart-items__details {
    font-size: 12.5px;
  }
  .cart-drawer__items .cart-items__details .variant-option,
  .cart-drawer__items .cart-items__option {
    font-size: 12.5px;
    color: var(--color-foreground, #212326);
    opacity: 0.55;
  }
  .cart-drawer__items .cart-items__price,
  .cart-drawer__items .cart-price {
    font-family: var(--font-body--family);
    font-size: 14px;
  }
  /* compact bordered quantity control, reference proportions */
  /* Horizon markup: .quantity-selector { flex: 0 0 var(--quantity-selector-width) }
     with .quantity-minus/.quantity-plus buttons (44px touch targets) and a
     bare input — flex-basis beats width, so pin the basis too */
  .cart-drawer__items quantity-selector-component,
  .cart-drawer__items .quantity-selector {
    border: 1px solid rgba(210, 213, 217, 0.8);
    border-radius: 0;
    min-height: 26px;
    height: 26px;
    flex: 0 0 78px;
    width: 78px;
    min-width: 78px;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
  }
  .cart-drawer__items .quantity-selector .quantity-minus,
  .cart-drawer__items .quantity-selector .quantity-plus {
    min-width: 24px;
    width: 24px;
    min-height: 24px;
    height: 24px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cart-drawer__items .quantity-selector .svg-wrapper,
  .cart-drawer__items .quantity-selector .svg-wrapper svg {
    width: 9px;
    height: 9px;
  }
  .cart-drawer__items .quantity-selector input {
    font-size: 12.5px;
    min-width: 28px;
    width: 28px;
    height: 24px;
    padding: 0;
    text-align: center;
    border: 0;
    background: transparent;
  }

  /* ── footer / summary ──────────────────────────── */
  .cart-drawer__summary {
    padding: 14px 20px 20px;
    border-top: 1px solid var(--color-border, #d2d5d9);
  }
  .cart-drawer__summary .cart__original-total-label,
  .cart-drawer__summary .cart__total-label {
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 500;
  }
  .cart-drawer__summary .cart__summary-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cart-drawer__summary .cart__checkout-button {
    border-radius: 0;
    min-height: 46px;
    white-space: nowrap;
    /* the base button is display:grid — keep label and total on one row */
    grid-auto-flow: column;
    justify-content: center;
    column-gap: 0.45em;
  }
  .hcd-checkout-total { font-weight: inherit; }
  /* Option C footer order: totals → CHECKOUT · total → Shop Pay
     → trust row */
  .cart-drawer__summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-items: stretch;
  }
  .cart-drawer__summary > .cart__summary-totals { grid-column: 1 / -1; order: 1; }
  .cart-drawer__summary .cart__ctas { margin: 0; grid-column: 1 / -1; order: 3; }
  .cart-drawer__summary .additional-checkout-buttons {
    margin-top: 10px;
  }
  .cart-drawer__summary .additional-checkout-buttons > * { border-radius: 0; }
  .hcd-trust {
    grid-column: 1 / -1;
    order: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding-top: 2px;
    font-family: var(--font-body--family);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb, 33 35 38) / 0.55);
  }
  .hcd-trust span { display: inline-flex; align-items: center; gap: 6px; }
  .hcd-trust svg {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
    stroke: #9f6939;
    stroke-width: 1.6;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── recommendations side panel (desktop) ─────── */
  .hcd-recs {
    display: none;
    flex: 0 0 450px;
    flex-direction: column;
    border-right: 1px solid var(--color-border, #d2d5d9);
    background: var(--color-background, #ffffff);
    overflow-y: auto;
  }
  @media screen and (min-width: 1100px) {
    .cart-drawer__dialog:not(.cart-drawer--empty)[open] {
      display: flex;
      flex-direction: row;
      transition: width 0.35s ease;
    }
    /* widen only once the recs panel actually has content, so the
       cart column always keeps its full 450px */
    .cart-drawer__dialog:not(.cart-drawer--empty)[open]:has(.hcd-recs.is-ready) {
      width: 900px !important;
      max-width: min(900px, calc(100vw - 4rem));
    }
    .cart-drawer__dialog:not(.cart-drawer--empty)[open]:has(.hcd-recs.is-ready) .hcd-recs { display: flex; }
    .cart-drawer__inner { flex: 1 1 auto; min-width: 0; }
  }
  .hcd-recs__head {
    padding: 20px;
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
  }
  .hcd-recs__list { padding: 0 20px 20px; }
  .hcd-rec {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(26, 27, 24, 0.08);
  }
  .hcd-rec:last-child { border-bottom: 0; }
  .hcd-rec__img {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    background: #f4f2ee;
    display: block;
  }
  .hcd-rec__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hcd-rec__info { flex: 1 1 auto; min-width: 0; }
  .hcd-rec__title {
    display: block;
    font-family: var(--font-heading--family);
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--color-foreground-heading, #1a1b18);
    text-decoration: none;
    margin: 0 0 4px;
  }
  .hcd-rec__price {
    font-family: var(--font-body--family);
    font-size: 13px;
    color: var(--color-foreground, #212326);
    margin: 0 0 7px;
  }
  .hcd-rec__price s { color: #9a938a; margin-left: 6px; font-size: 12.5px; }
  .hcd-rec__choose {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: none;
    padding: 0 0 4px;
    border-bottom: 1px solid var(--color-border, #d2d5d9);
    font-family: var(--button-font-family-primary, var(--font-body--family));
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
    cursor: pointer;
    transition: color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out);
  }
  .hcd-rec__choose:hover { color: var(--color-primary-button-hover-background, #9f6939); }
  .hcd-rec__choose svg { width: 16px; height: 10px; stroke: currentColor; stroke-width: 1.5; fill: none; stroke-linecap: round; }


  /* ── reference stagger: header → items → footer ── */
  @keyframes hcd-in {
    from { opacity: 0; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .cart-drawer__dialog[open] .cart-drawer__header {
    animation: hcd-in 0.4s ease both 0.12s;
  }
  .cart-drawer__dialog[open] .hcd-ship {
    animation: hcd-in 0.42s ease both 0.15s;
  }
  .cart-drawer__dialog[open] .cart-drawer__items {
    animation: hcd-in 0.45s ease both 0.18s;
  }
  .cart-drawer__dialog[open] .hcd-recs { animation: hcd-in 0.5s ease both 0.28s; }
  .cart-drawer__dialog[open] .cart-drawer__summary {
    animation: hcd-in 0.5s ease both 0.24s;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__dialog[open] .cart-drawer__header,
    .cart-drawer__dialog[open] .hcd-ship,
    .cart-drawer__dialog[open] .cart-drawer__items,
    .cart-drawer__dialog[open] .hcd-recs,
    .cart-drawer__dialog[open] .cart-drawer__summary {
      animation: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var moneyTemplate = {{ shop.money_format | json }};
    function money(cents) {
      var amount = (cents / 100).toFixed(2);
      var parts = amount.split('.');
      var whole = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return moneyTemplate
        .replace(/\{\{\s*amount\s*\}\}/, whole + '.' + parts[1])
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/, whole)
        .replace(/<[^>]*>/g, '');
    }

    var lastLead = null;
    function loadRecs() {
      var panel = document.querySelector('[data-hcd-recs]');
      var list = document.querySelector('[data-hcd-recs-list]');
      if (!panel || !list) return;
      fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
        if (!cart.items || !cart.items.length) { panel.classList.remove('is-ready'); return; }
        var lead = cart.items[0].product_id;
        if (lead === lastLead && list.children.length) { panel.classList.add('is-ready'); return; }
        lastLead = lead;
        var inCart = cart.items.map(function (i) { return i.product_id; });
        fetch('/recommendations/products.json?product_id=' + lead + '&limit=6')
          .then(function (r) { return r.ok ? r.json() : { products: [] }; })
          .then(function (data) {
            var prods = (data.products || []).filter(function (p) { return inCart.indexOf(p.id) === -1; }).slice(0, 4);
            if (!prods.length) { panel.classList.remove('is-ready'); return; }
            list.innerHTML = '';
            prods.forEach(function (p) {
              var img = p.featured_image || (p.images && p.images[0]) || '';
              img = String(img);
              if (img.indexOf('//') === 0) img = 'https:' + img;
              if (img) img += (img.indexOf('?') > -1 ? '&' : '?') + 'width=240';
              var onSale = p.compare_at_price && p.compare_at_price > p.price;

              var row = document.createElement('div');
              row.className = 'hcd-rec';

              var imgLink = document.createElement('a');
              imgLink.className = 'hcd-rec__img';
              imgLink.href = p.url;
              if (img) {
                var im = document.createElement('img');
                im.src = img; im.alt = ''; im.loading = 'lazy';
                imgLink.appendChild(im);
              }

              var info = document.createElement('div');
              info.className = 'hcd-rec__info';

              var title = document.createElement('a');
              title.className = 'hcd-rec__title';
              title.href = p.url;
              title.textContent = p.title;

              var price = document.createElement('p');
              price.className = 'hcd-rec__price';
              price.textContent = money(p.price);
              if (onSale) {
                var s = document.createElement('s');
                s.textContent = money(p.compare_at_price);
                price.appendChild(document.createTextNode(' '));
                price.appendChild(s);
              }

              var choose = document.createElement('button');
              choose.type = 'button';
              choose.className = 'hcd-rec__choose';
              choose.setAttribute('data-heitz-qv', p.url);
              choose.innerHTML = 'Choose options <svg viewBox="0 0 20 12"><path d="M1 6h17m-5-5 5 5-5 5"></path></svg>';

              info.appendChild(title);
              info.appendChild(price);
              info.appendChild(choose);
              row.appendChild(imgLink);
              row.appendChild(info);
              list.appendChild(row);
            });
            panel.classList.add('is-ready');
          });
      }).catch(function () {});
    }

    var wire = function () {
      var dialog = document.querySelector('cart-drawer-component dialog');
      if (dialog) {
        new MutationObserver(function () {
          if (dialog.hasAttribute('open')) loadRecs();
        }).observe(dialog, { attributes: true, attributeFilter: ['open'] });
        if (dialog.hasAttribute('open')) loadRecs();
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wire);
    } else {
      wire();
    }
  })();
</script>
