{%- comment -%}
  Heitz TF newsletter — "Sign up and save" centered email capture.
  Posts to the Shopify customer form (tags: prospect, newsletter).
{%- endcomment -%}
<style>
  .htf-newsletter {
    background-color: var(--color-background, #f9f9f9);
    color: var(--color-foreground, #1c1d1d);
    padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px;
    text-align: center;
  }
  .htf-newsletter__title {
    font-family: var(--htf-font-heading);
    font-weight: 400;
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}font-size: var(--font-size, 26px); font-family: var(--font-family, var(--htf-font-heading)); font-weight: var(--font-weight, 400); letter-spacing: var(--letter-spacing, 0.025em); text-transform: var(--text-transform, none);{% endif %} color: var(--color, var(--color-foreground, var(--htf-color-text)));
    letter-spacing: 0.025em;
    color: var(--color-foreground, var(--htf-color-text));
    margin: 0 0 15px;
  }
  .htf-newsletter__text {
    font-family: var(--htf-font-body);
    font-size: {{ section.settings.text_size | default: 19 }}px;
    line-height: 1.4;
    color: var(--color-foreground, var(--htf-color-text));
    margin: 0 0 25px;
  }
  .htf-newsletter__group {
    display: flex;
    margin: 0 auto;
    max-width: 400px;
  }
  .htf-newsletter__input {
    background: transparent;
    border: 1px solid var(--color-foreground, var(--htf-color-text));
    border-right: 0;
    border-radius: 0;
    color: var(--color-foreground, var(--htf-color-text));
    flex: 1 1 auto;
    font-family: var(--htf-font-body);
    font-size: 15px;
    min-width: 0;
    padding: 10px 15px;
  }
  .htf-newsletter__input::placeholder { color: var(--color-foreground, #1c1d1d); opacity: 1; }
  .htf-newsletter__success {
    font-family: var(--htf-font-body);
    font-size: 15px;
    color: var(--color-foreground, var(--htf-color-text));
    margin-top: 15px;
  }
</style>

<div class="htf-newsletter color-{{ section.settings.color_scheme }}">
  <div class="htf-page-width">
    <p class="htf-newsletter__title{% unless section.settings.type_preset == 'custom' or section.settings.type_preset == blank %} {{ section.settings.type_preset }}{% endunless %}" style="{% render 'typography-style', settings: section.settings %}">{{ section.settings.title }}</p>
    <div class="htf-newsletter__text">{{ section.settings.text }}</div>
    {%- form 'customer' -%}
      {%- if form.posted_successfully? -%}
        <p class="htf-newsletter__success">Thanks for subscribing!</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="prospect,newsletter">
        <div class="htf-newsletter__group">
          <input type="email"
            name="contact[email]"
            id="HtfNewsletterEmail-{{ section.id }}"
            class="htf-newsletter__input"
            placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
            autocorrect="off"
            autocapitalize="off"
            required>
          <button type="submit" class="htf-btn htf-bs-{{ section.settings.button_style | default: 'primary' }}">{{ section.settings.button_label | default: 'Subscribe' }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Newsletter",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "type_preset", "label": "Preset", "info": "Edit presets in theme settings", "options": [ { "value": "custom", "label": "Custom" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" } ], "default": "custom" },
    { "type": "select", "id": "font", "label": "Font", "options": [ { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-accent--family)", "label": "Accent" } ], "default": "var(--font-heading--family)", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "font_size", "label": "Size", "options": [ { "value": "", "label": "Default" }, { "value": "0.625rem", "label": "10px" }, { "value": "0.75rem", "label": "12px" }, { "value": "0.875rem", "label": "14px" }, { "value": "1rem", "label": "16px" }, { "value": "1.125rem", "label": "18px" }, { "value": "1.25rem", "label": "20px" }, { "value": "1.5rem", "label": "24px" }, { "value": "2rem", "label": "32px" }, { "value": "2.5rem", "label": "40px" }, { "value": "3rem", "label": "48px" }, { "value": "3.5rem", "label": "56px" }, { "value": "4.5rem", "label": "72px" } ], "default": "", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "line_height", "label": "Line height", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "letter_spacing", "label": "Letter spacing", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "case", "label": "Case", "options": [ { "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" } ], "default": "none", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "color", "label": "Color", "options": [ { "value": "", "label": "Default" }, { "value": "var(--color-foreground)", "label": "Text" }, { "value": "var(--color-foreground-heading)", "label": "Heading" }, { "value": "var(--color-primary)", "label": "Link" } ], "default": "" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Sign up and save" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Be the first to know about new arrivals and special offers." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "link", "label": "Link" } ], "default": "primary" }
  ],
  "presets": [{ "name": "Heitz TF Newsletter" }]
}
{% endschema %}
