{%- comment -%}
  Heitz cart drawer restyle — Option C "Conversion+" on Horizon's cart
  drawer machinery: 450px right panel, uppercase spaced CART heading
  over a hairline, compact 64px media rows with a compact bordered
  quantity box, then the footer: subtotal, full-width checkout
  carrying the cart total, Shop Pay accelerated button, and a trust
  row (free shipping / 30-day returns / secure — verified against the
  store's published policies), with the reference's staggered reveal
  on open. Mobile (<1100px, Option B "Cart First" from the design
  canvas): recommendations render as a horizontal swipe strip between
  the items and the footer — floating chip title on the hairline,
  82%-width cards with a square quick-view (+) button. The
  recommendations script renders BOTH surfaces from one fetch and
  survives Horizon's cart morphs: rebuilt rows are cached and restored
  in the same microtask when a cart update wipes them, so neither
  panel collapses mid-session. Colors ride the drawer's color scheme;
  type is the house system.
{%- endcomment -%}

{% stylesheet %}
  /* ── panel ─────────────────────────────────────── */
  /* base.css (never syncs from git) sets width: 35rem !important at
     >=750px — match its priority, win on specificity */
  .cart-drawer__dialog.cart-drawer__dialog {
    width: 450px !important;
    max-width: calc(100vw - 4rem);
    border-radius: 0;
  }
  .cart-drawer__dialog::backdrop { cursor: zoom-out; }

  /* ── reference open/close: smooth right slide ──── */
  /* base.css animates dialogs at --animation-speed (200ms via the
     premium css) — force the drawer onto move-and-fade with the
     reference's longer, silky ease; specificity beats both the
     .dialog-modal and .dialog-drawer base rules */
  .cart-drawer__dialog.cart-drawer__dialog[open] {
    --start-x: 100%;
    --end-x: 0px;
    --start-opacity: 1;
    --end-opacity: 1;
    animation: move-and-fade 0.5s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  }
  .cart-drawer__dialog.cart-drawer__dialog[open].dialog-closing {
    --start-x: 0px;
    --end-x: 100%;
    animation: move-and-fade 0.4s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  }
  .cart-drawer__dialog.cart-drawer__dialog[open]::backdrop {
    transition: opacity 0.4s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__dialog.cart-drawer__dialog[open],
    .cart-drawer__dialog.cart-drawer__dialog[open].dialog-closing {
      animation-duration: 0.01ms;
    }
  }

  /* ── header: CART over a hairline ─────────────── */
  .cart-drawer__header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border, #d2d5d9);
  }
  /* doubled: base.css h4 rules load later and win ties */
  .cart-drawer__heading.cart-drawer__heading {
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
  }

  /* ── item rows ─────────────────────────────────── */
  .cart-drawer__items.cart-drawer__items { padding-top: 12px; }
  /* the row grid's media track shrinks below our 64px image on narrow
     drawers and the image overlaps the title's first letters — pin it */
  .cart-drawer__items .cart-items__table-row {
    grid-template-columns: 64px minmax(0, 1fr) auto;
  }
  .cart-drawer__items .cart-items__media-container,
  .cart-drawer__items .cart-items__media-image {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 0;
  }
  .cart-drawer__items .cart-items__title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
  }
  .cart-drawer__items .cart-items__details {
    font-size: 12.5px;
  }
  .cart-drawer__items .cart-items__details .variant-option,
  .cart-drawer__items .cart-items__option {
    font-size: 12.5px;
    color: var(--color-foreground, #212326);
    opacity: 0.55;
  }
  .cart-drawer__items .cart-items__price,
  .cart-drawer__items .cart-price {
    font-family: var(--font-body--family);
    font-size: 14px;
  }
  /* compact bordered quantity control, reference proportions */
  /* Horizon markup: .quantity-selector { flex: 0 0 var(--quantity-selector-width) }
     with .quantity-minus/.quantity-plus buttons (44px touch targets) and a
     bare input — flex-basis beats width, so pin the basis too */
  .cart-drawer__items quantity-selector-component,
  .cart-drawer__items .quantity-selector {
    border: 1px solid rgba(210, 213, 217, 0.8);
    border-radius: 0;
    min-height: 26px;
    height: 26px;
    flex: 0 0 78px;
    width: 78px;
    min-width: 78px;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
  }
  .cart-drawer__items .quantity-selector .quantity-minus,
  .cart-drawer__items .quantity-selector .quantity-plus {
    min-width: 24px;
    width: 24px;
    min-height: 24px;
    height: 24px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cart-drawer__items .quantity-selector .svg-wrapper,
  .cart-drawer__items .quantity-selector .svg-wrapper svg {
    width: 9px;
    height: 9px;
  }
  .cart-drawer__items .quantity-selector input {
    font-size: 12.5px;
    min-width: 28px;
    width: 28px;
    height: 24px;
    padding: 0;
    text-align: center;
    border: 0;
    background: transparent;
  }

  /* ── footer / summary ──────────────────────────── */
  .cart-drawer__summary {
    padding: 14px 20px 20px;
    border-top: 1px solid var(--color-border, #d2d5d9);
  }
  .cart-drawer__summary .cart__original-total-label,
  .cart-drawer__summary .cart__total-label {
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 500;
  }
  .cart-drawer__summary .cart__summary-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cart-drawer__summary .cart__checkout-button {
    border-radius: 0;
    min-height: 46px;
    white-space: nowrap;
    /* the base button is display:grid — keep label and total on one row */
    grid-auto-flow: column;
    justify-content: center;
    column-gap: 0.45em;
  }
  .hcd-checkout-total { font-weight: inherit; }
  /* Option C footer order: totals → CHECKOUT · total → Shop Pay
     → trust row */
  .cart-drawer__summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-items: stretch;
  }
  .cart-drawer__summary > .cart__summary-totals { grid-column: 1 / -1; order: 1; }
  .cart-drawer__summary .cart__ctas { margin: 0; grid-column: 1 / -1; order: 3; }
  .cart-drawer__summary .additional-checkout-buttons {
    margin-top: 10px;
  }
  .cart-drawer__summary .additional-checkout-buttons > * { border-radius: 0; }
  .hcd-trust {
    grid-column: 1 / -1;
    order: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding-top: 2px;
    font-family: var(--font-body--family);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb, 33 35 38) / 0.55);
  }
  .hcd-trust span { display: inline-flex; align-items: center; gap: 6px; }
  .hcd-trust svg {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
    stroke: #9f6939;
    stroke-width: 1.6;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── recommendations side panel (desktop) ─────── */
  .hcd-recs {
    display: none;
    flex: 0 0 450px;
    flex-direction: column;
    border-right: 1px solid var(--color-border, #d2d5d9);
    background: var(--color-background, #ffffff);
    overflow-y: auto;
  }
  @media screen and (min-width: 1100px) {
    .cart-drawer__dialog:not(.cart-drawer--empty)[open] {
      display: flex;
      flex-direction: row;
      transition: width 0.35s ease;
    }
    /* widen only once the recs panel actually has content, so the
       cart column always keeps its full 450px */
    .cart-drawer__dialog:not(.cart-drawer--empty)[open]:has(.hcd-recs.is-ready) {
      width: 900px !important;
      max-width: min(900px, calc(100vw - 4rem));
    }
    .cart-drawer__dialog:not(.cart-drawer--empty)[open]:has(.hcd-recs.is-ready) .hcd-recs { display: flex; }
    .cart-drawer__inner { flex: 1 1 auto; min-width: 0; }
  }
  .hcd-recs__head {
    padding: 20px;
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
  }
  .hcd-recs__list { padding: 0 20px 20px; }
  .hcd-rec {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(26, 27, 24, 0.08);
  }
  .hcd-rec:last-child { border-bottom: 0; }
  .hcd-rec__img {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    background: #f4f2ee;
    display: block;
  }
  .hcd-rec__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hcd-rec__info { flex: 1 1 auto; min-width: 0; }
  .hcd-rec__title {
    display: block;
    font-family: var(--font-heading--family);
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--color-foreground-heading, #1a1b18);
    text-decoration: none;
    margin: 0 0 4px;
  }
  .hcd-rec__price {
    font-family: var(--font-body--family);
    font-size: 13px;
    color: var(--color-foreground, #212326);
    margin: 0 0 7px;
  }
  .hcd-rec__price s { color: #9a938a; margin-left: 6px; font-size: 12.5px; }
  .hcd-rec__choose {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: none;
    padding: 0 0 4px;
    border-bottom: 1px solid var(--color-border, #d2d5d9);
    font-family: var(--button-font-family-primary, var(--font-body--family));
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
    cursor: pointer;
    transition: color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out);
  }
  .hcd-rec__choose:hover { color: var(--color-primary-button-hover-background, #9f6939); }
  .hcd-rec__choose svg { width: 16px; height: 10px; stroke: currentColor; stroke-width: 1.5; fill: none; stroke-linecap: round; }

  /* ── mobile recommendations strip (Option B) ───── */
  .hcd-mrecs { display: none; }
  @media screen and (max-width: 1099px) {
    .hcd-mrecs.is-ready {
      display: block;
      position: relative;
      margin-top: auto;
      border-top: 1px solid rgba(26, 27, 24, 0.08);
    }
  }
  .hcd-mrecs__head {
    position: absolute;
    top: 0;
    left: 14px;
    transform: translateY(-50%);
    background: var(--color-background, #ffffff);
    padding: 0 10px;
    font-family: var(--font-heading--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
  }
  .hcd-mrecs__list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 22px 16px 14px;
    -webkit-overflow-scrolling: touch;
  }
  .hcd-mrecs__list::-webkit-scrollbar { height: 2px; }
  .hcd-mrecs__list::-webkit-scrollbar-thumb { background: var(--color-border, #d2d5d9); }
  .hcd-mrec {
    flex: 0 0 82%;
    display: flex;
    gap: 12px;
    align-items: center;
    border: 1px solid rgba(26, 27, 24, 0.08);
    padding: 10px;
  }
  .hcd-mrec__img {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    background: #f4f2ee;
    display: block;
  }
  .hcd-mrec__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hcd-mrec__info { flex: 1 1 auto; min-width: 0; }
  .hcd-mrec__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-size: 13px;
    line-height: 1.35;
    color: var(--color-foreground-heading, #1a1b18);
    text-decoration: none;
    margin: 0 0 3px;
  }
  .hcd-mrec__price {
    font-family: var(--font-body--family);
    font-size: 12.5px;
    color: var(--color-foreground, #212326);
    margin: 0;
  }
  .hcd-mrec__price s { color: #9a938a; margin-left: 5px; font-size: 12px; }
  .hcd-mrec__add {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: var(--color-primary-button-background, #1a1b18);
    color: var(--color-primary-button-text, #ffffff);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out);
  }
  @media (hover: hover) {
    .hcd-mrec__add:hover { background: var(--color-primary-button-hover-background, #9f6939); }
  }
  .hcd-mrec__add svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 1.8; fill: none; stroke-linecap: round; }


  /* ── reference stagger: header → items → footer ── */
  @keyframes hcd-in {
    from { opacity: 0; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .cart-drawer__dialog[open] .cart-drawer__header {
    animation: hcd-in 0.4s ease both 0.12s;
  }
  .cart-drawer__dialog[open] .cart-drawer__items {
    animation: hcd-in 0.45s ease both 0.18s;
  }
  .cart-drawer__dialog[open] .hcd-recs { animation: hcd-in 0.5s ease both 0.28s; }
  .cart-drawer__dialog[open] .hcd-mrecs { animation: hcd-in 0.48s ease both 0.22s; }
  .cart-drawer__dialog[open] .cart-drawer__summary {
    animation: hcd-in 0.5s ease both 0.24s;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__dialog[open] .cart-drawer__header,
    .cart-drawer__dialog[open] .cart-drawer__items,
    .cart-drawer__dialog[open] .hcd-recs,
    .cart-drawer__dialog[open] .hcd-mrecs,
    .cart-drawer__dialog[open] .cart-drawer__summary {
      animation: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var moneyTemplate = {{ shop.money_format | json }};
    function money(cents) {
      var amount = (cents / 100).toFixed(2);
      var parts = amount.split('.');
      var whole = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return moneyTemplate
        .replace(/\{\{\s*amount\s*\}\}/, whole + '.' + parts[1])
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/, whole)
        .replace(/<[^>]*>/g, '');
    }

    var lastLead = null;
    var lastFetched = null;
    var lastInCart = [];
    var shown = false;
    var loadedForOpen = false;

    function panelEls() {
      return {
        panel: document.querySelector('[data-hcd-recs]'),
        list: document.querySelector('[data-hcd-recs-list]'),
        mPanel: document.querySelector('[data-hcd-mrecs]'),
        mList: document.querySelector('[data-hcd-mrecs-list]')
      };
    }

    function normalizeImage(p) {
      var img = p.featured_image || (p.images && p.images[0]) || '';
      img = String(img);
      if (img.indexOf('//') === 0) img = 'https:' + img;
      if (img) img += (img.indexOf('?') > -1 ? '&' : '?') + 'width=240';
      return img;
    }

    function priceNode(p, cls) {
      var price = document.createElement('p');
      price.className = cls;
      price.textContent = money(p.price);
      if (p.compare_at_price && p.compare_at_price > p.price) {
        var s = document.createElement('s');
        s.textContent = money(p.compare_at_price);
        price.appendChild(document.createTextNode(' '));
        price.appendChild(s);
      }
      return price;
    }

    function imageNode(p, cls) {
      var img = normalizeImage(p);
      var link = document.createElement('a');
      link.className = cls;
      link.href = p.url;
      if (img) {
        var im = document.createElement('img');
        im.src = img; im.alt = ''; im.loading = 'lazy';
        link.appendChild(im);
      }
      return link;
    }

    function buildDesktopRow(p) {
      var row = document.createElement('div');
      row.className = 'hcd-rec';

      var info = document.createElement('div');
      info.className = 'hcd-rec__info';

      var title = document.createElement('a');
      title.className = 'hcd-rec__title';
      title.href = p.url;
      title.textContent = p.title;

      var choose = document.createElement('button');
      choose.type = 'button';
      choose.className = 'hcd-rec__choose';
      choose.setAttribute('data-heitz-qv', p.url);
      choose.innerHTML = 'Choose options <svg viewBox="0 0 20 12"><path d="M1 6h17m-5-5 5 5-5 5"></path></svg>';

      info.appendChild(title);
      info.appendChild(priceNode(p, 'hcd-rec__price'));
      info.appendChild(choose);
      row.appendChild(imageNode(p, 'hcd-rec__img'));
      row.appendChild(info);
      return row;
    }

    function buildStripCard(p) {
      var card = document.createElement('div');
      card.className = 'hcd-mrec';

      var info = document.createElement('div');
      info.className = 'hcd-mrec__info';

      var title = document.createElement('a');
      title.className = 'hcd-mrec__title';
      title.href = p.url;
      title.textContent = p.title;

      var add = document.createElement('button');
      add.type = 'button';
      add.className = 'hcd-mrec__add';
      add.setAttribute('data-heitz-qv', p.url);
      add.setAttribute('aria-label', 'Choose options');
      add.innerHTML = '<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>';

      info.appendChild(title);
      info.appendChild(priceNode(p, 'hcd-mrec__price'));
      card.appendChild(imageNode(p, 'hcd-mrec__img'));
      card.appendChild(info);
      card.appendChild(add);
      return card;
    }

    function renderRows(els, prods, inCart) {
      var filtered = prods.filter(function (p) { return inCart.indexOf(p.id) === -1; }).slice(0, 4);
      var any = filtered.length > 0;
      if (els.list) {
        els.list.innerHTML = '';
        if (any) filtered.forEach(function (p) { els.list.appendChild(buildDesktopRow(p)); });
      }
      if (els.mList) {
        els.mList.innerHTML = '';
        if (any) filtered.forEach(function (p) { els.mList.appendChild(buildStripCard(p)); });
      }
      if (els.panel) els.panel.classList.toggle('is-ready', any);
      if (els.mPanel) els.mPanel.classList.toggle('is-ready', any);
      shown = any;
    }

    function clearAll(els) {
      if (els.panel) els.panel.classList.remove('is-ready');
      if (els.mPanel) els.mPanel.classList.remove('is-ready');
      if (els.list) els.list.innerHTML = '';
      if (els.mList) els.mList.innerHTML = '';
      shown = false;
    }

    function loadRecs() {
      var els = panelEls();
      if (!els.list && !els.mList) return;
      fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
        var els2 = panelEls();
        if (!els2.list && !els2.mList) return;
        if (!cart.items || !cart.items.length) { clearAll(els2); return; }
        var lead = cart.items[0].product_id;
        var inCart = cart.items.map(function (i) { return i.product_id; });
        lastInCart = inCart;
        if (lead === lastLead && lastFetched) {
          renderRows(els2, lastFetched, inCart);
          return;
        }
        lastLead = lead;
        fetch('/recommendations/products.json?product_id=' + lead + '&limit=8')
          .then(function (r) { return r.ok ? r.json() : { products: [] }; })
          .then(function (data) {
            lastFetched = data.products || [];
            var els3 = panelEls();
            if (els3.list || els3.mList) renderRows(els3, lastFetched, lastInCart);
          });
      }).catch(function () {});
    }

    var ensureQueued = false;
    function ensure() {
      if (ensureQueued) return;
      ensureQueued = true;
      Promise.resolve().then(function () {
        ensureQueued = false;
        var dialog = document.querySelector('cart-drawer-component dialog');
        var els = panelEls();
        if (!dialog || (!els.list && !els.mList)) return;
        if (!dialog.hasAttribute('open')) { loadedForOpen = false; return; }
        if (!loadedForOpen) { loadedForOpen = true; loadRecs(); return; }
        var wiped = (els.list && !els.list.children.length) ||
          (els.mList && !els.mList.children.length) ||
          (els.panel && !els.panel.classList.contains('is-ready')) ||
          (els.mPanel && !els.mPanel.classList.contains('is-ready'));
        if (shown && wiped) {
          if (lastFetched) renderRows(els, lastFetched, lastInCart);
          loadRecs();
        }
      });
    }

    new MutationObserver(ensure).observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['open']
    });
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensure);
    } else {
      ensure();
    }
  })();
</script>
