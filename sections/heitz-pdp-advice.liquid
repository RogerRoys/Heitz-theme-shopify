{%- comment -%}
  Heitz PDP advice banner — black side panel + "Ask for Advice" CTA
  (outdoor-advice port from the reference).
{%- endcomment -%}
{% render 'heitz-pdp-base' %}
<style>
  .hpdp-advice { width: 100%; padding: 30px 20px; font-family: var(--hpdp-font-body); }
  .hpdp-advice__inner {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    background: #f7f7f5;
    border: 1px solid #dddddd;
    overflow: hidden;
  }
  .hpdp-advice__panel {
    min-height: 210px;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--hpdp-ink);
    color: #ffffff;
  }
  .hpdp-advice__icon {
    width: 46px; height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 50%;
  }
  .hpdp-advice__icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .hpdp-advice__panel-label {
    margin-top: 28px;
    font-family: var(--hpdp-font-heading);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .hpdp-advice__content {
    min-width: 0;
    padding: 34px 42px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 46px;
  }
  .hpdp-advice__eyebrow {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #777777;
  }
  .hpdp-advice__heading {
    margin: 0 0 11px;
    font-family: var(--hpdp-font-heading);
    font-weight: 600;
    font-size: 25px;
    line-height: 1.25;
    letter-spacing: .5px;
    color: var(--hpdp-ink);
  }
  .hpdp-advice__text {
    max-width: 760px;
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    letter-spacing: .2px;
    color: #555555;
  }
  .hpdp-advice__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 13px 22px;
    white-space: nowrap;
    background: var(--hpdp-ink);
    border: 1px solid var(--hpdp-ink);
    font-family: var(--hpdp-font-heading);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: .8px;
    color: #ffffff;
    text-decoration: none;
    transition: background-color .25s ease, color .25s ease, transform .25s ease;
  }
  .hpdp-advice__button:hover { background: transparent; color: var(--hpdp-ink); transform: translateY(-2px); }
  .hpdp-advice__button svg { width: 17px; height: 17px; margin-left: 10px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  @media screen and (max-width: 989px) {
    .hpdp-advice__inner { grid-template-columns: 140px minmax(0, 1fr); }
    .hpdp-advice__panel { padding: 26px 20px; }
    .hpdp-advice__content { padding: 30px; grid-template-columns: 1fr; row-gap: 22px; }
    .hpdp-advice__button { justify-self: start; }
  }
  @media screen and (max-width: 749px) {
    .hpdp-advice { padding: 20px 14px; }
    .hpdp-advice__inner { grid-template-columns: 1fr; }
    .hpdp-advice__panel {
      min-height: auto;
      padding: 18px 20px;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 14px;
    }
    .hpdp-advice__icon { width: 40px; height: 40px; flex-shrink: 0; }
    .hpdp-advice__icon svg { width: 19px; height: 19px; }
    .hpdp-advice__panel-label { margin: 0; font-size: 11px; letter-spacing: 1.6px; }
    .hpdp-advice__content { padding: 24px 20px; row-gap: 18px; }
    .hpdp-advice__heading { margin-bottom: 9px; font-size: 20px; }
    .hpdp-advice__text { font-size: 14px; line-height: 1.55; }
    .hpdp-advice__button { width: 100%; min-height: 46px; font-size: 13px; }
  }
</style>

<div class="hpdp-advice">
  <div class="hpdp-advice__inner">
    <div class="hpdp-advice__panel">
      <div class="hpdp-advice__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/></svg>
      </div>
      <div class="hpdp-advice__panel-label">{{ section.settings.panel_label | escape }}</div>
    </div>
    <div class="hpdp-advice__content">
      <div>
        <p class="hpdp-advice__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="hpdp-advice__heading" data-hpdp-spy="{{ section.settings.heading | escape }}">{{ section.settings.heading | escape }}</h2>
        <p class="hpdp-advice__text">{{ section.settings.text | escape }}</p>
      </div>
      <a href="{{ section.settings.link | default: '/pages/contact' }}" class="hpdp-advice__button">
        {{ section.settings.button_label | escape }}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz PDP Advice",
  "settings": [
    { "type": "text", "id": "panel_label", "label": "Panel label", "default": "Complimentary Service" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personal Lighting Guidance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure Which Light Will Suit Your Space?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Share a photo, wall dimensions or details about your entrance, pathway or garden. Our team will help you compare suitable sizes, finishes and lighting styles." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Ask for Advice" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Heitz PDP Advice" }]
}
{% endschema %}
