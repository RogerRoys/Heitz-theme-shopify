{% assign block_settings = block.settings %}

<accordion-custom
  {% if block_settings.open_by_default %}
    open-by-default-on-desktop
    open-by-default-on-mobile
  {% endif %}
>
  <details
    class="details drawer-accordion-row"
    data-testid="accordion-details"
    style="--drawer-accordion-bg: {{ block_settings.drawer_background_color }};"
    {{ block.shopify_attributes }}
  >
    <summary class="details__header">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        svg_code: block_settings.svg_code,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="drawer-accordion-overlay" data-drawer-accordion-close></div>

    <div class="details-content drawer-accordion-panel">
      <div class="drawer-accordion-topbar">
        <strong class="drawer-accordion-title">{{ block_settings.heading }}</strong>
        <button type="button" class="drawer-accordion-close" aria-label="Close drawer" data-drawer-accordion-close>×</button>
      </div>

      {% content_for 'blocks' %}
    </div>
  </details>
</accordion-custom>

{% stylesheet %}
  .details__icon {
    height: auto;
    margin-inline-end: var(--margin-xs);
  }

  .drawer-accordion-row > summary {
    cursor: pointer;
  }

  .drawer-accordion-row > summary::marker,
  .drawer-accordion-row > summary::-webkit-details-marker {
    display: none;
  }

  .drawer-accordion-row[open] > summary {
    position: relative;
    z-index: auto !important;
  }

  .drawer-accordion-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483600 !important;
    background: rgba(0, 0, 0, 0.52);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    backdrop-filter: blur(0px);
    transition: opacity 320ms cubic-bezier(0.22, 1, 0.36, 1), visibility 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .drawer-accordion-row[open] .drawer-accordion-overlay {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .drawer-accordion-row.is-closing .drawer-accordion-overlay {
    opacity: 0;
  }

  .drawer-accordion-panel {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    bottom: auto !important;
    left: auto !important;
    z-index: 2147483601 !important;
    display: block !important;
    width: min(500px, 92vw) !important;
    max-width: 92vw !important;
    height: 100vh !important;
    max-height: 100vh !important;
    min-height: 100vh !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    padding: 0 20px 20px !important;
    margin: 0 !important;
    background: var(--drawer-accordion-bg, #ffffff) !important;
    background-color: var(--drawer-accordion-bg, #ffffff) !important;
    color: #121212 !important;
    box-shadow: -24px 0 70px rgba(0, 0, 0, 0.22);
    opacity: 1 !important;
    visibility: visible !important;
    clip-path: none !important;
    will-change: transform;
    transform: translate3d(100%, 0, 0) !important;
    transition: transform .6s cubic-bezier(0.22, 1, 0.36, 1) !important;
  }

  .drawer-accordion-row[open] .drawer-accordion-panel {
    transform: translate3d(0, 0, 0) !important;
  }

  .drawer-accordion-row.is-closing .drawer-accordion-panel {
    transform: translate3d(100%, 0, 0) !important;
  }

  .drawer-accordion-topbar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    margin-bottom: 12px;
    background: var(--drawer-accordion-bg, #ffffff) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .drawer-accordion-title {
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .drawer-accordion-close {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    color: inherit;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  body.drawer-accordion-is-open {
    overflow: hidden !important;
    touch-action: none;
  }

  body.drawer-accordion-is-open accordion-custom {
    position: relative;
    z-index: auto !important;
  }

  @media screen and (max-width: 749px) {
    .drawer-accordion-overlay {
      background: rgba(0, 0, 0, 0.72);
      backdrop-filter: blur(0px);
    }

    .drawer-accordion-panel {
      top: auto !important;
      right: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      height: 72dvh !important;
      max-height: 72dvh !important;
      min-height: 0 !important;
      border-radius: 18px 18px 0 0;
      transform: translate3d(0, 100%, 0) !important;
    }

    .drawer-accordion-row[open] .drawer-accordion-panel {
      transform: translate3d(0, 0, 0) !important;
    }

    .drawer-accordion-row.is-closing .drawer-accordion-panel {
      transform: translate3d(0, 100%, 0) !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const initDrawerAccordions = () => {
      document.querySelectorAll('.drawer-accordion-row').forEach((details) => {
        if (details.dataset.drawerAccordionReady === 'true') return;
        details.dataset.drawerAccordionReady = 'true';

        const summary = details.querySelector('summary');
        const closeButtons = details.querySelectorAll('[data-drawer-accordion-close]');
        let closeTimer;

        const openDrawer = () => {
          clearTimeout(closeTimer);
          details.classList.remove('is-closing');
          details.setAttribute('open', '');
          document.body.classList.add('drawer-accordion-is-open');
        };

        const closeDrawer = (event) => {
          if (event) event.preventDefault();
          if (!details.open || details.classList.contains('is-closing')) return;

          details.classList.add('is-closing');
          document.body.classList.remove('drawer-accordion-is-open');

          closeTimer = window.setTimeout(() => {
            details.removeAttribute('open');
            details.classList.remove('is-closing');
          }, 360);
        };

        summary?.addEventListener('click', (event) => {
          if (details.open) {
            closeDrawer(event);
          } else {
            event.preventDefault();
            openDrawer();
          }
        });

        details.addEventListener('toggle', () => {
          if (details.open) {
            details.classList.remove('is-closing');
            document.body.classList.add('drawer-accordion-is-open');
          }
        });

        closeButtons.forEach((button) => {
          button.addEventListener('click', closeDrawer);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && details.open) {
            closeDrawer(event);
          }
        });
      });
    };

    initDrawerAccordions();
    document.addEventListener('shopify:section:load', initDrawerAccordions);
  })();
</script>

