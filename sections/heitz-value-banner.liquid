{%- comment -%}
  Heitz Value Banner — full-width image banner with a soft dark overlay
  and centered eyebrow + heading + text + outline button. Used for the
  homepage Sustainability band.
{%- endcomment -%}
{% render 'heitz-tf-base' %}
<style>
  .hvb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.min_height | default: 480 }}px;
    padding: 70px 20px;
    overflow: hidden;
    text-align: center;
    font-family: var(--htf-font-body);
  }
  .hvb__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hvb__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hvb__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(16, 14, 11, {{ section.settings.overlay_opacity | default: 40 | divided_by: 100.0 }});
  }
  .hvb__content {
    position: relative;
    z-index: 1;
    max-width: 660px;
    margin: 0 auto;
  }
  .hvb__eyebrow {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.3em;
    line-height: 1.4;
    margin: 0 0 22px;
    text-transform: uppercase;
  }
  .hvb__title {
    font-family: var(--htf-font-heading);
    font-size: {{ section.settings.heading_size | default: 38 }}px;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 18px;
  }
  .hvb__text p {
    color: rgba(255, 255, 255, 0.88);
    font-size: {{ section.settings.text_size | default: 16 }}px;
    font-weight: 300;
    line-height: 1.75;
    margin: 0 0 14px;
  }
  .hvb__text p:last-child { margin-bottom: 0; }
  .hvb__btn {
    display: inline-block;
    margin-top: 30px;
    padding: 13px 34px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    color: #ffffff;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .3s ease, color .3s ease;
  }
  .hvb__btn:hover {
    background: #ffffff;
    color: #1a1b18;
  }
  /* style variants: the banner sits on a dark image, so the looks stay
     on-image (white) rather than scheme-driven */
  .hvb__btn--primary {
    background: #ffffff;
    border-color: #ffffff;
    color: #1a1b18;
  }
  .hvb__btn--primary:hover {
    background: var(--color-primary-button-hover-background, #9f6939);
    border-color: var(--color-primary-button-hover-background, #9f6939);
    color: #ffffff;
  }
  .hvb__btn--link {
    border-color: transparent;
    padding-inline: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hvb__btn--link:hover {
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
  }
  @media only screen and (max-width: 768px) {
    .hvb {
      min-height: {{ section.settings.min_height | default: 480 | times: 0.8 | round }}px;
      padding: 56px 17px;
    }
    .hvb__title { font-size: {{ section.settings.heading_size | default: 38 | minus: 12 }}px; }
    .hvb__eyebrow { margin-bottom: 16px; }
    .hvb__text p { font-size: {{ section.settings.text_size | default: 16 | minus: 1 }}px; }
    .hvb__btn { margin-top: 24px; }
  }
</style>

<section class="hvb">
  <div class="hvb__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: alt: section.settings.title, loading: 'lazy' }}
    {%- else -%}
      <div style="position:absolute; inset:0; background:#2a2723;"></div>
    {%- endif -%}
  </div>
  <div class="hvb__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hvb__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="hvb__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="hvb__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      {%- assign hvb_style = section.settings.button_style | default: 'secondary' -%}
      <a href="{{ section.settings.link | default: routes.root_url }}" class="hvb__btn{% unless hvb_style == 'secondary' %} hvb__btn--{{ hvb_style }}{% endunless %}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Heitz Value Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "range", "id": "min_height", "label": "Banner height", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 480 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sustainability" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Designed to last, chosen with care" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Good design should respect the environment it lives in.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary (outline)" }, { "value": "link", "label": "Link" } ], "default": "secondary" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Heitz Value Banner" }]
}
{% endschema %}
