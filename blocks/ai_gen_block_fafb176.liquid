    I wanna acreate Icon  with text section. its have add icon under heading and under body text.You should be able to add a maximum of 4 such blocks. The mobile app will show one block at a time. You should be able to move around the other blocks using the dots., I need to be able to add the required icon image here. In addition, I need to be able to kill the Janmaga thoroughly with block dots and by swiping. need all settuings dekstop and mobile separatly., Everything is fine. But the blocks on the mobile screen are not changing. Please fix it. I want to change the blocks on the mobile screen by dot and block swipe. dont cahnge anothr parts. They are very impornet for me.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .icon-text-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: {{ block.settings.background_color }};
     width: 100% !important;
  }

  .icon-text-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.desktop_alignment }};
    gap: {{ block.settings.desktop_gap }}px;
    margin-top: {{ block.settings.top_margin }}px;}

  .icon-text-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: calc({{ 100 | divided_by: block.settings.desktop_columns }}% - {{ block.settings.desktop_gap | times: 0.75 }}px);
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if block.settings.enable_item_hover %}
  .icon-text-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  {% endif %}

  .icon-text-icon-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_icon_size }}px;
    height: {{ block.settings.desktop_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_bottom_margin }}px;color: {{ block.settings.icon_color }};
  }

  .icon-text-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }
  
  .icon-text-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .icon-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_bottom_margin }}px 0;
    color: {{ block.settings.heading_color }};
  }

  .icon-text-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .icon-text-mobile-slider-{{ ai_gen_id }} {
    display: none;
  }

  .icon-text-dots-{{ ai_gen_id }} {
    display: none;justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .icon-text-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .icon-text-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .icon-text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px;
    }
    
    .icon-text-container-{{ ai_gen_id }} {
      display: none;
    }

    .icon-text-mobile-slider-{{ ai_gen_id }} {
      display: block;
      overflow: hidden;
      margin-top: {{ block.settings.top_margin_mobile }}px;
    }

    .icon-text-mobile-track-{{ ai_gen_id }} {
      display: flex;
      transition: transform 0.3s ease;
    }

    .icon-text-item-{{ ai_gen_id }} {
      width: 100%;
      min-width: 100%;
      flex-shrink: 0;padding: {{ block.settings.item_padding_mobile }}px;
    }
    
    .icon-text-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
      margin-bottom: {{ block.settings.icon_bottom_margin_mobile }}px;
    }
    
    .icon-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      margin: 0 0 {{ block.settings.heading_bottom_margin_mobile }}px 0;
    }
    
    .icon-text-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .icon-text-dots-{{ ai_gen_id }} {
      display: flex;
    }
  }
