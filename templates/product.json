              "blocks": {
                "text_93GtN3": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>We're always happy to help. Whether you're choosing the right piece for a space or have a question about an order, our support team is just a message away. Email us at <a href=\"mailto:support@heitz.shop\" target=\"_blank\">support@heitz.shop</a> and we'll get back to you within 12–24 hours.</p>",
