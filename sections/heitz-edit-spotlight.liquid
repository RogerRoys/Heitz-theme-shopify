{%- comment -%}
  Heitz Edit Spotlight — "Overlap" design (Roger's Claude Design option
  4d): a wide right-aligned lifestyle image with a white copy card
  breaking over its left edge, then a hairline four-column category
  link row with auto numerals and trailing arrows.
{%- endcomment -%}
{% render 'heitz-tf-base' %}
<style>
  .hesp {
    background: var(--color-background, #f5f3f0);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: var(--htf-font-body);
  }
  .hesp__col {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hesp__imgrow {
    position: relative;
    padding-left: 56px;
  }
  .hesp__img {
    width: 74%;
    margin-left: auto;
    aspect-ratio: 16 / 7.4;
    background: #d9d3ca;
    overflow: hidden;
  }
  .hesp__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hesp__card {
    position: absolute;
    left: 56px;
    top: 34px;
    width: 470px;
    max-width: calc(100% - 76px);
    background: #ffffff;
    padding: 34px 32px;
    box-shadow: 0 20px 44px rgba(30, 27, 24, 0.12);
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
  }
  .hesp__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8c8478;
  }
  .hesp__eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background: #8c8478;
    flex: 0 0 auto;
  }
  .hesp__title {
    margin: 0;
    font-family: var(--htf-font-heading);
    font-size: {{ section.settings.heading_size | default: 36 }}px;
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.024em;
    color: #1e1b18;
  }
  .hesp__text {
    margin: 0;
    font-size: {{ section.settings.text_size | default: 14.5 }}px;
    line-height: 1.75;
    color: #6b6459;
    text-wrap: pretty;
  }
  .hesp__cats {
    list-style: none;
    margin: 36px 0 0;
    padding: 0 56px;
    border-top: 1px solid #ddd7ce;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .hesp__cat {
    padding: 20px 18px 0;
    border-right: 1px solid #ddd7ce;
  }
  .hesp__cat:first-child { padding-left: 0; }
  .hesp__cat:last-child { padding-right: 0; border-right: 0; }
  .hesp__cat a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }
  .hesp__num {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #a89c8c;
  }
  .hesp__label {
    font-size: 16px;
    font-weight: 700;
    color: #1e1b18;
    transition: color 0.2s ease;
  }
  .hesp__cat a:hover .hesp__label { color: #8c8478; }
  @media screen and (max-width: 1023px) {
    .hesp__imgrow { padding-left: 0; }
    .hesp__img { width: 100%; }
    .hesp__card {
      position: static;
      width: 100%;
      max-width: none;
      box-shadow: none;
      margin-bottom: 22px;
      padding: 0 0 4px;
      background: transparent;
    }
    .hesp__cats {
      grid-template-columns: 1fr 1fr;
      padding: 0;
    }
    .hesp__cat:nth-child(2) { border-right: 0; padding-right: 0; }
    .hesp__cat:nth-child(3) { padding-left: 0; }
    .hesp__cat:nth-child(n+3) { border-top: 1px solid #ddd7ce; margin-top: 20px; }
  }
  @media screen and (max-width: 767px) {
    .hesp { padding: {{ section.settings.padding_top | default: 56 | at_most: 36 }}px 0 {{ section.settings.padding_bottom | default: 60 | at_most: 40 }}px; }
    .hesp__title { font-size: {{ section.settings.heading_size | default: 36 | minus: 8 }}px; }
    .hesp__cats { grid-template-columns: 1fr; border-top: 0; margin-top: 26px; }
    .hesp__cat {
      border-right: 0 !important;
      border-top: 0 !important;
      border-bottom: 1px solid #ddd7ce;
      margin-top: 0 !important;
      padding: 16px 0;
    }
    .hesp__cat a { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>

<div class="hesp color-{{ section.settings.color_scheme }}">
  <div class="hesp__col">
    <div class="hesp__imgrow">
      <div class="hesp__img">
        {%- if section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 1800 | image_tag: alt: section.settings.title, loading: 'lazy' }}
        {%- endif -%}
      </div>
      <div class="hesp__card">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hesp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="hesp__title">{{ section.settings.title }}</h2>
        <p class="hesp__text">{{ section.settings.text | strip_html }}</p>
      </div>
    </div>

    {%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
    {%- if link_blocks.size > 0 -%}
      <ul class="hesp__cats">
        {%- for block in link_blocks limit: 4 -%}
          {%- liquid
            assign col = collections[block.settings.collection]
            assign label = block.settings.label
            if label == blank
              assign label = col.title
            endif
          -%}
          <li class="hesp__cat" {{ block.shopify_attributes }}>
            <a href="{{ col.url | default: '#' }}">
              <span class="hesp__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="hesp__label">{{ label }} <span aria-hidden="true">&#8594;</span></span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Heitz Edit Spotlight",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 60 },
    { "type": "image_picker", "id": "image_1", "label": "Image (wide lifestyle shot)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Heitz Edit" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Light that belongs in every room" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sculptural pendants to refined outdoor fixtures — chosen to add warmth, calm and architectural character.</p>" },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 18, "step": 0.5, "unit": "px", "default": 14.5 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Category link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Leave empty to use the collection title" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Heitz Edit Spotlight",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
