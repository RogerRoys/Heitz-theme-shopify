{%- comment -%}
  Heitz PDP advice banner — "Three Steps" design (Roger's Claude Design
  option 1c): header row with eyebrow + heading and a dark arrow CTA
  over a hairline divider, then a three-step explanation grid.
  Step blocks are numbered automatically; without blocks the three
  default steps render.
{%- endcomment -%}
{% render 'heitz-pdp-base' %}
<style>
  .hpdp-advice {
    width: 100%;
    padding: {{ section.settings.padding_top | default: 80 }}px 20px {{ section.settings.padding_bottom | default: 80 }}px;
    font-family: var(--hpdp-font-body);
    background: var(--color-background, transparent);
  }
  .hpdp-advice__inner {
    max-width: 1180px;
    margin: 0 auto;
    background: var(--color-background, #f5f4f2);
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 52px 56px;
    display: flex;
    flex-direction: column;
    gap: 38px;
  }
  .hpdp-advice__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
    padding-bottom: 26px;
  }
  .hpdp-advice__intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hpdp-advice__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-foreground, #8a8a85);
    opacity: 0.75;
  }
  .hpdp-advice__heading {
    margin: 0;
    font-family: var(--hpdp-font-heading);
    font-size: {{ section.settings.heading_size | default: 30 }}px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--color-foreground-heading, #111111);
  }
  .hpdp-advice__button {
    flex: none;
    display: flex;
    align-items: center;
    gap: 11px;
    background: var(--color-foreground-heading, #111111);
    color: var(--color-background, #ffffff);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    padding: 16px 28px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .hpdp-advice__button:hover { background: var(--color-primary-button-hover-background, #9f6939); }
  .hpdp-advice__button--bottom { display: none; }
  .hpdp-advice__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px;
  }
  .hpdp-advice__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hpdp-advice__num {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-foreground, #b3b1ab);
    opacity: 0.5;
  }
  .hpdp-advice__step-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-foreground-heading, #111111);
  }
  .hpdp-advice__step-body {
    margin: 0;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--color-foreground, #5f5f5b);
  }
  @media screen and (max-width: 1023px) {
    .hpdp-advice__inner { padding: 40px 32px; }
    .hpdp-advice__steps { gap: 28px; }
    .hpdp-advice__heading { font-size: {{ section.settings.heading_size | default: 30 | minus: 4 }}px; }
  }
  @media screen and (max-width: 767px) {
    .hpdp-advice { padding: 20px 14px; }
    .hpdp-advice__inner { padding: 36px 20px; gap: 28px; }
    .hpdp-advice__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hpdp-advice__header .hpdp-advice__button { display: none; }
    .hpdp-advice__button--bottom {
      display: flex;
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
    .hpdp-advice__steps { grid-template-columns: 1fr; gap: 28px; }
    .hpdp-advice__heading { font-size: {{ section.settings.heading_size | default: 30 | minus: 6 }}px; }
  }
</style>

<div class="hpdp-advice color-{{ section.settings.color_scheme }}">
  <div class="hpdp-advice__inner color-{{ section.settings.box_color_scheme | default: 'scheme-2' }}">
    <div class="hpdp-advice__header">
      <div class="hpdp-advice__intro">
        <p class="hpdp-advice__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="hpdp-advice__heading" data-hpdp-spy="{{ section.settings.heading | strip_html | escape }}">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ section.settings.link | default: '/pages/contact' }}" class="hpdp-advice__button htf-bs-{{ section.settings.button_style | default: 'primary' }}">
        {{ section.settings.button_label | escape }} <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
    <div class="hpdp-advice__steps">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hpdp-advice__step" {{ block.shopify_attributes }}>
            <div class="hpdp-advice__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            <div class="hpdp-advice__step-title">{{ block.settings.title | escape }}</div>
            <p class="hpdp-advice__step-body">{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="hpdp-advice__step">
          <div class="hpdp-advice__num">01</div>
          <div class="hpdp-advice__step-title">Send us your space</div>
          <p class="hpdp-advice__step-body">A photo, wall dimensions or a short description of the room, entrance or garden.</p>
        </div>
        <div class="hpdp-advice__step">
          <div class="hpdp-advice__num">02</div>
          <div class="hpdp-advice__step-title">We compare options</div>
          <p class="hpdp-advice__step-body">Sizes, finishes and lighting styles put side by side for your space.</p>
        </div>
        <div class="hpdp-advice__step">
          <div class="hpdp-advice__num">03</div>
          <div class="hpdp-advice__step-title">You choose with confidence</div>
          <p class="hpdp-advice__step-body">A clear recommendation within one working day &mdash; no obligation to buy.</p>
        </div>
      {%- endif -%}
    </div>
    <a href="{{ section.settings.link | default: '/pages/contact' }}" class="hpdp-advice__button hpdp-advice__button--bottom htf-bs-{{ section.settings.button_style | default: 'primary' }}">
      {{ section.settings.button_label | escape }} <span aria-hidden="true">&#8594;</span>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Heitz PDP Advice",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "box_color_scheme", "label": "Box color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personal Lighting Guidance — Complimentary" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Not Sure Which Light Will Suit Your Space?" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 30 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Ask for Advice" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "link", "label": "Link" } ], "default": "primary" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Send us your space" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "A photo, wall dimensions or a short description of the room, entrance or garden." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Heitz PDP Advice",
      "blocks": [
        { "type": "step", "settings": { "title": "Send us your space", "body": "A photo, wall dimensions or a short description of the room, entrance or garden." } },
        { "type": "step", "settings": { "title": "We compare options", "body": "Sizes, finishes and lighting styles put side by side for your space." } },
        { "type": "step", "settings": { "title": "You choose with confidence", "body": "A clear recommendation within one working day — no obligation to buy." } }
      ]
    }
  ]
}
{% endschema %}
