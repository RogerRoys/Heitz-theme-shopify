{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant

  assign discount_percent = 0

  if selected_variant != blank and selected_variant.compare_at_price > selected_variant.price
    assign discount_amount = selected_variant.compare_at_price | minus: selected_variant.price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: selected_variant.compare_at_price | round
  endif

  assign show_discount_badge = false

  if block_settings.show_discount_badge and discount_percent > 0
    assign show_discount_badge = true
  endif

  if block_settings.discount_badge_product_page_only and request.page_type != 'product'
    assign show_discount_badge = false
  endif

  assign discount_badge_text = block_settings.discount_badge_text | default: 'DISCOUNT'
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
    --discount-badge-bg: {{ block_settings.discount_badge_background | default: '#e62b2b' }};
    --discount-badge-color: {{ block_settings.discount_badge_text_color | default: '#ffffff' }};
    --discount-badge-font-size: {{ block_settings.discount_badge_font_size | default: 13 }}px;
    --discount-badge-font-weight: {{ block_settings.discount_badge_font_weight | default: 600 }};
    --discount-badge-radius: {{ block_settings.discount_badge_radius | default: 50 }}px;
    --discount-badge-padding-y: {{ block_settings.discount_badge_padding_y | default: 6 }}px;
    --discount-badge-padding-x: {{ block_settings.discount_badge_padding_x | default: 18 }}px;
    --discount-badge-gap: {{ block_settings.discount_badge_gap | default: 12 }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if show_discount_badge %}
    <div class="custom-price-with-discount">
      {% render 'price',
        show_unit_price: true,
        product_resource: product_resource,
        show_sale_price_first: block_settings.show_sale_price_first
      %}

      <span
        class="custom-discount-badge"
        data-discount-badge
        aria-label="{{ discount_percent }} percent {{ discount_badge_text | escape }}"
      >
        {{ discount_percent }}% {{ discount_badge_text }}
      </span>
    </div>
  {% else %}
    {% render 'price',
      show_unit_price: true,
      product_resource: product_resource,
      show_sale_price_first: block_settings.show_sale_price_first
    %}
  {% endif %}

  {% if block_settings.show_tax_info %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        {{ 'content.duties_and_taxes_included' | t }}
      {%- elsif cart.taxes_included -%}
        {{ 'content.taxes_included' | t }}
      {%- elsif cart.duties_included -%}
        {{ 'content.duties_included' | t }}
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        {{ 'content.shipping_policy' | t }}
      {%- endif -%}
    </div>
  {% endif %}

  {%- if selected_variant != blank and block_settings.show_installments -%}
    <div class="installments">
      {%- assign product_form_installment_id = 'product-form-installment-' | append: block.id -%}
      {%- form 'product', product_resource, id: product_form_installment_id, class: 'payment-terms' -%}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
        >
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

{% # theme-check-disable %}
{% stylesheet %}
  .tax-note:empty {
    display: none;
  }

  form.payment-terms {
    padding-top: 0.5em;
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .installments:not(:has(shopify-payment-terms)) {
    display: none;
  }

  /* Volume pricing note should match unit-price styling (small, grey text) */
  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  /* Custom price + discount badge */
  product-price .custom-price-with-discount {
    display: flex;
    align-items: center;
    gap: var(--discount-badge-gap, 12px);
    flex-wrap: wrap;
  }

  product-price .custom-price-with-discount .price,
  product-price .custom-price-with-discount .price__container,
  product-price .custom-price-with-discount .price__regular,
  product-price .custom-price-with-discount .price__sale {
    display: inline-flex;
    align-items: center;
    gap: var(--discount-badge-gap, 12px);
    flex-wrap: wrap;
  }

  product-price .custom-discount-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: var(--discount-badge-padding-y, 6px) var(--discount-badge-padding-x, 18px);
    border-radius: var(--discount-badge-radius, 50px);
    background: var(--discount-badge-bg, #e62b2b);
    color: var(--discount-badge-color, #ffffff);
    font-family: var(--font-body--family);
    font-size: var(--discount-badge-font-size, 13px);
    font-weight: var(--discount-badge-font-weight, 600);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  /* Safety net: do not show this badge inside product cards/grids */
  .product-card product-price .custom-discount-badge,
  .product-card-wrapper product-price .custom-discount-badge,
  .card-wrapper product-price .custom-discount-badge,
  .card-information product-price .custom-discount-badge,
  .product-grid product-price .custom-discount-badge,
  .collection product-price .custom-discount-badge,
  product-card product-price .custom-discount-badge {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    product-price .custom-price-with-discount {
      gap: 8px;
    }

    product-price .custom-discount-badge {
      min-height: 26px;
    }
  }
{% endstylesheet %}

