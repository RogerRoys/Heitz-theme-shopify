{%- comment -%}
  Heitz About Hero — centered editorial statement above a full-width
  image banner.
{%- endcomment -%}
{% render 'heitz-tf-base' %}

<style>
  .habh { overflow: hidden; font-family: var(--font-body--family, var(--htf-font-body)); }
  .habh * { box-sizing: border-box; }
  .habh__frame {
    background: var(--color-background, #fbf7f1);
    border-bottom: 1px solid var(--color-border, #ddd5c4);
  }
  .habh__text {
    margin: 0 auto;
    max-width: 760px;
    padding: {{ section.settings.padding_top | default: 80 }}px 0 44px;
    text-align: center;
  }
  .habh__eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--color-primary, #b8913f);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .habh h1 {
    margin: 0 0 18px;
    color: var(--color-foreground-heading, var(--htf-color-text));
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.12;
  }
  .habh h1 em { color: var(--color-primary, #b8913f); font-style: italic; font-weight: 400; }
  .habh p {
    margin: 0 auto;
    max-width: 520px;
    color: var(--color-foreground, #7a6e5e);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
  }
  .habh__image {
    display: block;
    width: 100%;
    height: {{ section.settings.image_height | default: 460 }}px;
    background-color: var(--color-background, #fbf7f1);
    background-image: linear-gradient(135deg, #e8e2d5, #d5ccba);
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
  }
  .habh__spacer { height: {{ section.settings.padding_bottom | default: 80 | times: 0.5 | round }}px; }
  @media only screen and (min-width: 769px) {
    .habh .habh__frame { padding-left: 0; padding-right: 0; }
    .habh__text { padding-left: 40px; padding-right: 40px; }
  }
  @media only screen and (max-width: 768px) {
    .habh__text { padding: {{ section.settings.padding_top | default: 80 }}px 0 36px; }
    .habh__image {
      height: auto;
      aspect-ratio: {{ section.settings.mobile_ratio | default: '4 / 3' }};
    }
  }
</style>

<section class="habh">
  <div class="htf-page-width habh__frame color-{{ section.settings.color_scheme }}">
    <div class="habh__text">
      <span class="habh__eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
    </div>
    <div
      class="habh__image"
      role="img"
      aria-label="{{ section.settings.image_alt | default: 'Heitz lighting in a calm modern home' | escape }}"
      {% if section.settings.image != blank %}
        style="background-image: url({{ section.settings.image | image_url: width: 2000 }});"
      {% endif %}
    ></div>
    <div class="habh__spacer" aria-hidden="true"></div>
  </div>
</section>

{% schema %}
{
  "name": "Heitz About Hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-heitz-cream" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "select", "id": "image_position", "label": "Image position (unused in banner layout)", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ], "default": "right" },
    { "type": "range", "id": "image_height", "label": "Image height (desktop)", "min": 350, "max": 800, "step": 10, "unit": "px", "default": 460 },
    { "type": "select", "id": "mobile_ratio", "label": "Image ratio (mobile)", "options": [ { "value": "4 / 3", "label": "Landscape (4:3)" }, { "value": "1 / 1", "label": "Square" }, { "value": "16 / 9", "label": "Wide (16:9)" } ], "default": "4 / 3" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Heitz" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Lighting should shape how a home <em>feels.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We started with a simple idea — lighting should do more than just illuminate a space. It should shape how you feel within it." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" }
  ],
  "presets": [{ "name": "Heitz About Hero" }]
}
{% endschema %}
