{%- comment -%}
  Heitz Edit Spotlight — Roger's Claude Design option 8a ("7b + intro"):
  two full-bleed image crops flanking a slim centered column with
  eyebrow, light heading, intro, hairline divider, stacked category
  links and an EXPLORE ALL outline button. Crop height and column
  width settings cover the 8b/8c variants.
{%- endcomment -%}
{% render 'heitz-tf-base' %}
<style>
  .hesp {
    background: var(--color-background, #ffffff);
    padding: {{ section.settings.padding_top | default: 0 }}px 0 {{ section.settings.padding_bottom | default: 0 }}px;
    font-family: var(--htf-font-body);
  }
  .hesp__grid {
    display: grid;
    grid-template-columns: 1fr {{ section.settings.column_width | default: 300 }}px 1fr;
    align-items: stretch;
  }
  .hesp__img {
    min-height: {{ section.settings.crop_height | default: 520 }}px;
    background: #d9d3ca;
    overflow: hidden;
    position: relative;
  }
  .hesp__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hesp__column {
    padding: 56px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    text-align: center;
  }
  .hesp__eyebrow {
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8c8478;
  }
  .hesp__title {
    margin: 0;
    font-family: var(--htf-font-heading);
    font-size: {{ section.settings.heading_size | default: 27 }}px;
    font-weight: 300;
    line-height: 1.28;
    letter-spacing: -0.018em;
    color: #1e1b18;
  }
  .hesp__text {
    margin: 0;
    font-size: {{ section.settings.text_size | default: 13.5 }}px;
    line-height: 1.75;
    color: #6b6459;
    text-wrap: pretty;
  }
  .hesp__divider {
    width: 28px;
    height: 1px;
    background: #cdc5b9;
  }
  .hesp__links {
    display: flex;
    flex-direction: column;
    gap: 13px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hesp__links a {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1e1b18;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hesp__links a:hover { color: #8c8478; }
  .hesp__btn {
    margin-top: 4px;
    display: inline-block;
    border: 1px solid #cdc5b9;
    color: #1e1b18;
    text-decoration: none;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 13px 20px;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .hesp__btn:hover {
    background: #1e1b18;
    color: #ffffff;
    border-color: #1e1b18;
  }
  @media screen and (max-width: 1023px) {
    .hesp__grid { grid-template-columns: 1fr {{ section.settings.column_width | default: 300 | at_most: 280 }}px 1fr; }
    .hesp__img { min-height: {{ section.settings.crop_height | default: 520 | at_most: 440 }}px; }
  }
  @media screen and (max-width: 767px) {
    .hesp__grid { grid-template-columns: 1fr; }
    .hesp__img { min-height: 280px; }
    .hesp__column { padding: 44px 24px; }
    .hesp__title { font-size: {{ section.settings.heading_size | default: 27 | minus: 3 }}px; }
  }
</style>

<div class="hesp color-{{ section.settings.color_scheme }}">
  <div class="hesp__grid">
    <div class="hesp__img">
      {%- if section.settings.image_1 != blank -%}
        {{ section.settings.image_1 | image_url: width: 1200 | image_tag: alt: section.settings.title, loading: 'lazy' }}
      {%- endif -%}
    </div>
    <div class="hesp__column">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hesp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="hesp__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hesp__text">{{ section.settings.text | strip_html }}</p>
      {%- endif -%}
      <div class="hesp__divider" aria-hidden="true"></div>
      {%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
      {%- if link_blocks.size > 0 -%}
        <ul class="hesp__links">
          {%- for block in link_blocks -%}
            {%- liquid
              assign col = collections[block.settings.collection]
              assign label = block.settings.label
              if label == blank
                assign label = col.title
              endif
            -%}
            <li {{ block.shopify_attributes }}><a href="{{ col.url | default: '#' }}">{{ label }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_1_label != blank -%}
        <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="hesp__btn">{{ section.settings.button_1_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="hesp__img">
      {%- if section.settings.image_2 != blank -%}
        {{ section.settings.image_2 | image_url: width: 1200 | image_tag: alt: section.settings.title, loading: 'lazy' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz Edit Spotlight",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "crop_height", "label": "Image crop height", "min": 380, "max": 680, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "column_width", "label": "Centre column width", "min": 240, "max": 420, "step": 20, "unit": "px", "default": 300 },
    { "type": "image_picker", "id": "image_1", "label": "Left image" },
    { "type": "image_picker", "id": "image_2", "label": "Right image" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Heitz Edit" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Light that belongs in every room" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Sculptural pendants to refined outdoor fixtures, chosen for warmth and character.</p>" },
    { "type": "text", "id": "button_1_label", "label": "Button label", "default": "Explore All" },
    { "type": "url", "id": "button_1_link", "label": "Button link" },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 27 },
    { "type": "range", "id": "text_size", "label": "Intro size", "min": 11, "max": 18, "step": 0.5, "unit": "px", "default": 13.5 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Category link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Leave empty to use the collection title" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Heitz Edit Spotlight",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
