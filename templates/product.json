        "info_returns": {
          "type": "info_item",
          "settings": {
            "icon": "box",
            "title": "Returns and Refunds",
            "content": "<p>We accept eligible returns within <strong>30 days of delivery</strong>. Items must be unused, in their original condition, and include all original packaging and accessories.</p><p>For change-of-mind returns, return shipping costs and a 40% restocking fee are the customer's responsibility. If your item arrives faulty, damaged, or incorrect, we cover return shipping with no restocking fee — you'll receive a replacement or a full refund.</p><p>Please contact our team at support@heitz.shop before returning any item so we can provide return instructions. Refunds are processed within 14 days of receiving the return, and every light is backed by our <strong>1-year warranty</strong>.</p>"
          }
        },
        "info_shipping": {
          "type": "info_item",
          "settings": {
            "icon": "truck",
            "title": "Shipping and Delivery",
            "content": "<p><strong>Free tracked shipping</strong> on all orders — delivery costs are already included in the price.</p><p>Orders are processed within <strong>1–3 business days</strong> (Monday to Friday, excluding public holidays).</p><p>Estimated delivery: <strong>USA 8–15</strong>, <strong>UK 5–10</strong>, <strong>Australia 8–15</strong> business days. You'll receive tracking details by email once your order has been dispatched.</p>"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What's included with my light fixture?",
            "answer": "Each fixture includes the light itself, mounting hardware, and installation instructions. Whether bulbs are included is listed on each product page — many of our designs use integrated LED, so no bulb is required."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Are your outdoor lights weatherproof?",
            "answer": "Yes, but the level of weather protection varies by product. Look for IP44 minimum for sheltered positions, and IP65 or higher for fixtures fully exposed to rain and direct weather. The IP rating is listed on every outdoor product page."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How are wall and ceiling lights installed?",
            "answer": "Most fixtures hardwire into a standard junction box and come with a backplate or canopy that covers the box. We recommend a licensed electrician for all hardwired installations, particularly where new cabling is required."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Are your lights dimmable?",
            "answer": "Some models are dimmable, some are not — this is listed on each product page. Dimmable fixtures require a compatible dimmer switch. Many designs can also be wired to a timer or smart switch for automated control."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "What finish should I choose for my space?",
            "answer": "Match the finish to your existing hardware and fittings for a cohesive look. Matte black suits contemporary and industrial styles, brushed nickel works with modern coastal looks, and brass or bronze suits classic and traditional homes."
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "How do I choose the right size fixture?",
            "answer": "A wall fixture beside a door should sit at eye level — roughly 1.6–1.8m from the ground to the centre of the fixture. For pendants, allow at least 75–90cm of clearance above tables and benchtops. Full dimensions are listed on every product page."
          }
        }
      },
