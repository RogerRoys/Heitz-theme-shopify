              ]
            },
            "accordion_row_pxLTc3": {
              "type": "_accordion-row",
              "name": "t:names.accordion_dash_row",
              "settings": {
                "heading": "6. What’s your return policy?",
                "behavior": "drawer",
                "open_by_default": false,
                "drawer_background_color": "#ffffff",
                "icon": "none",
                "svg_code": "",
                "width": 20
              },
              "blocks": {
                "text_nCTyKp": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>We offer a <strong>30-day return policy</strong>. If you’re not completely satisfied with your order, you can contact us within 30 days of receiving your item, and we’ll guide you through the return process.</p><p>To be eligible for a return, the item should be unused, in its original condition, and returned with its original packaging where possible. For full details, see our <a href=\"/policies/refund-policy\" target=\"_blank\" title=\"Refund Policy\"><strong>return policy page.</strong></a></p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
