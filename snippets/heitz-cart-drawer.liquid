{%- comment -%}
  Heitz cart drawer restyle — Marven-reference look on Horizon's cart
  drawer machinery: 450px right panel, uppercase spaced CART heading
  over a hairline, 70px media rows with muted option lines and a
  compact bordered quantity box, subtotal row and a stacked
  checkout / view-cart pair, with the reference's staggered
  header→items→footer reveal on open. Colors ride the drawer's color
  scheme; type is the house system (heading font labels, Jost body,
  12/500/2.4 buttons).
{%- endcomment -%}

{% stylesheet %}
  /* ── panel ─────────────────────────────────────── */
  .cart-drawer__dialog {
    width: 450px;
    max-width: calc(100vw - 4rem);
    border-radius: 0;
  }
  .cart-drawer__dialog::backdrop { cursor: zoom-out; }

  /* ── header: CART over a hairline ─────────────── */
  .cart-drawer__header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border, #d2d5d9);
  }
  .cart-drawer__heading {
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #1a1b18);
  }

  /* ── item rows ─────────────────────────────────── */
  .cart-drawer__items .cart-items__media-container,
  .cart-drawer__items .cart-items__media-image {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 0;
  }
  .cart-drawer__items .cart-items__title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
  }
  .cart-drawer__items .cart-items__details {
    font-size: 13px;
  }
  .cart-drawer__items .cart-items__details .variant-option,
  .cart-drawer__items .cart-items__option {
    font-size: 13px;
    color: var(--color-foreground, #212326);
    opacity: 0.55;
  }
  .cart-drawer__items .cart-items__price,
  .cart-drawer__items .cart-price {
    font-family: var(--font-body--family);
    font-size: 14px;
  }
  /* compact bordered quantity control, reference proportions */
  .cart-drawer__items quantity-selector-component,
  .cart-drawer__items .quantity-selector {
    border: 1px solid rgba(210, 213, 217, 0.6);
    border-radius: 0;
    min-height: 28px;
    height: 28px;
  }
  .cart-drawer__items .quantity-selector__input {
    font-size: 13px;
    min-width: 34px;
  }
  .cart-drawer__items .quantity-selector__button {
    min-width: 26px;
    min-height: 26px;
  }

  /* ── footer / summary ──────────────────────────── */
  .cart-drawer__summary {
    padding: 14px 20px 20px;
    border-top: 1px solid var(--color-border, #d2d5d9);
  }
  .cart-drawer__summary .cart__original-total-label,
  .cart-drawer__summary .cart__total-label {
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 500;
  }
  .cart-drawer__summary .cart__summary-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cart-drawer__summary .cart__checkout-button {
    border-radius: 0;
    min-height: 46px;
  }
  .hcd-viewcart {
    display: block;
    margin-top: 10px;
    height: 44px;
    line-height: 42px;
    text-align: center;
    border: 1px solid var(--color-border, #d2d5d9);
    background: transparent;
    color: var(--color-foreground, #1a1b18);
    font-family: var(--button-font-family-primary, var(--font-body--family));
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out),
      color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out),
      border-color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out);
  }
  @media (hover: hover) {
    .hcd-viewcart:hover {
      background: var(--color-secondary-button-hover-background, #1a1b18);
      color: var(--color-secondary-button-hover-text, #ffffff);
      border-color: var(--color-secondary-button-hover-border, #1a1b18);
    }
  }

  /* ── reference stagger: header → items → footer ── */
  @keyframes hcd-in {
    from { opacity: 0; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .cart-drawer__dialog[open] .cart-drawer__header {
    animation: hcd-in 0.4s ease both 0.12s;
  }
  .cart-drawer__dialog[open] .cart-drawer__items {
    animation: hcd-in 0.45s ease both 0.18s;
  }
  .cart-drawer__dialog[open] .cart-drawer__summary {
    animation: hcd-in 0.5s ease both 0.24s;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__dialog[open] .cart-drawer__header,
    .cart-drawer__dialog[open] .cart-drawer__items,
    .cart-drawer__dialog[open] .cart-drawer__summary {
      animation: none;
    }
  }
{% endstylesheet %}
