{{ 'heitz-hr.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heitz-hr.js' | asset_url }}" defer></script>
{%- assign menu = section.settings.menu.links | default: linklists['main-menu'].links -%}
{%- assign hl = section.settings.highlight | strip -%}
{%- assign has_mega = false -%}
{%- for link in menu -%}{%- if link.links.size > 0 -%}{%- assign has_mega = true -%}{%- endif -%}{%- endfor -%}
{%- capture logo -%}
  {%- if section.settings.logo != blank -%}
    {{ section.settings.logo | image_url: width: 500 | image_tag: alt: shop.name, class: 'hr-logo__img', widths: '200,300,400,500' }}
  {%- else -%}<span class="hr-logo__txt">{{ shop.name }}</span>{%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ section.id }} { position: {% if section.settings.sticky %}sticky{% else %}relative{% endif %}; top: 0; z-index: 60; }
  #shopify-section-{{ section.id }} .hr-logo__img { height: {{ section.settings.logo_h }}px; }
  @media (max-width: 989px) { #shopify-section-{{ section.id }} .hr-logo__img { height: {{ section.settings.logo_h_m }}px; } }
</style>
<script>
  window.HeitzHR = Object.assign(window.HeitzHR || {}, {
    moneyFormat: {{ shop.money_format | json }},
    freeShip: {{ section.settings.free_ship | default: 0 | times: 100 }},
    freeShipLabel: {{ section.settings.free_ship_label | json }},
    takeOver: {{ section.settings.take_over_atc | json }},
    searchUrl: {{ routes.search_url | json }},
    root: {{ routes.root_url | json }},
    upsell: [
      {%- for p in section.settings.upsell_collection.products limit: 8 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        { "id": {{ p.id }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }}, "price": {{ v.price | json }}, "img": {{ p.featured_image | image_url: width: 240 | json }}, "url": {{ p.url | json }}, "variant": {{ v.id | json }}, "available": {{ v.available | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  });
</script>

<div class="hr-hdr" data-hr-header {{ section.shopify_attributes }}>
  {%- comment -%} ===== Desktop (3b Search-first) ===== {%- endcomment -%}
  <div class="hr-hdr__d">
    <div class="hr-hdr__top">
      <a href="{{ routes.root_url }}" class="hr-logo" aria-label="{{ shop.name }}">{{ logo }}</a>
      <button type="button" class="hr-hdr__search" data-hr-open="HrSearch">
        {% render 'heitz-hr-icon', icon: 'search', size: 20 %}<span>{{ section.settings.search_placeholder }}</span>
      </button>
      <div class="hr-hdr__tools">
        {%- if section.settings.show_currency -%}{% render 'heitz-hr-currency', form_id: 'HrCurD', countries: section.settings.countries %}{%- endif -%}
        <a class="hr-tool" href="{{ routes.account_url }}">{% render 'heitz-hr-icon', icon: 'account' %}<span>Account</span></a>
        <button type="button" class="hr-tool" data-hr-open="HrWish" data-hr-toggle>{% render 'heitz-hr-icon', icon: 'heart' %}<span>Wishlist (<span data-hr-wish-count>0</span>)</span></button>
        <a class="hr-tool" href="{{ routes.cart_url }}" data-hr-open="HrCart">{% render 'heitz-hr-icon', icon: 'bag' %}<span>Cart (<span data-hr-cart-count>{{ cart.item_count }}</span>)</span></a>
      </div>
    </div>
    <div class="hr-hdr__row">
      <nav aria-label="Main">
        <ul class="hr-nav">
          {%- for link in menu -%}
            <li><a href="{{ link.url }}" class="hr-nav__a{% if link.title == hl %} is-hl{% endif %}{% if link.active or link.child_active %} is-cur{% endif %}"{% if link.links.size > 0 %} data-hr-mega aria-haspopup="true"{% endif %}>{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
      <div class="hr-hdr__note">
        {%- if section.settings.track_url != blank -%}<a class="hr-link" href="{{ section.settings.track_url }}">Track order</a>{%- endif -%}
        {%- if section.settings.note != blank -%}<span>{{ section.settings.note }}</span>{%- endif -%}
      </div>
    </div>

    {%- comment -%} ===== 7a Mega menu – columns + cards ===== {%- endcomment -%}
    {%- if has_mega -%}
      <div class="hr-mega" data-hr-mega-panel>
        <div class="hr-mega__in">
          {%- for link in menu -%}
            {%- if link.links.size > 0 -%}
              <div class="hr-mega__col">
                <a class="hr-mega__h" href="{{ link.url }}">{{ link.title }}</a>
                {%- for c in link.links -%}<a class="hr-mega__l" href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
          <div class="hr-mega__cards">
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega_card' -%}
                <a class="hr-mega__card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                  <span class="hr-zoom">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- endif -%}</span>
                  <span class="hr-mega__ct">{{ block.settings.title }}</span>
                  <span class="hr-mega__cl">Shop now</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ===== Mobile (3b) ===== {%- endcomment -%}
  <div class="hr-hdr__m">
    <div class="hr-hdr__mtop">
      <button type="button" class="hr-ibtn" data-hr-open="HrMenu" aria-label="Menu">{% render 'heitz-hr-icon', icon: 'menu' %}</button>
      <a href="{{ routes.root_url }}" class="hr-logo" aria-label="{{ shop.name }}">{{ logo }}</a>
      <div class="hr-hdr__mtools">
        {%- if section.settings.show_currency -%}{% render 'heitz-hr-currency', form_id: 'HrCurM', compact: true, countries: section.settings.countries %}{%- endif -%}
        <a class="hr-ibtn" href="{{ routes.cart_url }}" data-hr-open="HrCart" aria-label="Cart">{% render 'heitz-hr-icon', icon: 'bag', size: 21 %}<span class="hr-badge" data-hr-cart-count>{{ cart.item_count }}</span></a>
      </div>
    </div>
    <div class="hr-hdr__msearch">
      <button type="button" class="hr-hdr__msearch-btn" data-hr-open="HrSearch">{% render 'heitz-hr-icon', icon: 'search', size: 18 %}<span>{{ section.settings.search_placeholder_m }}</span></button>
      <button type="button" class="hr-hdr__mwish" data-hr-open="HrWish" data-hr-toggle aria-label="Wishlist">{% render 'heitz-hr-icon', icon: 'heart', size: 20 %}</button>
    </div>
  </div>
</div>

{%- comment -%} ===== 7a Mobile menu drawer ===== {%- endcomment -%}
<div class="hr-ov hr-menu" id="HrMenu" hidden>
  <div class="hr-ov__dim" data-hr-close></div>
  <nav class="hr-menu__panel" data-hr-panel aria-label="Menu">
    <div class="hr-menu__head"><a href="{{ routes.root_url }}" class="hr-logo">{{ logo }}</a><button type="button" class="hr-x" data-hr-close aria-label="Close">×</button></div>
    <div class="hr-menu__body">
      {%- for link in menu -%}
        {%- if link.links.size > 0 -%}
          <div class="hr-acc{% if forloop.first %} is-open{% endif %}">
            <button type="button" class="hr-acc__btn{% if link.title == hl %} is-hl{% endif %}" data-hr-acc aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">{{ link.title }}<span class="hr-acc__sign"></span></button>
            <div class="hr-acc__panel"><div><div class="hr-acc__grid">
              {%- for c in link.links -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
            </div></div></div>
          </div>
        {%- else -%}
          <div class="hr-acc"><a class="hr-acc__btn{% if link.title == hl %} is-hl{% endif %}" href="{{ link.url }}">{{ link.title }}</a></div>
        {%- endif -%}
      {%- endfor -%}
      <div class="hr-menu__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_card' -%}
            <a class="hr-menu__card" href="{{ block.settings.link }}"><span class="hr-zoom">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- endif -%}</span><span>{{ block.settings.title }}</span></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="hr-menu__foot"><a class="hr-link" href="{{ routes.account_url }}">Account</a></div>
  </nav>
</div>

{%- comment -%} ===== 5c Full-screen search ===== {%- endcomment -%}
<div class="hr-ov hr-search" id="HrSearch" hidden>
  <div class="hr-search__panel" data-hr-panel>
    <div class="hr-search__bar"><a href="{{ routes.root_url }}" class="hr-logo">{{ logo }}</a><button type="button" class="hr-round" data-hr-close aria-label="Close search">×</button></div>
    <form class="hr-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <span class="hr-eyebrow">What are you looking for?</span>
      <div class="hr-search__field">
        <input type="search" name="q" placeholder="Search lighting…" autocomplete="off" data-hr-q data-autofocus aria-label="Search">
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="Search">{% render 'heitz-hr-icon', icon: 'search', size: 26 %}</button>
      </div>
      <div class="hr-chips">
        {%- assign sugg = section.settings.suggestions | split: ',' -%}
        {%- for s in sugg -%}<button type="button" class="hr-chip" data-hr-sugg="{{ s | strip | escape }}">{{ s | strip }}</button>{%- endfor -%}
      </div>
    </form>
    <div class="hr-search__tiles" data-hr-tiles>
      {%- for block in section.blocks -%}
        {%- if block.type == 'search_tile' and block.settings.collection != blank -%}
          {%- assign col = block.settings.collection -%}
          <a class="hr-search__tile" href="{{ col.url }}" {{ block.shopify_attributes }}>
            <span class="hr-zoom">{%- assign im = block.settings.image | default: col.featured_image -%}{%- if im -%}{{ im | image_url: width: 700 | image_tag: loading: 'lazy', alt: col.title }}{%- endif -%}</span>
            <span class="hr-search__tt">{{ block.settings.title | default: col.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="hr-search__res" data-hr-res hidden></div>
  </div>
</div>

{%- comment -%} ===== 8c Wishlist popover ===== {%- endcomment -%}
<div class="hr-ov hr-wish" id="HrWish" hidden data-lock="mobile">
  <div class="hr-ov__dim" data-hr-close></div>
  <div class="hr-wish__panel" data-hr-panel role="dialog" aria-label="Wishlist">
    <span class="hr-wish__arrow"></span><span class="hr-grab"></span>
    <div class="hr-wish__head"><span class="hr-h">Saved for later (<span data-hr-wish-count>0</span>)</span><span class="hr-wish__ok" data-hr-wish-ok>✓ Added</span></div>
    <div class="hr-wish__list" data-hr-wish-list></div>
    <div class="hr-wish__foot" data-hr-wish-foot>
      {%- if section.settings.wishlist_url != blank -%}<a class="hr-btn hr-btn--line" href="{{ section.settings.wishlist_url }}">View wishlist</a>{%- endif -%}
      <button type="button" class="hr-btn hr-btn--ink" data-hr-wish-all>Add all to cart</button>
    </div>
  </div>
</div>

{% render 'heitz-hr-cart-drawer' %}

{% schema %}
{
  "name": "Heitz header (3b)",
  "class": "hr-hdr-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_h", "label": "Logo height – desktop", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "logo_h_m", "label": "Logo height – mobile", "min": 20, "max": 44, "step": 1, "unit": "px", "default": 30 },
    { "type": "header", "content": "Menu" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Links with sub-links open the mega menu (desktop) and the accordion (mobile)." },
    { "type": "text", "id": "highlight", "label": "Highlight this link (bronze)", "default": "Marked in Gold" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "url", "id": "track_url", "label": "Track order link" },
    { "type": "text", "id": "note", "label": "Right-side note", "default": "Free tracked shipping" },
    { "type": "header", "content": "Country / currency" },
    { "type": "checkbox", "id": "show_currency", "label": "Show country / currency picker", "default": true, "info": "Needs more than one market in Settings → Markets." },
    { "type": "text", "id": "countries", "label": "Countries to list", "default": "US,GB,AU", "info": "ISO codes, comma separated. Leave blank to list all." },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "search_placeholder", "label": "Search bar text – desktop", "default": "Search pendants, table lamps, outdoor…" },
    { "type": "text", "id": "search_placeholder_m", "label": "Search bar text – mobile", "default": "Search lighting…" },
    { "type": "text", "id": "suggestions", "label": "Search suggestions", "default": "Pendant lights, Table lamps, Floor lamps, Outdoor, Solar" },
    { "type": "header", "content": "Wishlist" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page link (optional)" },
    { "type": "header", "content": "Cart drawer" },
    { "type": "number", "id": "free_ship", "label": "Free shipping from (store currency)", "default": 0, "info": "0 = every order ships free." },
    { "type": "text", "id": "free_ship_label", "label": "Free shipping message", "default": "Free tracked shipping unlocked" },
    { "type": "collection", "id": "upsell_collection", "label": "\"Pairs well with\" fallback collection", "info": "Used when Shopify has no product recommendations yet." },
    { "type": "checkbox", "id": "take_over_atc", "label": "Open this cart drawer on every Add to cart", "default": true }
  ],
  "blocks": [
    {
      "type": "mega_card",
      "name": "Menu image card",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pendant Lights" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "search_tile",
      "name": "Search collection tile",
      "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title (optional)" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
