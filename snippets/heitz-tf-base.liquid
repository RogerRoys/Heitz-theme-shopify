{%- comment -%}
  Heitz TF base — fonts + design tokens shared by all heitz-* sections.
  Rendered once by heitz-header (present on every page via header-group).
  Palette/typography ported from the Impulse-based reference design.
{%- endcomment -%}
<style>
  :root {
    --htf-font-heading: var(--font-heading--family, 'Cabin', sans-serif);
    --htf-font-body: var(--font-body--family, 'Jost', sans-serif);
    --htf-color-text: #2a3743;
    --htf-color-body: #f9f9f9;
    --htf-color-border: #e0dfdf;
    --htf-color-border-light: #e8e8e8;
    --htf-color-btn: #2a3743;
    --htf-color-btn-light: #3e5162;
    --htf-color-btn-text: #ffffff;
    --htf-color-footer: #2a3743;
    --htf-color-footer-text: #ffffff;
    --htf-color-announcement: #2a3743;
    --htf-color-announcement-text: #ffffff;
    --htf-color-beige: #f5f3ee;
    --htf-type-base: 17px;
    --htf-uppercase-spacing: 0.2em;
  }
  body {
    background-color: var(--htf-color-body);
  }
  .htf-btn {
    -webkit-appearance: none;
    appearance: none;
    background: var(--color-primary-button-background, var(--htf-color-btn));
    border: 1px solid transparent;
    border-radius: 0;
    color: var(--color-primary-button-text, var(--htf-color-btn-text));
    cursor: pointer;
    display: inline-block;
    font-family: var(--htf-font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: var(--htf-uppercase-spacing);
    line-height: 1.42;
    padding: 11px 20px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    vertical-align: middle;
    white-space: normal;
    transition: background .2s ease 0s;
  }
  .htf-btn:hover { background: var(--color-primary-button-hover-background, var(--htf-color-btn-light)); color: var(--color-primary-button-hover-text, var(--htf-color-btn-text)); }
  .htf-btn--secondary {
    background-color: transparent;
    border: 1px solid var(--htf-color-border);
    color: var(--htf-color-text);
  }
  .htf-btn--secondary:hover {
    background-color: var(--color-secondary-button-hover-background, #1a1b18);
    color: var(--color-secondary-button-hover-text, #ffffff);
    border-color: var(--color-secondary-button-hover-border, #1a1b18);
  }
  .htf-btn--small {
    font-size: 12px;
    min-width: 90px;
    padding: 8px 14px;
  }
  .htf-btn--inverse {
    background-color: transparent;
    border: 2px solid #fff;
    color: #fff;
  }
  .htf-btn--inverse:hover { background-color: rgba(255,255,255,0.12); color: #fff; }
  /* Button style variants (Primary / Secondary / Link) selectable per
     section; colors come from the surrounding color scheme. Doubled
     class names outrank each section's own single-class button rules. */
  .htf-bs-primary.htf-bs-primary,
  .htf-bs-secondary.htf-bs-secondary,
  .htf-bs-link.htf-bs-link {
    border-color: transparent;
    transition: background-color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out),
      color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out),
      box-shadow var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out);
  }
  .htf-bs-primary.htf-bs-primary {
    background: var(--color-primary-button-background, #1a1b18);
    color: var(--color-primary-button-text, #ffffff);
    box-shadow: inset 0 0 0 1px var(--color-primary-button-border, transparent);
    text-decoration: none;
  }
  .htf-bs-primary.htf-bs-primary:hover {
    background: var(--color-primary-button-hover-background, #9f6939);
    color: var(--color-primary-button-hover-text, #ffffff);
    box-shadow: inset 0 0 0 1px var(--color-primary-button-hover-border, transparent);
  }
  .htf-bs-secondary.htf-bs-secondary {
    background: var(--color-secondary-button-background, transparent);
    color: var(--color-secondary-button-text, var(--color-foreground, #1a1b18));
    box-shadow: inset 0 0 0 1px var(--color-secondary-button-border, currentColor);
    text-decoration: none;
  }
  .htf-bs-secondary.htf-bs-secondary:hover {
    background: var(--color-secondary-button-hover-background, #1a1b18);
    color: var(--color-secondary-button-hover-text, #ffffff);
    box-shadow: inset 0 0 0 1px var(--color-secondary-button-hover-border, transparent);
  }
  .htf-bs-link.htf-bs-link {
    background: transparent;
    color: var(--color-foreground, #1a1b18);
    box-shadow: none;
    padding-inline: 0;
    min-width: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .htf-bs-link.htf-bs-link:hover {
    background: transparent;
    color: var(--color-primary, #9f6939);
    box-shadow: none;
  }
  @media only screen and (max-width: 768px) {
    .htf-btn { font-size: 12px; padding: 9px 17px; }
  }
  .htf-page-width {
    margin: 0 auto;
    max-width: 1500px;
    /* inline only — the shorthand was stomping sections' own vertical padding */
    padding-left: 17px;
    padding-right: 17px;
  }
  @media only screen and (min-width: 769px) {
    .htf-page-width { padding-left: 40px; padding-right: 40px; }
  }
</style>
