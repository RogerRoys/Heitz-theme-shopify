{%- comment -%}
  Heitz PDP main — Be Yours-style product page core:
  55/45 gallery + buy box, thumbnail slider, zoom modal, variant pills,
  quantity, Horizon-wired add to cart (cart drawer), dynamic checkout,
  payment icons, trust list, description, info accordion, FAQ, sticky bar.
{%- endcomment -%}
{% render 'heitz-pdp-base' %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign sid = section.id -%}

<style>
  .hpdp {
    font-family: var(--hpdp-font-body);
    /* theme color scheme drives the palette; reference values are fallbacks */
    --hpdp-text: var(--color-foreground, #212326);
    --hpdp-heading: var(--color-foreground-heading, #1a1b18);
    --hpdp-muted: var(--color-foreground-muted, #555555);
    --hpdp-border: var(--color-border, #d2d5d9);
    --hpdp-price: var(--color-primary, #1a1b18);
    color: var(--hpdp-text);
    background: var(--color-background, transparent);
  }
  .hpdp a { text-decoration: none; }
  .hpdp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 0 0 40px;
  }
  @media screen and (min-width: 750px) {
    .hpdp-grid { grid-template-columns: 55fr 45fr; gap: 50px; padding: 30px 0 60px; }
  }

  /* ── gallery (Impulse "beside/left" layout) ──── */
  .hpdp-media {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }
  /* mobile: gallery runs edge to edge, out of the page padding */
  @media screen and (max-width: 749px) {
    .hpdp-media { margin-inline: -24px; max-width: none; }
  }
  .hpdp-media__sticky,
  .hpdp-gallery-flex {
    min-width: 0;
    max-width: 100%;
  }
  @media screen and (min-width: 750px) {
    .hpdp-media__sticky { position: sticky; top: 20px; }
  }
  .hpdp-gallery-flex { display: flex; flex-direction: column; width: 100%; }
  .hpdp-thumbs-col {
    display: block;
    order: 2;
    width: 100%;
    margin-top: 22px;
    position: relative;
  }
  /* mobile: the strip sits inside the page padding (the image itself
     runs full-bleed) with slightly smaller thumbs */
  @media screen and (max-width: 749px) {
    .hpdp-thumbs-col { margin-top: 14px; padding-inline: 20px; }
    .hpdp-thumbs .hpdp-thumb { width: 54px; flex: 0 0 54px; }
  }
  .hpdp-stage { position: relative; overflow: hidden; order: 1; min-width: 0; }
  .hpdp-stage__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .hpdp-stage__track::-webkit-scrollbar { display: none; }
  .hpdp-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    position: relative;
  }
  .hpdp-slide__ratio { position: relative; padding-bottom: 100%; background: #f3f3f3; }
  .hpdp-slide__ratio img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    cursor: zoom-in;
  }
  .hpdp-zoom-btn {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 3;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    color: var(--hpdp-heading);
    cursor: zoom-in;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px rgba(0,0,0,.12);
    transition: transform .2s ease;
  }
  .hpdp-zoom-btn:hover { transform: scale(1.06); }
  .hpdp-zoom-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 4; stroke-miterlimit: 10; }
  .hpdp-dots {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
    max-width: 100%;
    padding-inline: 12px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .hpdp-dots span {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #ccc;
    transition: background .2s;
  }
  .hpdp-dots span.is-active { background: var(--hpdp-heading); }
  .hpdp-thumbs {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: -ms-autohiding-scrollbar;
    scroll-behavior: smooth;
  }
  /* auto-margin spacers center the strip when it fits and still allow
     scrolling from the first thumb when it overflows */
  .hpdp-thumbs::before,
  .hpdp-thumbs::after { content: ''; margin: auto; }
  .hpdp-thumbs::-webkit-scrollbar { width: 0; height: 0; }
  /* variant switch: quick fade + instant jump instead of a long scroll */
  .hpdp-stage__track { transition: opacity .09s ease; }
  .hpdp-stage__track.hpdp-switching { opacity: 0; }
  /* gallery arrows: white circles like the zoom button, hover-revealed
     on desktop and always visible on mobile */
  .hpdp-stage__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: #ffffff;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.35));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.25s ease,
      color var(--animation-speed, 0.125s) var(--animation-easing, ease-in-out);
  }
  .hpdp-stage__arrow--prev { left: 10px; }
  .hpdp-stage__arrow--next { right: 10px; }
  .hpdp-stage__arrow:hover {
    color: var(--color-primary-button-hover-background, #9f6939);
  }
  @media (hover: hover) and (min-width: 750px) {
    .hpdp-stage__arrow { opacity: 0; }
    .hpdp-stage:hover .hpdp-stage__arrow { opacity: 1; }
  }
  @media screen and (max-width: 749px) {
    .hpdp-stage__arrow { width: 36px; height: 36px; font-size: 18px; }
    .hpdp-stage__arrow--prev { left: 6px; }
    .hpdp-stage__arrow--next { right: 6px; }
  }
  .hpdp-thumb {
    display: block;
    width: 60px;
    flex: 0 0 60px;
    padding: 0;
    margin: 0 3px;
    border: 2px solid transparent;
    background: #f3f3f3;
    cursor: pointer;
    position: relative;
  }
  .hpdp-thumb img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  .hpdp-thumb.is-active:before {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 2px var(--hpdp-heading);
    z-index: 1;
  }
  @media screen and (min-width: 750px) {
    .hpdp-stage__track { overflow: hidden; }
    .hpdp-thumbs-col { display: block; }
    .hpdp-dots { display: none; }
  }

  /* ── buy box ─────────────────────────────────── */
  .hpdp-title {
    font-family: var(--hpdp-font-heading);
    font-weight: 600;
    font-size: clamp(24px, 19.5px + 1.5vw, {{ section.settings.heading_size | default: 35 }}px);
    line-height: 1.2;
    letter-spacing: .3px;
    color: var(--hpdp-heading);
    margin: 0 0 15px;
  }
  .hpdp-price {
    font-family: var(--hpdp-font-heading);
    font-size: 22px;
    letter-spacing: 1.3px;
    color: var(--hpdp-price);
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 4px;
  }
  .hpdp-price__compare { display: none; text-decoration: line-through; font-size: 17px; color: #85838f; }
  .hpdp-price--on-sale .hpdp-price__current { color: var(--hpdp-sale); }
  .hpdp-price--on-sale .hpdp-price__compare { display: inline; }

  .hpdp-trust {
    padding: 4px 0 8px;
    margin: 10px 0 4px;
  }
  .hpdp-trust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    color: #222222;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: .5px;
    line-height: 1.25;
  }
  .hpdp-trust__item:last-child { margin-bottom: 0; }
  .hpdp-trust__icon {
    width: 18px; height: 18px; min-width: 18px;
    border: 1.4px solid var(--hpdp-success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hpdp-success);
  }
  .hpdp-trust__icon svg { width: 11px; height: 11px; stroke: currentColor; stroke-width: 2.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  .hpdp-pills { border: 0; padding: 0; margin: 16px 0 0; }
  .hpdp-pills legend {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 12px;
    padding: 0;
    color: var(--hpdp-text);
  }
  .hpdp-pills input { position: absolute; opacity: 0; pointer-events: none; }
  .hpdp-pills label {
    display: inline-block;
    padding: 12px 22px;
    margin: 0 10px 10px 0;
    font-size: 15px;
    color: var(--hpdp-heading);
    background: #ffffff;
    box-shadow: inset 0 0 0 1px #ddd9d3;
    cursor: pointer;
    transition: box-shadow .2s ease, background .2s ease, color .2s ease;
  }
  .hpdp-pills input:checked + label {
    background: var(--color-selected-variant-background, #1a1b18);
    color: var(--color-selected-variant-text, #ffffff);
    box-shadow: inset 0 0 0 1px var(--color-selected-variant-border, #1a1b18);
  }
  .hpdp-pills input:not(:checked) + label:hover {
    background: var(--color-variant-hover-background, #ffffff);
    color: var(--color-variant-hover-text, var(--hpdp-heading));
    box-shadow: inset 0 0 0 1px var(--color-variant-hover-border, #9f6939);
  }
  .hpdp-pills input:checked + label:hover {
    background: var(--color-selected-variant-hover-background, var(--color-selected-variant-background, #1a1b18));
    color: var(--color-selected-variant-hover-text, var(--color-selected-variant-text, #ffffff));
    box-shadow: inset 0 0 0 1px var(--color-selected-variant-hover-border, var(--color-selected-variant-border, #1a1b18));
  }

  .hpdp-form-row { margin-top: 18px; }
  .hpdp-qty {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(33,35,38,.04);
    border-radius: 40px;
    padding: 4px;
    margin-bottom: 14px;
  }
  .hpdp-qty button {
    width: 36px; height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgba(33,35,38,.06);
    color: var(--hpdp-heading);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s ease, color .2s ease;
  }
  .hpdp-qty button:hover { background: var(--hpdp-heading); color: #fff; }
  .hpdp-qty input {
    width: 46px;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: var(--hpdp-font-body);
    font-size: 14px;
    font-weight: 500;
    -moz-appearance: textfield;
  }
  .hpdp-qty input::-webkit-outer-spin-button, .hpdp-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .hpdp .hpdp-atc.button {
    width: 100%;
    min-height: 50px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 12px 30px;
    background: var(--color-primary-button-background, #ffffff);
    border: 1px solid var(--color-primary-button-border, #1a1b18);
    border-radius: 0;
    color: var(--color-primary-button-text, #1a1b18);
    font-family: var(--hpdp-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .3s ease, color .3s ease, border-color .3s ease;
  }
  .hpdp .hpdp-atc.button:hover {
    background: var(--color-primary-button-hover-background, #1a1b18);
    border-color: var(--color-primary-button-hover-border, #1a1b18);
    color: var(--color-primary-button-hover-text, #ffffff);
  }
  .hpdp .shopify-payment-button { margin-top: 10px; }
  .hpdp .shopify-payment-button__button--unbranded {
    border-radius: 0;
    min-height: 50px;
    font-family: var(--hpdp-font-body);
    letter-spacing: .2em;
    text-transform: uppercase;
    font-size: 12px;
  }

  .hpdp-payments {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: nowrap;
    width: 100%;
    padding: 14px 0 16px;
    margin: 0;
    list-style: none;
  }
  .hpdp-payments li { line-height: 0; display: flex; }
  .hpdp-payments svg { width: 38px; height: auto; display: block; }
  @media (max-width: 600px) {
    .hpdp-payments { gap: 4px; padding: 10px 0 14px; }
    .hpdp-payments svg { width: clamp(28px, 8vw, 34px); }
  }

  .hpdp-description { margin-top: 6px; }
  .hpdp-description h2 { font-family: var(--hpdp-font-heading); font-weight: 600; font-size: 22px; letter-spacing: -.02em; color: var(--hpdp-heading); margin: 18px 0 10px; }
  .hpdp-description h3 { font-family: var(--hpdp-font-heading); font-weight: 600; font-size: 17px; color: var(--hpdp-heading); margin: 16px 0 8px; }
  .hpdp-description p, .hpdp-description li { font-size: {{ section.settings.text_size | default: 15 }}px; font-weight: 400; line-height: 1.7; letter-spacing: .2px; color: var(--hpdp-muted); }
  .hpdp-description ul { padding-left: 20px; margin: 8px 0; }
  .hpdp-description img { max-width: 100%; height: auto; margin-top: 10px; }

  /* info accordion (pd-info) */
  .hpdp-info-acc { width: 100%; border-top: 1px solid var(--hpdp-border-light); margin-top: 18px; }
  .hpdp-info-acc__item { border-bottom: 1px solid var(--hpdp-border-light); }
  .hpdp-info-acc__trigger {
    all: unset;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    cursor: pointer;
  }
  .hpdp-info-acc__icon { flex-shrink: 0; color: #1a1a1a; display: flex; }
  .hpdp-info-acc__icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .hpdp-info-acc__label {
    font-family: var(--hpdp-font-heading);
    font-weight: 500;
    font-size: 14px;
    color: #1a1a1a;
    letter-spacing: -.01em;
    flex: 1;
    transition: color .2s ease;
  }
  .hpdp-info-acc__trigger:hover .hpdp-info-acc__label { color: var(--hpdp-gold); }
  .hpdp-info-acc__chevron { flex-shrink: 0; color: var(--hpdp-gold); display: flex; transition: transform .25s ease; }
  .hpdp-info-acc__chevron svg { width: 14px; height: 14px; fill: none; }
  .hpdp-info-acc__trigger[aria-expanded="true"] .hpdp-info-acc__chevron { transform: rotate(180deg); }
  .hpdp-info-acc__answer p {
    font-weight: 300;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--hpdp-soft);
    margin: 0 0 10px;
  }
  .hpdp-info-acc__answer p:last-child { margin-bottom: 16px; }
  .hpdp-info-acc__answer a { color: var(--hpdp-soft); text-decoration: underline; }
  .hpdp-info-acc__answer strong { font-weight: 500; color: #1a1a1a; }

  /* FAQ (cl-faq) */
  .hpdp-faq { background: #ffffff; padding: 32px 0 16px; }
  .hpdp-faq__eyebrow {
    font-weight: 300;
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #aaa;
    margin: 0 0 8px;
  }
  .hpdp-faq__title {
    font-family: var(--hpdp-font-heading);
    font-weight: 600;
    font-size: 22px;
    color: #1a1a1a;
    letter-spacing: -.02em;
    line-height: 1.2;
    margin: 0 0 24px;
  }
  .hpdp-faq__list { border-top: 1px solid var(--hpdp-border-light); }
  .hpdp-faq__item { border-bottom: 1px solid var(--hpdp-border-light); }
  .hpdp-faq__trigger {
    all: unset;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    cursor: pointer;
  }
  .hpdp-faq__q {
    font-family: var(--hpdp-font-heading);
    font-weight: 500;
    font-size: 14px;
    color: #1a1a1a;
    line-height: 1.4;
    transition: color .2s ease;
  }
  .hpdp-faq__trigger:hover .hpdp-faq__q { color: var(--hpdp-gold); }
  .hpdp-faq__icon {
    flex-shrink: 0;
    color: var(--hpdp-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px; height: 28px; min-width: 28px;
    border: 1px solid #e0ddd8;
    border-radius: 50%;
    transition: background-color .2s ease, border-color .2s ease, color .2s ease;
  }
  .hpdp-faq__icon svg { width: 16px; height: 16px; }
  .hpdp-faq__icon .hpdp-icon-v { transition: transform .2s ease, opacity .2s ease; transform-origin: center; }
  .hpdp-faq__trigger:hover .hpdp-faq__icon,
  .hpdp-faq__trigger[aria-expanded="true"] .hpdp-faq__icon { background: var(--hpdp-gold); border-color: var(--hpdp-gold); color: #fff; }
  .hpdp-faq__trigger[aria-expanded="true"] .hpdp-icon-v { transform: scaleY(0); opacity: 0; }
  .hpdp-faq__a p { font-weight: 300; font-size: 13.5px; line-height: 1.7; color: var(--hpdp-soft); margin: 0; padding: 0 0 16px; }

  /* ── zoom modal ─────────────────────────────── */
  .hpdp-modal {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: #ffffff;
    display: none;
    overflow-y: auto;
  }
  .hpdp-modal.is-open { display: block; }
  .hpdp-modal__close {
    position: fixed;
    top: 20px; right: 24px;
    z-index: 3;
    width: 44px; height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(33,35,38,.08);
    color: var(--hpdp-heading);
    font-size: 26px;
    cursor: pointer;
  }
  .hpdp-modal__content { max-width: 1100px; margin: 0 auto; padding: 60px 20px; }
  .hpdp-modal__content img { width: 100%; height: auto; display: block; margin-bottom: 16px; }
</style>

<section class="hpdp color-{{ section.settings.color_scheme }}" data-hpdp
  data-section-id="{{ sid }}"
  data-product-id="{{ product.id }}">
  <div class="hpdp-page-width">
    <div class="hpdp-grid">

      <div class="hpdp-media">
        <div class="hpdp-media__sticky">
          <div class="hpdp-gallery-flex">
            <div class="hpdp-thumbs-col">
              <div class="hpdp-thumbs" data-hpdp-thumbs>
                {%- for media in product.media -%}
                  <button type="button" class="hpdp-thumb{% if forloop.first %} is-active{% endif %}" data-hpdp-thumb data-media-id="{{ media.id }}" aria-label="Image {{ forloop.index }}">
                    {{ media | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
            <div class="hpdp-stage">
            <button type="button" class="hpdp-stage__arrow hpdp-stage__arrow--prev" data-hpdp-prev aria-label="Previous image">&#8592;</button>
            <button type="button" class="hpdp-stage__arrow hpdp-stage__arrow--next" data-hpdp-next aria-label="Next image">&#8594;</button>
            <button type="button" class="hpdp-zoom-btn" data-hpdp-zoom-open aria-label="Zoom image">
              <svg viewBox="0 0 64 64"><path d="M47.16 28.58A18.58 18.58 0 1 1 28.58 10a18.58 18.58 0 0 1 18.58 18.58ZM54 54 41.94 42"/></svg>
            </button>
            <div class="hpdp-stage__track" data-hpdp-track>
              {%- for media in product.media -%}
                {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
                <div class="hpdp-slide" data-hpdp-slide data-media-id="{{ media.id }}">
                  <div class="hpdp-slide__ratio">
                    {{ media | image_url: width: 1500 | image_tag: alt: product.title, loading: img_loading, sizes: '(min-width: 750px) 55vw, 100vw', widths: '535, 750, 1100, 1500' }}
                  </div>
                </div>
              {%- else -%}
                <div class="hpdp-slide"><div class="hpdp-slide__ratio"></div></div>
              {%- endfor -%}
            </div>
          </div>
          </div>
          <div class="hpdp-dots" data-hpdp-dots></div>
        </div>
      </div>

      <div class="hpdp-info">
        <h1 class="hpdp-title" data-hpdp-spy="{{ product.title | escape }}">{{ product.title }}</h1>

        <div class="hpdp-price{% if current_variant.compare_at_price > current_variant.price %} hpdp-price--on-sale{% endif %}" data-hpdp-price>
          <span class="hpdp-price__current">{{ current_variant.price | money }}</span>
          <s class="hpdp-price__compare">{{ current_variant.compare_at_price | money }}</s>
        </div>

        {%- assign trust_blocks = section.blocks | where: 'type', 'trust_item' -%}
        {%- if trust_blocks.size > 0 -%}
          <div class="hpdp-trust">
            {%- for block in trust_blocks -%}
              <div class="hpdp-trust__item" {{ block.shopify_attributes }}>
                <span class="hpdp-trust__icon"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span>
                <span>{{ block.settings.text | escape }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div data-hpdp-options>
            {%- for option in product.options_with_values -%}
              <fieldset class="hpdp-pills" data-option-index="{{ forloop.index0 }}">
                <legend>{{ option.name }}</legend>
                {%- assign opt_idx = forloop.index0 -%}
                {%- for value in option.values -%}
                  <input type="radio"
                    id="hpdp-{{ sid }}-{{ opt_idx }}-{{ forloop.index0 }}"
                    name="hpdp-{{ sid }}-option-{{ opt_idx }}"
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}>
                  <label for="hpdp-{{ sid }}-{{ opt_idx }}-{{ forloop.index0 }}">{{ value }}</label>
                {%- endfor -%}
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="hpdp-form-row buy-buttons-block">
          <product-form-component
            data-section-id="{{ sid }}"
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="1"
            data-quantity-error-max="{{ 'products.product.quantity_error_max' | t: default: 'Max quantity reached' }}"
          >
            <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
            {%- form 'product', product, id: 'hpdp-form', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" ref="variantId" value="{{ current_variant.id }}" data-hpdp-variant-input>
              <div class="hpdp-qty">
                <button type="button" data-hpdp-qty-minus aria-label="Decrease quantity">&minus;</button>
                <input type="number" name="quantity" value="1" min="1" step="1" aria-label="Quantity" data-hpdp-qty-input>
                <button type="button" data-hpdp-qty-plus aria-label="Increase quantity">+</button>
              </div>
              {% render 'add-to-cart-button',
                can_add_to_cart: current_variant.available,
                product: product,
                class: 'hpdp-atc button--full-width',
                id: 'hpdp-atc-btn'
              %}
              {%- if section.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            {%- endform -%}
          </product-form-component>
        </div>

        {%- if section.settings.show_payment_icons -%}
          <ul class="hpdp-payments" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="hpdp-description">{{ product.description }}</div>

        {%- assign info_blocks = section.blocks | where: 'type', 'info_item' -%}
        {%- if info_blocks.size > 0 -%}
          <div class="hpdp-info-acc">
            {%- for block in info_blocks -%}
              <div class="hpdp-info-acc__item" {{ block.shopify_attributes }}>
                <button class="hpdp-info-acc__trigger" aria-expanded="false" data-hpdp-acc>
                  <span class="hpdp-info-acc__icon">
                    {%- if block.settings.icon == 'box' -%}
                      <svg viewBox="0 0 24 24"><path d="M3 10H21M7 3L3 10V19C3 19.53 3.21 20.04 3.59 20.41C3.96 20.79 4.47 21 5 21H19C19.53 21 20.04 20.79 20.41 20.41C20.79 20.04 21 19.53 21 19V10L17 3H7Z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24"><path d="M1 3H15V16H1V3Z"/><path d="M15 8H19L23 12V16H15V8Z"/><circle cx="5.5" cy="18.5" r="1.5"/><circle cx="18.5" cy="18.5" r="1.5"/></svg>
                    {%- endif -%}
                  </span>
                  <span class="hpdp-info-acc__label">{{ block.settings.title | escape }}</span>
                  <span class="hpdp-info-acc__chevron">
                    <svg viewBox="0 0 14 14"><path d="M2 5L7 10L12 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </button>
                <div class="hpdp-info-acc__answer" hidden>{{ block.settings.content }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign collection_faqs = blank
          assign faq_collection = blank
          for product_collection in product.collections
            if product_collection.metafields.custom.faq_items.value != blank
              assign collection_faqs = product_collection.metafields.custom.faq_items.value
              assign faq_collection = product_collection
              break
            endif
          endfor
          assign faq_blocks = section.blocks | where: 'type', 'faq_item'
        -%}
        {%- if collection_faqs != blank or faq_blocks.size > 0 -%}
          <div class="hpdp-faq">
            <p class="hpdp-faq__eyebrow">{{ section.settings.faq_eyebrow | default: faq_collection.title | default: product.collections.first.title | default: 'FAQs' }}</p>
            <h2 class="hpdp-faq__title" data-hpdp-spy="Common Questions">{{ section.settings.faq_title | default: 'Common Questions' }}</h2>
            <div class="hpdp-faq__list">
              {%- if collection_faqs != blank -%}
                {%- for faq in collection_faqs -%}
                  <div class="hpdp-faq__item">
                    <button class="hpdp-faq__trigger" aria-expanded="false" data-hpdp-acc>
                      <span class="hpdp-faq__q">{{ faq.question.value | escape }}</span>
                      <span class="hpdp-faq__icon">
                        <svg viewBox="0 0 16 16"><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line class="hpdp-icon-v" x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </span>
                    </button>
                    <div class="hpdp-faq__a" hidden><p>{{ faq.answer.value | escape | newline_to_br }}</p></div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for block in faq_blocks -%}
                  <div class="hpdp-faq__item" {{ block.shopify_attributes }}>
                    <button class="hpdp-faq__trigger" aria-expanded="false" data-hpdp-acc>
                      <span class="hpdp-faq__q">{{ block.settings.question | escape }}</span>
                      <span class="hpdp-faq__icon">
                        <svg viewBox="0 0 16 16"><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line class="hpdp-icon-v" x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </span>
                    </button>
                    <div class="hpdp-faq__a" hidden><p>{{ block.settings.answer }}</p></div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Reference-style sticky add-to-cart bar (desktop + mobile) {%- endcomment -%}
{% if section.settings.enable_sticky_add_to_cart %}
  {%- assign sticky_image = current_variant.featured_image | default: product.featured_image -%}
  <div class="hpdp-sticky color-{{ section.settings.sticky_color_scheme | default: 'scheme-1' }}" data-hpdp-sticky aria-hidden="true">
    <div class="hpdp-sticky__inner">
      <div class="hpdp-sticky__left">
        {%- if sticky_image -%}
          <img class="hpdp-sticky__img" data-hpdp-sticky-img
            src="{{ sticky_image | image_url: width: 160 }}"
            alt="{{ product.title | escape }}" loading="lazy"
            width="{{ sticky_image.width | default: 60 }}" height="{{ sticky_image.height | default: 60 }}">
        {%- endif -%}
        <div class="hpdp-sticky__meta">
          <p class="hpdp-sticky__title">{{ product.title }}</p>
          <div class="hpdp-sticky__price{% if current_variant.compare_at_price > current_variant.price %} is-sale{% endif %}" data-hpdp-sticky-price>
            <span class="hpdp-sticky__price-current">{{ current_variant.price | money }}</span>
            <s class="hpdp-sticky__price-compare">{{ current_variant.compare_at_price | money }}</s>
          </div>
        </div>
      </div>
      <div class="hpdp-sticky__form">
        {%- unless product.has_only_default_variant -%}
          <div class="hpdp-sticky__selects">
            {%- for option in product.options_with_values -%}
              <label class="hpdp-sticky__select">
                <select data-hpdp-sticky-option="{{ forloop.index0 }}" aria-label="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
                <svg class="hpdp-sticky__caret" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2"/></svg>
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}
        <button type="button" class="hpdp-sticky__atc" data-hpdp-sticky-atc{% unless current_variant.available %} disabled{% endunless %}>
          {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      </div>
    </div>
  </div>
{% endif %}

<style>
  .hpdp-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  /* solid cover above the shadow oval so the blur never bleeds into the bar */
  .hpdp-sticky::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-background, #ffffff);
  }
  .hpdp-sticky::after {
    content: '';
    position: absolute;
    z-index: -2;
    top: 0;
    left: 24px;
    right: 24px;
    height: 20px;
    border-radius: 100%;
    box-shadow: 0 0 40px rgba(26, 27, 24, 0.22);
  }
  .hpdp-sticky.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .hpdp-sticky.hpdp-sticky--suppressed {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: none;
  }
  .hpdp-sticky__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 10px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .hpdp-sticky__left { display: flex; align-items: center; gap: 20px; min-width: 0; }
  .hpdp-sticky__img { height: 60px; width: auto; display: block; }
  .hpdp-sticky__meta { min-width: 0; }
  .hpdp-sticky__title {
    margin: 0 0 2px;
    font-family: var(--hpdp-font-heading);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-foreground-heading, #1a1b18);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hpdp-sticky__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--hpdp-font-body);
    font-size: 14px;
    color: var(--color-foreground, #1a1b18);
  }
  .hpdp-sticky__price-compare { display: none; color: #9a938a; font-size: 13px; }
  .hpdp-sticky__price.is-sale .hpdp-sticky__price-compare { display: inline; }
  .hpdp-sticky__form { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .hpdp-sticky__selects { display: flex; gap: 10px; }
  .hpdp-sticky__select { position: relative; display: block; color: var(--color-foreground, #1a1b18); }
  .hpdp-sticky__select select {
    -webkit-appearance: none;
    appearance: none;
    height: 40px;
    min-width: 110px;
    max-width: 180px;
    padding: 0 32px 0 12px;
    border: 1px solid var(--color-border, rgba(26, 27, 24, 0.25));
    border-radius: 0;
    background: transparent;
    font-family: var(--hpdp-font-body);
    font-size: 12px;
    color: inherit;
    cursor: pointer;
  }
  .hpdp-sticky__caret {
    position: absolute;
    right: 12px;
    top: 50%;
    width: 10px;
    height: 6px;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .hpdp-sticky__atc {
    height: 40px;
    min-width: 180px;
    padding: 0 20px;
    border: 1px solid var(--color-primary-button-border, #1a1b18);
    border-radius: 0;
    background-color: var(--color-primary-button-background, #1a1b18);
    color: var(--color-primary-button-text, #ffffff);
    font-family: var(--hpdp-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .hpdp-sticky__atc:hover {
    background: var(--color-primary-button-hover-background, #9f6939);
    border-color: var(--color-primary-button-hover-background, #9f6939);
    color: var(--color-primary-button-hover-text, #ffffff);
  }
  .hpdp-sticky__atc:disabled { background: #b9b3aa; border-color: #b9b3aa; cursor: default; }
  @media screen and (max-width: 749px) {
    .hpdp-sticky__inner { padding: 10px 15px; }
    .hpdp-sticky__img,
    .hpdp-sticky__title,
    .hpdp-sticky__selects { display: none; }
  }
</style>

  <div class="hpdp-modal" data-hpdp-modal aria-hidden="true">
    <button type="button" class="hpdp-modal__close" data-hpdp-zoom-close aria-label="Close">&times;</button>
    <div class="hpdp-modal__content">
      {%- for media in product.media -%}
        <img src="{{ media | image_url: width: 3000 }}" alt="{{ product.title | escape }}" loading="lazy">
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-hpdp-variants>{{ product.variants | json }}</script>
  <span data-hpdp-money-format hidden>{{ shop.money_format }}</span>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-hpdp]');
    if (!root) return;
    var variants = JSON.parse(root.querySelector('[data-hpdp-variants]').textContent);
    var moneyTemplate = root.querySelector('[data-hpdp-money-format]').textContent.trim();
    var moneyFormat = function (cents) {
      var amount = (cents / 100).toFixed(2);
      if (/amount_no_decimals/.test(moneyTemplate)) amount = Math.round(cents / 100).toString();
      return moneyTemplate.replace(/\{\{\s*amount[^}]*\}\}/, amount);
    };

    /* gallery */
    var track = root.querySelector('[data-hpdp-track]');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hpdp-slide]'));
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-hpdp-thumb]'));
    var dotsEl = root.querySelector('[data-hpdp-dots]');
    var current = 0;

    if (dotsEl && slides.length > 1) {
      slides.forEach(function (s, i) {
        var d = document.createElement('span');
        if (i === 0) d.className = 'is-active';
        dotsEl.appendChild(d);
      });
    }

    function goTo(i, smooth) {
      current = Math.max(0, Math.min(i, slides.length - 1));
      track.scrollTo({ left: track.clientWidth * current, behavior: smooth === false ? 'auto' : 'smooth' });
      sync();
    }
    function sync() {
      thumbs.forEach(function (t, i) { t.classList.toggle('is-active', i === current); });
      if (dotsEl) Array.prototype.forEach.call(dotsEl.children, function (d, i) { d.classList.toggle('is-active', i === current); });
      /* keep the active thumb in view by scrolling ONLY the strip —
         scrollIntoView would drag the whole page along vertically */
      var active = thumbs[current];
      var thumbsBox = active && active.closest('[data-hpdp-thumbs]');
      if (active && thumbsBox) {
        var tb = thumbsBox.getBoundingClientRect();
        var ab = active.getBoundingClientRect();
        if (ab.left < tb.left || ab.right > tb.right) {
          thumbsBox.scrollTo({
            left: thumbsBox.scrollLeft + (ab.left - tb.left) - (tb.width - ab.width) / 2,
            behavior: 'smooth'
          });
        }
      }
    }
    thumbs.forEach(function (t, i) { t.addEventListener('click', function () { goTo(i); }); });
    var prevArrow = root.querySelector('[data-hpdp-prev]');
    var nextArrow = root.querySelector('[data-hpdp-next]');
    if (prevArrow && nextArrow) {
      if (slides.length < 2) {
        prevArrow.hidden = true;
        nextArrow.hidden = true;
      } else {
        prevArrow.addEventListener('click', function () { goTo((current - 1 + slides.length) % slides.length); });
        nextArrow.addEventListener('click', function () { goTo((current + 1) % slides.length); });
      }
    }
    track.addEventListener('scroll', function () {
      var i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== current) { current = i; sync(); }
    }, { passive: true });

    /* zoom modal */
    var modal = root.querySelector('[data-hpdp-modal]');
    function openModal() { modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); document.documentElement.style.overflow = 'hidden'; }
    function closeModal() { modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); document.documentElement.style.overflow = ''; }
    root.querySelector('[data-hpdp-zoom-open]').addEventListener('click', openModal);
    slides.forEach(function (s) { s.addEventListener('click', function (e) { if (window.innerWidth >= 750) openModal(); }); });
    root.querySelector('[data-hpdp-zoom-close]').addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

    /* quantity */
    var qtyInput = root.querySelector('[data-hpdp-qty-input]');
    root.querySelector('[data-hpdp-qty-minus]').addEventListener('click', function () {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value || '1', 10) - 1);
    });
    root.querySelector('[data-hpdp-qty-plus]').addEventListener('click', function () {
      qtyInput.value = parseInt(qtyInput.value || '1', 10) + 1;
    });

    /* variants */
    var optionsWrap = root.querySelector('[data-hpdp-options]');
    var variantInput = root.querySelector('[data-hpdp-variant-input]');
    var priceEl = root.querySelector('[data-hpdp-price]');
    var atcBtn = root.querySelector('#hpdp-atc-btn');

    function selectedOptions() {
      var out = [];
      if (!optionsWrap) return out;
      optionsWrap.querySelectorAll('fieldset').forEach(function (fs) {
        var checked = fs.querySelector('input:checked');
        out.push(checked ? checked.value : null);
      });
      return out;
    }
    function findVariant(opts) {
      return variants.find(function (v) {
        return opts.every(function (val, i) { return !val || v.options[i] === val; });
      });
    }
    function applyVariant(v) {
      if (!v) return;
      variantInput.value = v.id;
      var cur = priceEl.querySelector('.hpdp-price__current');
      var cmp = priceEl.querySelector('.hpdp-price__compare');
      cur.textContent = moneyFormat(v.price);
      var onSale = v.compare_at_price && v.compare_at_price > v.price;
      priceEl.classList.toggle('hpdp-price--on-sale', !!onSale);
      if (onSale) cmp.textContent = moneyFormat(v.compare_at_price);
      if (atcBtn) atcBtn.disabled = !v.available;
      updateSticky(v);
      if (v.featured_media) {
        var idx = slides.findIndex(function (s) { return s.getAttribute('data-media-id') === String(v.featured_media.id); });
        if (idx >= 0 && idx !== current) {
          /* decode the target image first, then swap behind a quick fade —
             no slow travel across the in-between slides */
          var img = slides[idx].querySelector('img');
          if (img) {
            img.loading = 'eager';
            if (img.decode) img.decode().catch(function () {});
          }
          track.classList.add('hpdp-switching');
          setTimeout(function () {
            goTo(idx, false);
            track.classList.remove('hpdp-switching');
          }, 90);
        }
      }
    }
    if (optionsWrap) {
      optionsWrap.addEventListener('change', function () {
        applyVariant(findVariant(selectedOptions()));
      });
    }

    /* sticky add-to-cart bar (reference behavior: reveal once the buy
       buttons scroll past, hide again on the way back up) */
    var sticky = root.querySelector('[data-hpdp-sticky]');
    var stickyPrice = sticky && sticky.querySelector('[data-hpdp-sticky-price]');
    var stickyImg = sticky && sticky.querySelector('[data-hpdp-sticky-img]');
    var stickyAtc = sticky && sticky.querySelector('[data-hpdp-sticky-atc]');
    var stickySelects = sticky ? [].slice.call(sticky.querySelectorAll('[data-hpdp-sticky-option]')) : [];
    var stickyAddLabel = stickyAtc ? stickyAtc.textContent.trim() : '';
    function updateSticky(v) {
      if (!sticky || !v) return;
      var cur = stickyPrice.querySelector('.hpdp-sticky__price-current');
      var cmp = stickyPrice.querySelector('.hpdp-sticky__price-compare');
      cur.textContent = moneyFormat(v.price);
      var onSale = v.compare_at_price && v.compare_at_price > v.price;
      stickyPrice.classList.toggle('is-sale', !!onSale);
      if (onSale) cmp.textContent = moneyFormat(v.compare_at_price);
      stickyAtc.disabled = !v.available;
      stickyAtc.textContent = v.available ? stickyAddLabel : {{ 'products.product.sold_out' | t | json }};
      stickySelects.forEach(function (sel, i) { if (v.options[i] != null) sel.value = v.options[i]; });
      if (stickyImg && v.featured_image && v.featured_image.src) {
        var src = v.featured_image.src;
        stickyImg.src = src + (src.indexOf('?') > -1 ? '&' : '?') + 'width=160';
      }
    }
    if (sticky) {
      var buyRow = root.querySelector('.buy-buttons-block');
      var stickyAt = 0;
      var measureSticky = function () {
        if (!buyRow) return;
        var r = buyRow.getBoundingClientRect();
        stickyAt = r.top + r.height + (window.pageYOffset || document.documentElement.scrollTop);
      };
      var onStickyScroll = function () {
        var y = window.pageYOffset || document.documentElement.scrollTop;
        var show = y > stickyAt;
        if (show !== sticky.classList.contains('is-visible')) {
          sticky.classList.toggle('is-visible', show);
          sticky.setAttribute('aria-hidden', String(!show));
        }
      };
      measureSticky();
      window.addEventListener('load', function () { measureSticky(); onStickyScroll(); });
      window.addEventListener('resize', function () { measureSticky(); onStickyScroll(); });
      window.addEventListener('scroll', onStickyScroll, { passive: true });
      onStickyScroll();
      stickySelects.forEach(function (sel) {
        sel.addEventListener('change', function () {
          var idx = sel.getAttribute('data-hpdp-sticky-option');
          var fs = optionsWrap && optionsWrap.querySelector('fieldset[data-option-index="' + idx + '"]');
          if (!fs) return;
          var input = null;
          [].slice.call(fs.querySelectorAll('input')).some(function (inp) {
            if (inp.value === sel.value) { input = inp; return true; }
            return false;
          });
          if (input && !input.checked) {
            input.checked = true;
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
      if (stickyAtc) {
        stickyAtc.addEventListener('click', function () {
          if (atcBtn && !atcBtn.disabled) atcBtn.click();
        });
      }
      /* like the reference, drop the bar while the cart drawer or the
         quick-view popup is over it (wired after parse: the quick-view
         dialog is rendered at the end of the layout) */
      var wireSuppression = function () {
        var overlayDialogs = [].slice.call(document.querySelectorAll('cart-drawer-component dialog, #heitz-quick-view, .htf-drawer'));
        if (!overlayDialogs.length) return;
        var updateSuppressed = function () {
          var covered = overlayDialogs.some(function (d) {
            return d.hasAttribute('open') || d.classList.contains('is-open');
          });
          sticky.classList.toggle('hpdp-sticky--suppressed', covered);
        };
        var suppressObserver = new MutationObserver(updateSuppressed);
        overlayDialogs.forEach(function (d) {
          suppressObserver.observe(d, { attributes: true, attributeFilter: ['open', 'class'] });
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wireSuppression);
      } else {
        wireSuppression();
      }
    }

    /* accordions (single-open per group) */
    root.querySelectorAll('.hpdp-info-acc, .hpdp-faq__list').forEach(function (group) {
      var triggers = group.querySelectorAll('[data-hpdp-acc]');
      triggers.forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var isOpen = trigger.getAttribute('aria-expanded') === 'true';
          triggers.forEach(function (t) {
            t.setAttribute('aria-expanded', 'false');
            var panel = t.parentElement.querySelector('[hidden], .hpdp-info-acc__answer, .hpdp-faq__a');
            if (panel) panel.hidden = true;
          });
          trigger.setAttribute('aria-expanded', String(!isOpen));
          var own = trigger.parentElement.querySelector('.hpdp-info-acc__answer, .hpdp-faq__a');
          if (own) own.hidden = isOpen;
        });
      });
    });

  })();
</script>

