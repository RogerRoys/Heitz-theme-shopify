{%- comment -%}
  Heitz PDP icon row — 4-up reassurance icons in warm brown
  (aurli-icon-row port).
{%- endcomment -%}
{% render 'heitz-pdp-base' %}
<style>
  .hpdp-icons {
    width: 100%;
    background: var(--color-background, #ffffff);
    padding: {{ section.settings.padding_top | default: 80 }}px 18px {{ section.settings.padding_bottom | default: 80 }}px;
    font-family: var(--hpdp-font-body);
  }
  .hpdp-icons__inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    text-align: center;
  }
  .hpdp-icons__item { color: var(--color-foreground-heading, var(--hpdp-brown)); }
  .hpdp-icons__icon {
    width: 24px; height: 24px;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hpdp-icons__icon svg { width: 24px; height: 24px; stroke: var(--color-foreground-heading, var(--hpdp-brown)); stroke-width: 1.8; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .hpdp-icons__title {
    font-family: var(--hpdp-font-heading);
    font-size: {{ section.settings.heading_size | default: 13 }}px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .hpdp-icons__text {
    font-size: {{ section.settings.text_size | default: 14 }}px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: .7px;
    max-width: 210px;
    margin: 0 auto;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  @media screen and (max-width: 900px) {
    .hpdp-icons__inner { grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
    .hpdp-icons__title { font-size: 12px; letter-spacing: 1.5px; }
    .hpdp-icons__text { font-size: 13px; max-width: 190px; }
  }
  @media screen and (max-width: 520px) {
    .hpdp-icons { padding: {{ section.settings.padding_top | default: 80 }}px 14px {{ section.settings.padding_bottom | default: 80 }}px; }
    .hpdp-icons__icon, .hpdp-icons__icon svg { width: 22px; height: 22px; }
    .hpdp-icons__title { font-size: 11px; letter-spacing: 1.3px; }
    .hpdp-icons__text { font-size: 12.5px; line-height: 1.4; max-width: 150px; }
  }
</style>

<section class="hpdp-icons color-{{ section.settings.color_scheme }}">
  <div class="hpdp-icons__inner">
    {%- for block in section.blocks -%}
      <div class="hpdp-icons__item" {{ block.shopify_attributes }}>
        <div class="hpdp-icons__icon">
          {%- case block.settings.icon -%}
            {%- when 'boxes' -%}
              <svg viewBox="0 0 24 24"><rect x="3" y="4" width="12" height="12" rx="2"/><rect x="9" y="10" width="12" height="10" rx="2"/></svg>
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24"><path d="M4 7h10v9H4z"/><path d="M14 10h3.5l2.5 3v3h-6z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/></svg>
            {%- when 'chat' -%}
              <svg viewBox="0 0 24 24"><path d="M4 5h10a2 2 0 0 1 2 2v6H9l-5 4V7a2 2 0 0 1 2-2z"/><path d="M13 14h5l3 3V10a2 2 0 0 0-2-2h-2"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="hpdp-icons__title">{{ block.settings.title | escape }}</h3>
        <p class="hpdp-icons__text">{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Heitz PDP Icon Row",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "boxes", "label": "Boxes" },
            { "value": "truck", "label": "Truck" },
            { "value": "chat", "label": "Chat" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "boxes"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "Enjoy free shipping on every order." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Heitz PDP Icon Row",
      "blocks": [
        { "type": "item", "settings": { "icon": "boxes", "title": "Free Shipping", "text": "Enjoy free shipping on every order." } },
        { "type": "item", "settings": { "icon": "truck", "title": "Tracked Delivery", "text": "Follow your order from dispatch to arrival." } },
        { "type": "item", "settings": { "icon": "chat", "title": "Have a Question?", "text": "Our team is here to help, 5 days a week." } },
        { "type": "item", "settings": { "icon": "shield", "title": "Secure Payments", "text": "Your safety and convenience are our priority." } }
      ]
    }
  ]
}
{% endschema %}
