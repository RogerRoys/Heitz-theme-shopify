{%- comment -%}
  Heitz About Closing — centered italic quote with a small-caps signature.
{%- endcomment -%}
{% render 'heitz-tf-base' %}

<style>
  .habc { text-align: center; font-family: var(--font-body--family, var(--htf-font-body)); }
  .habc__inner { padding-top: {{ section.settings.padding_top | default: 40 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px; background: var(--color-background, #f5f3ee); }
  .habc * { box-sizing: border-box; }
  .habc blockquote {
    max-width: 1100px;
    margin: 0 auto 20px;
    padding: 0;
    color: var(--color-foreground-heading, var(--htf-color-text));
    background: transparent;
    border: 0;
    font-family: var(--font-heading--family, var(--htf-font-heading));
    font-size: clamp(22px, 3vw, 36px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
  }
  .habc__signature {
    margin: 0;
    color: var(--color-primary, #b8913f);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  @media only screen and (max-width: 768px) {
    .habc__inner { padding-top: {{ section.settings.padding_top | default: 40 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px; }
    .habc blockquote { font-size: 26px; line-height: 1.4; }
  }
</style>

<section class="habc">
  <div class="htf-page-width habc__inner color-{{ section.settings.color_scheme }}">
  <blockquote>{{ section.settings.quote }}</blockquote>
  <p class="habc__signature">{{ section.settings.signature }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Heitz About Closing",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-heitz-beige" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "inline_richtext", "id": "quote", "label": "Quote", "default": "“This is not just about lighting. It’s about creating spaces that feel right — balanced, warm, and intentional.”" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "The Heitz Team" }
  ],
  "presets": [{ "name": "Heitz About Closing" }]
}
{% endschema %}
