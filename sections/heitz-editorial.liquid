{%- comment -%}
  Heitz TF editorial — "Behind the Design" feature row: text left,
  two overlapping portrait images right (40% / 60%).
{%- endcomment -%}
<style>
  .htf-editorial { padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 40 }}px; background: var(--color-background, transparent); }
  .htf-editorial__row {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .htf-editorial--img-left .htf-editorial__row { flex-direction: row-reverse; }
  .htf-editorial__text { flex: 0 1 50%; text-align: left; }
  .htf-editorial__text h2 {
    font-family: var(--htf-font-heading);
    font-weight: 400;
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}font-size: var(--font-size, 26px); font-family: var(--font-family, var(--htf-font-heading)); font-weight: var(--font-weight, 400); line-height: var(--line-height, 1.1); letter-spacing: var(--letter-spacing, 0.025em); text-transform: var(--text-transform, none);{% endif %} color: var(--color, var(--color-foreground-heading, var(--htf-color-text)));
    letter-spacing: 0.025em;
    line-height: 1.1;
    color: var(--color-foreground-heading, var(--htf-color-text));
    margin: 0 0 20px;
  }
  .htf-editorial__text h2 strong { font-weight: 400; }
  .htf-editorial__text p {
    font-family: var(--htf-font-body);
    font-size: {{ section.settings.text_size | default: 17 }}px;
    line-height: 1.4;
    color: var(--color-foreground, var(--htf-color-text));
    margin: 0 0 25px;
  }
  .htf-editorial__images {
    flex: 0 1 50%;
    display: flex;
    align-items: center;
    position: relative;
  }
  .htf-editorial__img-wrap { position: relative; overflow: hidden; }
  .htf-editorial__img-wrap .htf-ratio {
    height: 0;
    padding-bottom: 133.33%;
    position: relative;
    background: #ececec;
  }
  .htf-editorial__img-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .htf-editorial__first {
    width: 40%;
    z-index: 2;
    margin-right: -8%;
    box-shadow: 0 10px 30px rgba(0,0,0,.12);
  }
  .htf-editorial__second { width: 60%; }
  @media only screen and (max-width: 768px) {
    .htf-editorial { padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 40 }}px; }
    .htf-editorial__row,
    .htf-editorial--img-left .htf-editorial__row { flex-direction: column-reverse; }
    .htf-editorial__text, .htf-editorial__images { flex: 1 1 100%; width: 100%; }
    {% if section.settings.type_preset == 'custom' or section.settings.type_preset == blank %}.htf-editorial__text h2 { font-size: var(--font-size, 22px); }{% endif %}
    .htf-editorial__text p { font-size: {{ section.settings.text_size | default: 17 | minus: 1 }}px; }
  }
</style>

<div class="htf-editorial color-{{ section.settings.color_scheme }}{% if section.settings.image_position == 'left' %} htf-editorial--img-left{% endif %}">
  <div class="htf-page-width">
    <div class="htf-editorial__row">
      <div class="htf-editorial__text">
        <h2 class="{% unless section.settings.type_preset == 'custom' or section.settings.type_preset == blank %} {{ section.settings.type_preset }}{% endunless %}" style="{% render 'typography-style', settings: section.settings %}"><strong>{{ section.settings.title }}</strong></h2>
        <p>{{ section.settings.text }}</p>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.link | default: routes.collections_url }}" class="htf-btn">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="htf-editorial__images">
        <div class="htf-editorial__img-wrap htf-editorial__first">
          <a href="{{ section.settings.link | default: routes.collections_url }}">
            <div class="htf-ratio">
              {%- if section.settings.image_1 != blank -%}
                {{ section.settings.image_1 | image_url: width: 1080 | image_tag: alt: section.settings.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
          </a>
        </div>
        <div class="htf-editorial__img-wrap htf-editorial__second">
          <a href="{{ section.settings.link | default: routes.collections_url }}">
            <div class="htf-ratio">
              {%- if section.settings.image_2 != blank -%}
                {{ section.settings.image_2 | image_url: width: 1080 | image_tag: alt: section.settings.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heitz TF Editorial",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "type_preset", "label": "Preset", "info": "Edit presets in theme settings", "options": [ { "value": "custom", "label": "Custom" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" } ], "default": "custom" },
    { "type": "select", "id": "font", "label": "Font", "options": [ { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-accent--family)", "label": "Accent" } ], "default": "var(--font-heading--family)", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "font_size", "label": "Size", "options": [ { "value": "", "label": "Default" }, { "value": "0.625rem", "label": "10px" }, { "value": "0.75rem", "label": "12px" }, { "value": "0.875rem", "label": "14px" }, { "value": "1rem", "label": "16px" }, { "value": "1.125rem", "label": "18px" }, { "value": "1.25rem", "label": "20px" }, { "value": "1.5rem", "label": "24px" }, { "value": "2rem", "label": "32px" }, { "value": "2.5rem", "label": "40px" }, { "value": "3rem", "label": "48px" }, { "value": "3.5rem", "label": "56px" }, { "value": "4.5rem", "label": "72px" } ], "default": "", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "line_height", "label": "Line height", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "letter_spacing", "label": "Letter spacing", "options": [ { "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "loose", "label": "Loose" } ], "default": "normal", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "case", "label": "Case", "options": [ { "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" } ], "default": "none", "visible_if": "{{ section.settings.type_preset == 'custom' }}" },
    { "type": "select", "id": "color", "label": "Color", "options": [ { "value": "", "label": "Default" }, { "value": "var(--color-foreground)", "label": "Text" }, { "value": "var(--color-foreground-heading)", "label": "Heading" }, { "value": "var(--color-primary)", "label": "Link" } ], "default": "" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Behind the Design" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Explore lighting inspiration, styling ideas, and thoughtful design stories made to help you create a more beautiful home." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Collections" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image_1", "label": "Front image (small, portrait)" },
    { "type": "image_picker", "id": "image_2", "label": "Back image (large, portrait)" }
  ],
  "presets": [{ "name": "Heitz TF Editorial" }]
}
{% endschema %}
