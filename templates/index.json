        "padding_bottom": 80,
        "eyebrow": "Lighting Help",
        "title": "Frequently Asked Questions",
        "intro": "<p>Quick answers about ordering from Heitz — shipping, returns, warranty and what makes our lighting different.</p>",
        "link": "/pages/frequently-asked-questions",
        "link_label": "View all",
        "button_style": "secondary",
        "question_size": 16,
        "text_size": 15
      }
    },
