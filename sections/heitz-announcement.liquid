{%- comment -%}
  Heitz TF announcement bar — dark rotating message bar, sticky with the header.
{%- endcomment -%}
<style>
  .htf-announcement {
    background-color: var(--color-background, #2a3743);
    color: var(--color-foreground, #ffffff);
    font-size: 12.75px;
    padding: 10px 0;
    position: relative;
    text-align: center;
    z-index: 30;
  }
  .htf-announcement__slider {
    position: relative;
    min-height: 1.4em;
  }
  .htf-announcement__slide {
    display: block;
    font-family: var(--htf-font-body, sans-serif);
    font-size: .9em;
    font-weight: 700;
    letter-spacing: var(--htf-uppercase-spacing, 0.2em);
    text-transform: uppercase;
    opacity: 0;
    position: absolute;
    inset: 0;
    transition: opacity .5s ease;
    pointer-events: none;
  }
  .htf-announcement__slide.is-active {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }
  .htf-announcement__slide a { color: inherit; text-decoration: none; }
</style>

<div class="htf-announcement color-{{ section.settings.color_scheme }}">
  <div class="htf-page-width">
    <div class="htf-announcement__slider" data-htf-announcement data-speed="{{ section.settings.speed | default: 5 }}">
      {%- for block in section.blocks -%}
        <span class="htf-announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var slider = document.currentScript.previousElementSibling.querySelector('[data-htf-announcement]');
    if (!slider) return;
    var slides = slider.querySelectorAll('.htf-announcement__slide');
    if (slides.length < 2) return;
    var i = 0;
    setInterval(function () {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, (parseInt(slider.dataset.speed, 10) || 5) * 1000);
  })();
</script>

{% schema %}
{
  "name": "Heitz TF Announcement",
  "class": "htf-section-announcement",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Heitz TF Announcement",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on all orders" } },
        { "type": "message", "settings": { "text": "Hassle-free 30-day return window" } }
      ]
    }
  ]
}
{% endschema %}
