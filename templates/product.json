              },
              "block_order": [
                "text_igVQeU"
              ]
            },
            "accordion_row_MmnxTN": {
              "type": "_accordion-row",
              "name": "t:names.accordion_dash_row",
              "settings": {
                "heading": "3. Where do you ship from?",
                "behavior": "drawer",
                "open_by_default": false,
                "drawer_background_color": "#ffffff",
                "icon": "none",
                "svg_code": "",
                "width": 20
              },
              "blocks": {
                "text_iUzKaB": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Your order ships directly from our makers and fulfilment partners overseas, sent straight to your door. Shipping from the source lets us keep both our quality and our prices honest, without unnecessary middle steps. Every order is fully tracked, so you can follow your piece the whole way.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
