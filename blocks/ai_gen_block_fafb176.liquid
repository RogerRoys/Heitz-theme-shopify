<script>
  (function() {
    class IconTextSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.icon-text-mobile-track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.icon-text-dot-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.icon-text-mobile-track-{{ ai_gen_id }} .icon-text-item-{{ ai_gen_id }}');
        this.currentIndex = 0;
        this.touchStartX = 0;
        this.touchEndX = 0;
        this.autoplayInterval = null;
        this.autoplayEnabled = {{ block.settings.enable_autoplay | json }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }};
      }

      connectedCallback() {
        if (this.items.length <= 1) return;
        
        this.setupDotNavigation();
        this.setupTouchEvents();
        
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }
      
      setupDotNavigation() {
        this.dots.forEach(dot => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.dataset.index);
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });
      }
      
      setupTouchEvents() {
        this.track.addEventListener('touchstart', (e) => {
          this.touchStartX = e.touches[0].clientX;
          if (this.autoplayEnabled) {
            clearInterval(this.autoplayInterval);
          }
        }, { passive: true });
        
        this.track.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].clientX;
          this.handleSwipe();
          this.resetAutoplay();
        }, { passive: true });
      }
      
      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          let nextIndex = this.currentIndex + 1;
          if ({{ block.settings.enable_loop | json }} && nextIndex >= this.items.length) {
            nextIndex = 0;
          } else if (!{{ block.settings.enable_loop | json }} && nextIndex >= this.items.length) {
            nextIndex = this.items.length - 1;
          }
          this.goToSlide(nextIndex);
        }, this.autoplaySpeed);
      }
      
      resetAutoplay() {
        if (this.autoplayEnabled) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }
      
      handleSwipe() {
        const diff = this.touchStartX - this.touchEndX;
        const threshold = {{ block.settings.swipe_threshold }};
        
        if (Math.abs(diff) > threshold) {
          if (diff > 0) {
            let nextIndex = this.currentIndex + 1;
            if ({{ block.settings.enable_loop | json }} && nextIndex >= this.items.length) {
              nextIndex = 0;
            } else if (!{{ block.settings.enable_loop | json }} && nextIndex >= this.items.length) {
              return;
            }
            this.goToSlide(nextIndex);
          } else {
            let prevIndex = this.currentIndex - 1;
            if ({{ block.settings.enable_loop | json }} && prevIndex < 0) {
              prevIndex = this.items.length - 1;
            } else if (!{{ block.settings.enable_loop | json }} && prevIndex < 0) {
              return;
            }
            this.goToSlide(prevIndex);
          }
        }
      }
      
      goToSlide(index) {
        if (index < 0 || index >= this.items.length) return;
        
        this.currentIndex = index;
        const translateX = -index * 100;
        this.track.style.transform = `translateX(${translateX}%)`;
        
        this.dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      }
    }
    
    customElements.define('icon-text-slider-{{ ai_gen_id }}', IconTextSlider{{ ai_gen_id }});
  })();
</script>

