              ]
            },
            "accordion_row_MfrEmB": {
              "type": "_accordion-row",
              "name": "t:names.accordion_dash_row",
              "settings": {
                "heading": "7. Do your products include a warranty?",
                "behavior": "drawer",
                "open_by_default": false,
                "drawer_background_color": "#ffffff",
                "icon": "none",
                "svg_code": "",
                "width": 20
              },
              "blocks": {
                "text_bGn7X7": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Yes. Every product includes a <strong>1-year warranty</strong> covering manufacturing defects. If your item has a fault caused by the manufacturing process, please contact us with your order details and photos of the issue, and we’ll help with a suitable solution.</p><p>The warranty does not cover damage caused by incorrect installation, misuse, accidental damage, normal wear and tear, or changes made to the product after purchase. For full details, see our <a href=\"https://heitz.shop/pages/warranty\" target=\"_blank\" title=\"https://heitz.shop/pages/warranty\"><strong>1-Year Warranty page.</strong></a></p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
